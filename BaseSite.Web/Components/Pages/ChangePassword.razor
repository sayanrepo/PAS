@page "/account/change-password"
@inject ApiSession Session
@inject BaseSiteApiClient Api
@inject NavigationManager Navigation

<PageTitle>تغییر نام کاربری و رمز عبور | پانتا</PageTitle>
<MudText Typo="Typo.h5" Class="mb-5">تغییر نام کاربری و رمز عبور</MudText>

@if (ready)
{
    <MudRTLProvider RightToLeft="true">
    <MudPaper Class="account-panel" Elevation="0">
        @if (!string.IsNullOrEmpty(error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
        }
        @if (saved)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">نام کاربری و رمز عبور با موفقیت تغییر کرد.</MudAlert>
        }
        <EditForm Model="request" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="request.UserName" For="@(() => request.UserName)" Label="نام کاربری" Variant="Variant.Outlined" Disabled="busy" Class="mb-4" autocomplete="username" />
            <MudTextField @bind-Value="request.CurrentPassword" For="@(() => request.CurrentPassword)" Label="رمز عبور فعلی" InputType="InputType.Password" Variant="Variant.Outlined" Disabled="busy" Class="mb-4" autocomplete="current-password" />
            <MudTextField @bind-Value="request.NewPassword" For="@(() => request.NewPassword)" Label="رمز عبور جدید" InputType="InputType.Password" Variant="Variant.Outlined" Disabled="busy" Class="mb-4" autocomplete="new-password" HelperText="حداقل چهار کاراکتر" />
            <MudTextField @bind-Value="request.ConfirmPassword" For="@(() => request.ConfirmPassword)" Label="تکرار رمز عبور جدید" InputType="InputType.Password" Variant="Variant.Outlined" Disabled="busy" Class="mb-4" autocomplete="new-password" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy">@(busy ? "در حال ذخیره…" : "ذخیره تغییرات")</MudButton>
        </EditForm>
    </MudPaper>
    </MudRTLProvider>
}

@code {
    private ChangePasswordRequest request = new();
    private bool ready, busy, saved;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Session.InitializeAsync();
        if (!Session.IsAuthenticated) { Navigation.NavigateTo("/login"); return; }
        request.UserName = Session.User!.UserName;
        ready = true;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (busy) return;
        if (!Session.IsAuthenticated) { Navigation.NavigateTo("/login"); return; }
        busy = true;
        saved = false;
        error = null;
        try
        {
            var login = await Api.ChangePasswordAsync(request);
            await Session.SignInAsync(login);
            request = new() { UserName = login.User.UserName };
            saved = true;
        }
        catch (Exception ex)
        {
            error = ex is HttpRequestException ? "ارتباط با سرور برقرار نشد. دوباره تلاش کنید." : ex.Message;
            if (!Session.IsAuthenticated) Navigation.NavigateTo("/login");
        }
        finally { busy = false; }
    }
}
