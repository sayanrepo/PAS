@page "/customers/new"
@page "/customers/{Id:int}"
@inject ApiSession Session
@inject BaseSiteApiClient Api
@inject NavigationManager Navigation

<PageTitle>@(Id == 0 ? "افزودن شخص جدید" : "ویرایش اطلاعات شخص") | پنتا</PageTitle>
<MudRTLProvider RightToLeft="true">
<div class="app-form person-detail">
    <div class="page-heading">
        <MudText Typo="Typo.h5">@(Id == 0 ? "افزودن شخص جدید" : "ویرایش اطلاعات شخص")</MudText>
        <MudButton Href="/customers" StartIcon="@Icons.Material.Filled.ArrowForward">بازگشت به اشخاص و سازمان‌ها</MudButton>
    </div>

    @if (loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (!string.IsNullOrWhiteSpace(error) && person is null)
    {
        <MudAlert Severity="Severity.Error">@error</MudAlert>
    }
    else if (person is not null && lookups is not null)
    {
        @if (!string.IsNullOrWhiteSpace(error)) { <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert> }
        @if (!string.IsNullOrWhiteSpace(success)) { <MudAlert Severity="Severity.Success" Class="mb-4">@success</MudAlert> }
        @if (!CanSave) { <MudAlert Severity="Severity.Info" Class="mb-4">این پرونده فقط قابل مشاهده است.</MudAlert> }

        <EditForm Model="person" OnSubmit="SaveAsync" FormName="person-organization">
            <fieldset disabled="@(!CanSave || saving)" class="legacy-person-form">
                <section class="legacy-panel legacy-panel-main">
                    <h2>فرم اطلاعات شخص</h2>
                    <div class="legacy-panel-body">
                        <div class="legacy-main-columns">
                            <div class="legacy-column">
                                <MudSelect T="byte" @bind-Value="person.PersonTypeId" Label="نوع شخص" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field" Disabled="@(!CanSave || saving)">@foreach (var item in lookups.PersonTypes) { <MudSelectItem T="byte" Value='@((byte)item.Id)'>@item.Name</MudSelectItem> }</MudSelect>
                                <MudTextField T="string" @bind-Value="person.Name" Immediate="true" Label="نام" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field" Disabled="@(!CanSave || saving)" MaxLength="255" Required="true" />
                                <MudTextField T="string" @bind-Value="person.LastName" Immediate="true" Label="نام خانوادگی" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field" Disabled="@(!CanSave || saving)" MaxLength="255" />
                                <MudTextField T="string" @bind-Value="person.NationalNumber" Immediate="true" Label="شماره ملی/ثبت" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field ltr-input" Disabled="@(!CanSave || saving)" MaxLength="15" />
                                <MudTextField T="string" @bind-Value="person.EconomicalNumber" Immediate="true" Label="شماره شناسنامه/اقتصادی" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field ltr-input" Disabled="@(!CanSave || saving)" MaxLength="15" />
                                <MudTextField T="string" @bind-Value="person.Comment" Immediate="true" Label="توضیحات" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field app-field-textarea" Disabled="@(!CanSave || saving)" Lines="4" />
                            </div>

                            <div class="legacy-column">
                                <MudTextField T="string" @bind-Value="person.Phone1" Immediate="true" Label="تلفن ۱" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field ltr-input" Disabled="@(!CanSave || saving)" MaxLength="50" Placeholder="با کد و بدون خط تیره و فاصله" />
                                <MudTextField T="string" @bind-Value="person.Phone2" Immediate="true" Label="تلفن ۲" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field ltr-input" Disabled="@(!CanSave || saving)" MaxLength="50" Placeholder="با کد و بدون خط تیره و فاصله" />
                                <MudTextField T="string" @bind-Value="person.Mobile1" Immediate="true" Label="موبایل ۱" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field ltr-input" Disabled="@(!CanSave || saving)" MaxLength="50" Placeholder="با کد و بدون خط تیره و فاصله" />
                                <MudTextField T="string" @bind-Value="person.Mobile2" Immediate="true" Label="موبایل ۲" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field ltr-input" Disabled="@(!CanSave || saving)" MaxLength="50" Placeholder="با کد و بدون خط تیره و فاصله" />
                                <MudTextField T="string" @bind-Value="person.Fax" Immediate="true" Label="فکس" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field ltr-input" Disabled="@(!CanSave || saving)" MaxLength="50" Placeholder="با کد و بدون خط تیره و فاصله" />
                                <MudAutocomplete T="string" @bind-Value="person.FindoutWay" SearchFunc="FindFindoutWays" CoerceValue="true" CoerceText="false" Strict="false" Label="نحوه آشنایی" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field" Disabled="@(!CanSave || saving)" Placeholder="انتخاب کن یا بنویس" Required="true" />
                            </div>

                            <div class="legacy-column legacy-account-free-column">
                                <MudSelect T="byte" @bind-Value="person.PartnerTypeId" Label="نوع همکاری" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field" Disabled="@(!CanSave || saving)">@foreach (var item in lookups.PartnerTypes) { <MudSelectItem T="byte" Value='@((byte)item.Id)'>@item.Name</MudSelectItem> }</MudSelect>
                                <MudSelect T="byte?" @bind-Value="person.DepartmentId" Label="بخش" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field" Disabled="@(!CanSave || saving)">@foreach (var item in DepartmentOptions) { <MudSelectItem T="byte?" Value='@((byte?)item.Id)'>@item.Name</MudSelectItem> }</MudSelect>
                                <MudTextField T="string" @bind-Value="person.Email" Immediate="true" Label="ایمیل" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field ltr-input" Disabled="@(!CanSave || saving)" MaxLength="255" Placeholder="لطفا ایمیل را وارد فرمائید" InputType="InputType.Email" />
                                <MudTextField T="string" @bind-Value="person.Website" Immediate="true" Label="سایت" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field ltr-input" Disabled="@(!CanSave || saving)" MaxLength="255" Placeholder="لطفا آدرس سایت را وارد فرمائید" />
                            </div>
                        </div>

                        <section class="legacy-panel legacy-subpanel">
                            <h3>افراد مرتبط</h3>
                            <div class="legacy-panel-body legacy-related-grid">
                                <div class="legacy-column">
                                    <MudTextField T="string" @bind-Value="person.Responsible1" Immediate="true" Label="نام مدیر عامل" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field" Disabled="@(!CanSave || saving)" MaxLength="50" />
                                    <MudTextField T="string" @bind-Value="person.ResponsiblePhone1" Immediate="true" Label="شماره تماس مدیرعامل" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field ltr-input" Disabled="@(!CanSave || saving)" MaxLength="50" Placeholder="با کد و بدون خط تیره و فاصله" />
                                </div>
                                <div class="legacy-column">
                                    <MudTextField T="string" @bind-Value="person.Responsible2" Immediate="true" Label="نام مسئول سفارشات" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field" Disabled="@(!CanSave || saving)" MaxLength="50" />
                                    <MudTextField T="string" @bind-Value="person.ResponsiblePhone2" Immediate="true" Label="شماره تماس سفارشات" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field ltr-input" Disabled="@(!CanSave || saving)" MaxLength="50" Placeholder="با کد و بدون خط تیره و فاصله" />
                                </div>
                                <div class="legacy-column">
                                    <MudTextField T="string" @bind-Value="person.Responsible3" Immediate="true" Label="نام مسئول فنی" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field" Disabled="@(!CanSave || saving)" MaxLength="50" />
                                    <MudTextField T="string" @bind-Value="person.ResponsiblePhone3" Immediate="true" Label="شماره تماس مسئول فنی" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field ltr-input" Disabled="@(!CanSave || saving)" MaxLength="50" Placeholder="با کد و بدون خط تیره و فاصله" />
                                </div>
                            </div>
                        </section>

                        <div class="legacy-address-grid">
                            <section class="legacy-panel legacy-subpanel">
                                <h3>آدرس منزل / دفتر مرکزی</h3>
                                <div class="legacy-panel-body">
                                    <div class="legacy-location-grid">
                                        <MudSelect T="int?" Value="homeCountryId" ValueChanged="@(v => HomeCountryChanged(new ChangeEventArgs { Value = v }))" Label="کشور" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field" Disabled="@(!CanSave || saving)"><MudSelectItem T="int?" Value='@((int?)null)'>-انتخاب کشور-</MudSelectItem>@foreach (var item in lookups.Countries) { <MudSelectItem T="int?" Value='@((int?)item.Id)'>@item.Name</MudSelectItem> }</MudSelect>
                                        <MudSelect T="int?" Value="homeProvinceId" ValueChanged="@(v => HomeProvinceChanged(new ChangeEventArgs { Value = v }))" Label="استان" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field" Disabled="@((!CanSave || saving) || (!homeCountryId.HasValue))"><MudSelectItem T="int?" Value='@((int?)null)'>-انتخاب استان-</MudSelectItem>@foreach (var item in HomeProvinces) { <MudSelectItem T="int?" Value='@((int?)item.Id)'>@item.Name</MudSelectItem> }</MudSelect>
                                        <MudSelect T="int?" @bind-Value="person.CityId1" Label="شهر" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field" Disabled="@((!CanSave || saving) || (!homeProvinceId.HasValue))"><MudSelectItem T="int?" Value='@((int?)null)'>-انتخاب شهر-</MudSelectItem>@foreach (var item in HomeCities) { <MudSelectItem T="int?" Value='@((int?)item.Id)'>@item.Name</MudSelectItem> }</MudSelect>
                                    </div>
                                    <MudTextField T="string" @bind-Value="person.Address1" Immediate="true" Label="آدرس" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field app-field-textarea" Disabled="@(!CanSave || saving)" Lines="5" />
                                    <MudTextField T="string" @bind-Value="person.PostalCode1" Immediate="true" Label="کدپستی" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field ltr-input" Disabled="@(!CanSave || saving)" MaxLength="15" />
                                </div>
                            </section>

                            <section class="legacy-panel legacy-subpanel">
                                <h3>آدرس محل کار / کارخانه</h3>
                                <div class="legacy-panel-body">
                                    <div class="legacy-location-grid">
                                        <MudSelect T="int?" Value="workCountryId" ValueChanged="@(v => WorkCountryChanged(new ChangeEventArgs { Value = v }))" Label="کشور" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field" Disabled="@(!CanSave || saving)"><MudSelectItem T="int?" Value='@((int?)null)'>-انتخاب کشور-</MudSelectItem>@foreach (var item in lookups.Countries) { <MudSelectItem T="int?" Value='@((int?)item.Id)'>@item.Name</MudSelectItem> }</MudSelect>
                                        <MudSelect T="int?" Value="workProvinceId" ValueChanged="@(v => WorkProvinceChanged(new ChangeEventArgs { Value = v }))" Label="استان" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field" Disabled="@((!CanSave || saving) || (!workCountryId.HasValue))"><MudSelectItem T="int?" Value='@((int?)null)'>-انتخاب استان-</MudSelectItem>@foreach (var item in WorkProvinces) { <MudSelectItem T="int?" Value='@((int?)item.Id)'>@item.Name</MudSelectItem> }</MudSelect>
                                        <MudSelect T="int?" @bind-Value="person.CityId2" Label="شهر" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field" Disabled="@((!CanSave || saving) || (!workProvinceId.HasValue))"><MudSelectItem T="int?" Value='@((int?)null)'>-انتخاب شهر-</MudSelectItem>@foreach (var item in WorkCities) { <MudSelectItem T="int?" Value='@((int?)item.Id)'>@item.Name</MudSelectItem> }</MudSelect>
                                    </div>
                                    <MudTextField T="string" @bind-Value="person.Address2" Immediate="true" Label="آدرس" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field app-field-textarea" Disabled="@(!CanSave || saving)" Lines="5" />
                                    <MudTextField T="string" @bind-Value="person.PostalCode2" Immediate="true" Label="کدپستی" Variant="Variant.Outlined" Margin="Margin.Normal" Class="app-field ltr-input" Disabled="@(!CanSave || saving)" MaxLength="15" />
                                </div>
                            </section>
                        </div>
                    </div>
                </section>
            </fieldset>

            @if (CanSave)
            {
                <div class="legacy-person-actions">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Success" Disabled="saving">@(saving ? "در حال ثبت…" : "ثبت اطلاعات")</MudButton>
                </div>
            }
        </EditForm>
    }
</div>
</MudRTLProvider>

@code {
    [Parameter] public int Id { get; set; }
    private PersonOrganizationDetails? person;
    private PersonOrganizationLookups? lookups;
    private bool loading = true, saving;
    private string? error, success;
    private int? loadedId, homeCountryId, homeProvinceId, workCountryId, workProvinceId;

    private bool CanSave => Id == 0
        ? Session.User?.Roles.Contains("Setting_Persons_Add") == true
        : Session.User?.Roles.Contains("Setting_Persons_Edit") == true;
    private IEnumerable<NamedLookup> HomeProvinces => homeCountryId.HasValue ? lookups!.Provinces.Where(x => x.ParentId == homeCountryId) : [];
    private IEnumerable<NamedLookup> HomeCities => homeProvinceId.HasValue ? lookups!.Cities.Where(x => x.ParentId == homeProvinceId) : [];
    private IEnumerable<NamedLookup> WorkProvinces => workCountryId.HasValue ? lookups!.Provinces.Where(x => x.ParentId == workCountryId) : [];
    private IEnumerable<NamedLookup> WorkCities => workProvinceId.HasValue ? lookups!.Cities.Where(x => x.ParentId == workProvinceId) : [];
    private IEnumerable<NamedLookup> DepartmentOptions
    {
        get
        {
            var result = new List<NamedLookup>();
            if (Session.User?.Roles.Contains("Setting_Persons_Customer") == true) result.Add(new() { Id = 0, Name = "نامعلوم" });
            if (Session.User?.Roles.Contains("Setting_Persons_Foroosh") == true) result.Add(new() { Id = 1, Name = "فروش" });
            if (Session.User?.Roles.Contains("Setting_Persons_Tolid") == true) result.Add(new() { Id = 2, Name = "تولید" });
            var current = person?.DepartmentId;
            if (current.HasValue && result.All(x => x.Id != current.Value))
                result.Add(new() { Id = current.Value, Name = DepartmentName(current.Value) });
            if (result.Count == 0) result.Add(new() { Id = current ?? 0, Name = DepartmentName(current ?? 0) });
            return result;
        }
    }

    protected override async Task OnParametersSetAsync() { if (Session.IsInitialized && loadedId != Id) await LoadAsync(); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Session.InitializeAsync();
        if (loadedId != Id) await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        if (!Session.IsAuthenticated) { Navigation.NavigateTo("/login"); return; }
        loading = true; error = success = null; loadedId = Id;
        try
        {
            lookups = await Api.GetPersonOrganizationLookupsAsync() ?? throw new InvalidOperationException("اطلاعات پایه دریافت نشد.");
            person = Id == 0 ? new PersonOrganizationDetails
            {
                PersonTypeId = (byte)(lookups.PersonTypes.FirstOrDefault()?.Id ?? 1),
                PartnerTypeId = (byte)(lookups.PartnerTypes.FirstOrDefault()?.Id ?? 2),
                DepartmentId = 0
            } : await Api.GetPersonOrganizationAsync(Id) ?? throw new InvalidOperationException("شخص یا سازمان یافت نشد.");
            InitializeAddressSelections();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private void InitializeAddressSelections()
    {
        (homeCountryId, homeProvinceId) = ResolveLocation(person?.CityId1);
        (workCountryId, workProvinceId) = ResolveLocation(person?.CityId2);
    }

    private (int? CountryId, int? ProvinceId) ResolveLocation(int? cityId)
    {
        if (!cityId.HasValue || lookups is null) return (null, null);
        var provinceId = lookups.Cities.FirstOrDefault(x => x.Id == cityId.Value)?.ParentId;
        var countryId = provinceId.HasValue ? lookups.Provinces.FirstOrDefault(x => x.Id == provinceId.Value)?.ParentId : null;
        return (countryId, provinceId);
    }

    private void HomeCountryChanged(ChangeEventArgs args)
    {
        homeCountryId = ParseNullableInt(args.Value);
        homeProvinceId = null;
        if (person is not null) person.CityId1 = null;
    }
    private void HomeProvinceChanged(ChangeEventArgs args) { homeProvinceId = ParseNullableInt(args.Value); if (person is not null) person.CityId1 = null; }
    private void WorkCountryChanged(ChangeEventArgs args)
    {
        workCountryId = ParseNullableInt(args.Value);
        workProvinceId = null;
        if (person is not null) person.CityId2 = null;
    }
    private void WorkProvinceChanged(ChangeEventArgs args) { workProvinceId = ParseNullableInt(args.Value); if (person is not null) person.CityId2 = null; }
    private static int? ParseNullableInt(object? value) => int.TryParse(value?.ToString(), out var parsed) ? parsed : null;
    private static string DepartmentName(int id) => id switch { 1 => "فروش", 2 => "تولید", _ => "نامعلوم" };

    private Task<IEnumerable<string>> FindFindoutWays(string text, CancellationToken token) =>
        Task.FromResult((lookups?.FindoutWays.Select(x => x.Name) ?? []).Where(x => string.IsNullOrWhiteSpace(text) || x.Contains(text, StringComparison.OrdinalIgnoreCase)));

    private async Task SaveAsync()
    {
        if (person is null || saving || !CanSave) return;
        error = success = null;
        if (string.IsNullOrWhiteSpace(person.Name)) { error = "نام را وارد کنید."; return; }
        if (string.IsNullOrWhiteSpace(person.FindoutWay)) { error = "نحوه آشنایی را وارد کنید."; return; }
        try
        {
            saving = true;
            var saved = await Api.SavePersonOrganizationAsync(Id, person.ToSaveRequest());
            if (Id == 0) { Navigation.NavigateTo($"/customers/{saved.Id}"); return; }
            person = saved; InitializeAddressSelections(); success = "اطلاعات ثبت شد.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }
}
