@page "/documents/orders/new"
@page "/documents/orders/{Id:int}"
@page "/documents/orders/{Id:int}/edit"
@inject ApiSession Session
@inject BaseSiteApiClient Api
@inject NavigationManager Navigation
<PageTitle>سفارش | پنتا</PageTitle>
<MudRTLProvider RightToLeft="true">
<div class="order-detail">
    <div class="page-heading">
        <MudText Typo="Typo.h5">@(Id == 0 ? "ایجاد سفارش" : $"سفارش {editor?.Detail.Summary.DocumentNumber}")</MudText>
        <MudButton Href="/documents/orders" StartIcon="@Icons.Material.Filled.ArrowForward">بازگشت به سفارش‌ها</MudButton>
    </div>
    @if (loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
    @if (error is not null) { <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert> }
    @if (success is not null) { <MudAlert Severity="Severity.Success" Class="mb-4">@success</MudAlert> }
    @if (!loading && editor is not null)
    {
        @if (Id > 0)
        {
            <div class="order-toolbar">
                <nav class="order-tabs" aria-label="بخش‌های سفارش">
                    <button type="button" class="@(activeTab == 0 ? "active" : null)" aria-current="@(activeTab == 0 ? "page" : null)" @onclick="() => SelectTab(0)">سفارش</button>
                    <button type="button" class="@(activeTab == 1 ? "active" : null)" aria-current="@(activeTab == 1 ? "page" : null)" @onclick="() => SelectTab(1)">
                        یادداشت ها
                        @if (activity?.Comments.Count > 0) { <span class="order-tab-count">@activity.Comments.Count</span> }
                    </button>
                    <button type="button" class="@(activeTab == 2 ? "active" : null)" aria-current="@(activeTab == 2 ? "page" : null)" @onclick="() => SelectTab(2)">تاریخچه فعالیتها</button>
                </nav>
                <div class="order-print-actions" aria-label="چاپ سفارش">
                    @if (CanPrintSpecification)
                    {
                        <MudTooltip Text="چاپ کارت مشخصات سفارش"><MudIconButton Icon="@Icons.Material.Filled.Print" Color="Color.Primary" title="چاپ کارت مشخصات سفارش" aria-label="چاپ کارت مشخصات سفارش" Href="@($"/print/orders/{Id}/specification")" Target="_blank" rel="noopener" /></MudTooltip>
                    }
                    @if (CanPrintOrder)
                    {
                        <MudTooltip Text="چاپ صورتحساب فروش"><MudIconButton Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Primary" title="چاپ صورتحساب فروش" aria-label="چاپ صورتحساب فروش" Href="@($"/print/orders/{Id}/bill")" Target="_blank" rel="noopener" /></MudTooltip>
                        <MudTooltip Text="چاپ فاکتور"><MudIconButton Icon="@Icons.Material.Filled.RequestQuote" Color="Color.Primary" title="چاپ فاکتور" aria-label="چاپ فاکتور" Href="@($"/print/orders/{Id}/invoice")" Target="_blank" rel="noopener" /></MudTooltip>
                    }
                </div>
            </div>
        }
        <div class="@(activeTab == 0 ? null : "order-tab-hidden")">
            @if (ReadOnly) { <MudAlert Severity="Severity.Info" Class="mb-4">این سفارش فقط قابل مشاهده است.</MudAlert> }
            <EditForm Model="editor.Form" OnSubmit="SaveAsync" FormName="order">
            <fieldset disabled="@(ReadOnly || saving)" class="order-form" aria-label="فرم سفارش">
                <section class="order-section order-main" aria-label="مشخصات سفارش">
                    <h2 class="order-section-title">سفارش</h2>
                    <div class="order-section-body">
                        <div class="order-fields order-top-fields">
                            <MudTextField T="string" Value="@(Id == 0 ? "پس از ثبت" : editor.Detail.Summary.DocumentNumber.ToString())" Label="شماره سند" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field order-readonly" />
                            @if (CanAdvanceStatus)
                            {
                                <MudSelect T="byte" @bind-Value="form.StatusId" Label="وضعیت" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field">
                                    @foreach (var option in StatusOptions) { <MudSelectItem T="byte" Value="@((byte)option.Id)">@option.Name</MudSelectItem> }
                                </MudSelect>
                            }
                            else
                            {
                                <MudTextField T="string" Value="@editor.Detail.Summary.Status" Label="وضعیت" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field order-readonly" />
                            }
                            <MudSelect T="byte" @bind-Value="form.TradeTypeId" @bind-Value:after="Recalculate" Label="نوع معامله" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field">
                                @foreach (var option in Options("TradeTypes")) { <MudSelectItem T="byte" Value="@((byte)option.Id)">@option.Name</MudSelectItem> }
                            </MudSelect>
                            <MudTextField T="string" Value="@PersianDates.Format(editor.Detail.Summary.OrderDate)" Label="تاریخ سفارش" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field order-readonly ltr-input" />
                            <PersianDatePicker @bind-Date="form.FactorDate" Label="تاریخ تحویل" Disabled="@(ReadOnly || saving)" Margin="Margin.Normal" Class="order-field ltr-input" />
                        </div>
                        <div class="order-fields order-customer-fields">
                            <MudAutocomplete T="OrderLookup" Value="customer" ValueChanged="CustomerChanged" SearchFunc="FindCustomers" @bind-Text="customerText"
                                ToStringFunc="@(x => x?.Name ?? string.Empty)" Disabled="@(ReadOnly || saving)" Label="مشتری"
                                Clearable="true" ResetValueOnEmptyText="true" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field order-customer" />
                            <MudTextField T="string" @bind-Value="form.ProjectName" Label="نام پروژه" Immediate="true" MaxLength="50" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                            <MudTextField T="string" @bind-Value="form.ClienteleName" Label="سفارش دهنده" Immediate="true" MaxLength="50" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                            <MudSelect T="int" @bind-Value="form.ElevatorBoardId" @bind-Value:after="Recalculate" Label="نوع تابلو" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field">
                                @foreach (var option in Options("ElevatorBoards")) { <MudSelectItem T="int" Value="@option.Id">@option.Name</MudSelectItem> }
                            </MudSelect>
                            <MudTextField T="string" @bind-Value="form.DeliveryAddress" Label="محل ارسال" Immediate="true" MaxLength="255" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field order-wide" />
                            <MudSelect T="short" @bind-Value="form.PackTypeId" @bind-Value:after="Recalculate" Label="نوع بسته بندی" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field">
                                @foreach (var option in Options("PackTypes")) { <MudSelectItem T="short" Value="@((short)option.Id)">@option.Name</MudSelectItem> }
                            </MudSelect>
                        </div>
                        <div class="order-fields order-totals">
                            <OrderValue Label="پنل کابین" Value='@PanelTotal("Cabin")' />
                            <OrderValue Label="پنل طبقات" Value='@PanelTotal("Hall")' />
                            <OrderValue Label="پنل سردرب" Value='@PanelTotal("DoorTop")' />
                            <MudNumericField T="double" @bind-Value="form.DeliveryCost" @bind-Value:after="Recalculate" Label="کرایه حمل" Min="0" Immediate="true" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                            <MudNumericField T="double" @bind-Value="form.Tax" @bind-Value:after="Recalculate" Label="عوارض (درصد)" Min="0" Max="100" Immediate="true" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                            <OrderValue Label="ملحقات" Value='@form.Panels.Where(x => x.ModelId > 0).Sum(x => x.Attachments.Sum(a => a.Cost)).ToString("N0")' />
                            <OrderValue Label="اضافات" Value='@form.Panels.Where(x => x.ModelId > 0).Sum(x => x.Additions.Sum(a => a.Cost)).ToString("N0")' />
                            <OrderValue Label="کسورات" Value='@form.Deductions.Sum(x => x.Cost).ToString("N0")' />
                            <MudNumericField T="double" @bind-Value="form.DiscountRate" @bind-Value:after="Recalculate" Label="تخفیف (درصد)" Min="0" Max="100" Immediate="true" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                            <OrderValue Label="جمع کل (ریال)" Value='@form.Total.ToString("N0")' Class="order-grand-total" />
                        </div>
                        <div class="order-calculation">مبلغ عوارض: @form.TaxTotal.ToString("N0") ریال · مبلغ تخفیف: @form.DiscountTotal.ToString("N0") ریال</div>
                    </div>
                </section>
                @foreach (var panel in form.Panels)
                {
                    <section @key="panel" class="order-section" aria-label="@PanelTitle(panel.Kind)">
                        <header class="order-section-title order-panel-title">
                            <span>مرحله تولید: @panel.ProductionStatus</span>
                            <h2>@PanelTitle(panel.Kind)</h2>
                            <span>@((panel.Count > 0 ? panel.Amount / panel.Count : 0).ToString("N0")) ریال / واحد</span>
                        </header>
                        <div class="order-section-body">
                            <div class="order-fields order-panel-fields">
                                @if (panel.Kind == "Cabin")
                                {
                                    <OrderChoiceAutocomplete @bind-Value="panel.ModelId" @bind-Value:after="Recalculate" Label="مدل پنل" Options='@Options("CabinPanels")' />
                                    <OrderChoiceAutocomplete @bind-Value="panel.PushButtonId" @bind-Value:after="Recalculate" Label="پوش باتون" Options='@Options("PushButtons")' />
                                    <OrderChoiceAutocomplete @bind-Value="panel.MonitorId" @bind-Value:after="Recalculate" Label="نمایشگر" Options='@Options("Monitors")' />
                                    <MudNumericField T="int" @bind-Value="panel.Count" @bind-Value:after="Recalculate" Label="تعداد" Min="1" Max="10000" Immediate="true" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                                    <OrderChoiceAutocomplete @bind-Value="panel.SurfaceMetalId" @bind-Value:after="Recalculate" Label="فلز رویه" Options='@Options("CabinSurfaceMetals")' />
                                    <MudNumericField T="int" @bind-Value="panel.FloorCount" @bind-Value:after="Recalculate" Label="تعداد طبقات" Min="0" Max="200" Immediate="true" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                                    <MudNumericField T="int" @bind-Value="panel.UGFloorCount" @bind-Value:after="Recalculate" Label="تعداد طبقات زیرین" Min="0" Max="200" Immediate="true" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                                    <MudTextField T="string" @bind-Value="panel.FloorNames" Label="نام‌گذاری و ترتیب طبقات" Immediate="true" MaxLength="50" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                                    <MudTextField T="string" @bind-Value="panel.UGFloorNames" Label="نام‌گذاری و ترتیب طبقات زیرین" Immediate="true" MaxLength="50" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                                    <MudCheckBox T="bool" @bind-Value="panel.PhoneCallButton" @bind-Value:after="Recalculate" Label="کلید آیفون" Color="Color.Success" Class="order-field order-checkbox" />
                                    <MudCheckBox T="bool" @bind-Value="panel.DO" @bind-Value:after="Recalculate" Label="DO" Color="Color.Success" Class="order-field order-checkbox" />
                                    <MudCheckBox T="bool" @bind-Value="panel.DC" @bind-Value:after="Recalculate" Label="DC" Color="Color.Success" Class="order-field order-checkbox" />
                                    <MudSelect T="short" @bind-Value="panel.InstallationTypeId" @bind-Value:after="Recalculate" Label="نحوه نصب" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field">@foreach (var option in Options("InstallationTypes")) { <MudSelectItem T="short" Value="@((short)option.Id)">@option.Name</MudSelectItem> }</MudSelect>
                                    <OrderChoiceAutocomplete Value="@(panel.SurfaceMetalId2 ?? 0)" ValueChanged="value => SetSecondarySurfaceMetal(panel, value)" Label="فلز رویه دوم" Options='@Options("CabinSurfaceMetals")' Clearable="true" />
                                    <MudSelect T="short" @bind-Value="panel.SpeakerId" @bind-Value:after="Recalculate" Label="کد بلندگو" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field">@foreach (var option in Options("Speakers")) { <MudSelectItem T="short" Value="@((short)option.Id)">@option.Name</MudSelectItem> }</MudSelect>
                                    <MudSelect T="short" @bind-Value="panel.EmergencyLightId" @bind-Value:after="Recalculate" Label="کد لامپ اضطراری" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field">@foreach (var option in Options("EmergencyLights")) { <MudSelectItem T="short" Value="@((short)option.Id)">@option.Name</MudSelectItem> }</MudSelect>
                                    <MudTextField T="string" @bind-Value="panel.LaserCuttingText" Label="متن برش لیزری" Immediate="true" MaxLength="255" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field order-full" />
                                    <MudTextField T="string" @bind-Value="panel.LaserEngravingText" Label="متن حک لیزری" Immediate="true" MaxLength="255" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field order-full" />
                                }
                                else if (panel.Kind == "Hall")
                                {
                                    <MudSelect T="short" @bind-Value="panel.ElevatorTypeId" @bind-Value:after="Recalculate" Label="آسانسور" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field">@foreach (var option in Options("ElevatorCounts")) { <MudSelectItem T="short" Value="@((short)option.Id)">@option.Name</MudSelectItem> }</MudSelect>
                                    <MudSelect T="short" @bind-Value="panel.PushButtonCountId" @bind-Value:after="Recalculate" Label="تعداد شاسی" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field">@foreach (var option in Options("HallPushButtonCounts")) { <MudSelectItem T="short" Value="@((short)option.Id)">@option.Name</MudSelectItem> }</MudSelect>
                                    <OrderChoiceAutocomplete @bind-Value="panel.ModelId" @bind-Value:after="Recalculate" Label="مدل پنل" Options='@Options("HallPanels")' />
                                    <OrderChoiceAutocomplete @bind-Value="panel.PushButtonId" @bind-Value:after="Recalculate" Label="پوش باتون" Options='@Options("PushButtons")' />
                                    <OrderChoiceAutocomplete @bind-Value="panel.MonitorId" @bind-Value:after="Recalculate" Label="نمایشگر" Options='@Options("Monitors")' />
                                    <OrderChoiceAutocomplete @bind-Value="panel.SurfaceMetalId" @bind-Value:after="Recalculate" Label="فلز رویه" Options='@Options("HallSurfaceMetals")' />
                                    <MudNumericField T="int" @bind-Value="panel.Count" @bind-Value:after="Recalculate" Label="تعداد" Min="1" Max="10000" Immediate="true" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                                }
                                else
                                {
                                    <MudSelect T="int" @bind-Value="panel.ModelId" @bind-Value:after="Recalculate" Label="مدل پنل" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field">@foreach (var option in Options(panel.Kind + "Panels")) { <MudSelectItem T="int" Value="@option.Id">@option.Name</MudSelectItem> }</MudSelect>
                                    <MudSelect T="int" @bind-Value="panel.MonitorId" @bind-Value:after="Recalculate" Label="نمایشگر" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field">@foreach (var option in Options("Monitors")) { <MudSelectItem T="int" Value="@option.Id">@option.Name</MudSelectItem> }</MudSelect>
                                    <MudSelect T="int" @bind-Value="panel.SurfaceMetalId" @bind-Value:after="Recalculate" Label="فلز رویه" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field">@foreach (var option in Options(panel.Kind == "DoorTop" ? "SurfaceMetals" : panel.Kind + "SurfaceMetals")) { <MudSelectItem T="int" Value="@option.Id">@option.Name</MudSelectItem> }</MudSelect>
                                    <MudNumericField T="int" @bind-Value="panel.Count" @bind-Value:after="Recalculate" Label="تعداد" Min="1" Max="10000" Immediate="true" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                                }
                                @if (panel.Kind == "Hall")
                                {
                                    <MudNumericField T="int" @bind-Value="panel.FloorCount" @bind-Value:after="Recalculate" Label="تعداد طبقات" Min="0" Max="200" Immediate="true" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                                    <MudNumericField T="int" @bind-Value="panel.UGFloorCount" @bind-Value:after="Recalculate" Label="تعداد طبقات زیرین" Min="0" Max="200" Immediate="true" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                                    <MudTextField T="string" @bind-Value="panel.FloorNames" Label="نام‌گذاری و ترتیب طبقات" Immediate="true" MaxLength="50" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                                    <MudTextField T="string" @bind-Value="panel.UGFloorNames" Label="نام‌گذاری و ترتیب طبقات زیرین" Immediate="true" MaxLength="50" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field" />
                                }
                                <MudTextField T="string" @bind-Value="panel.Comment" Label="توضیحات پنل" Immediate="true" Lines="2" MaxLength="255" Variant="Variant.Outlined" Margin="Margin.Normal" Class="order-field order-full" />
                            </div>
                            <div class="order-extras">
                                <OrderExtrasEditor Title="ملحقات" Items="panel.Attachments" Options='@Options("Attachments")' Attachments="true" ReadOnly="ReadOnly" OnChanged="Recalculate" />
                                <OrderExtrasEditor Title="اضافات" Items="panel.Additions" Options='@Options("Additions")' ReadOnly="ReadOnly" OnChanged="Recalculate" />
                            </div>
                            <div class="order-panel-footer">
                                <span>بارکد: @(panel.DocumentNumber == 0 ? "پس از ثبت" : panel.DocumentNumber.ToString()) · مبلغ کل پنل: @panel.Amount.ToString("N0") ریال</span>
                            </div>
                        </div>
                    </section>
                }
                <div class="order-bottom">
                    <section class="order-deductions" aria-label="کسورات">
                        <OrderExtrasEditor Title="کسورات" Items="form.Deductions" Options='@Options("Deductions")' ReadOnly="ReadOnly" OnChanged="Recalculate" />
                    </section>
                </div>
                @if (!ReadOnly)
                {
                    <div class="order-save-actions">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Success" Disabled="saving">@(saving ? "در حال ثبت…" : "ثبت سفارش")</MudButton>
                        <MudButton OnClick="ReloadAsync" Disabled="saving">بازنشانی تغییرات</MudButton>
                    </div>
                }
            </fieldset>
            </EditForm>
        </div>
        @if (Id > 0 && activeTab == 1)
        {
            <section class="order-tab-panel" aria-label="یادداشت ها">
                <div class="order-comment-editor">
                    <MudTextField T="string" @bind-Value="newComment" Label="یادداشت جدید" Placeholder="متن یادداشت را وارد کنید" Immediate="true" Lines="3" MaxLength="4000" Variant="Variant.Outlined" Margin="Margin.Normal" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddCommentAsync" Disabled="@(savingComment || string.IsNullOrWhiteSpace(newComment))">@(savingComment ? "در حال ثبت…" : "ثبت یادداشت")</MudButton>
                </div>
                @if (activityLoading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
                else if (!string.IsNullOrWhiteSpace(activityError)) { <MudAlert Severity="Severity.Error">@activityError</MudAlert> }
                else if (activity?.Comments.Count is null or 0) { <div class="order-tab-empty">یادداشتی برای این سفارش ثبت نشده است.</div> }
                else
                {
                    <div class="order-comments">
                        @foreach (var comment in activity.Comments.OrderByDescending(x => x.CreatedAt))
                        {
                            <article class="order-comment" @key="comment.Id">
                                <header><strong>@comment.Owner</strong><time datetime="@comment.CreatedAt.ToString("O")">@FormatDateTime(comment.CreatedAt)</time></header>
                                <p>@comment.Comment</p>
                            </article>
                        }
                    </div>
                }
            </section>
        }
        @if (Id > 0 && activeTab == 2)
        {
            <section class="order-tab-panel" aria-label="تاریخچه فعالیتها">
                @if (activityLoading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
                else if (!string.IsNullOrWhiteSpace(activityError)) { <MudAlert Severity="Severity.Error">@activityError</MudAlert> }
                else if (activity?.History.Count is null or 0) { <div class="order-tab-empty">فعالیتی برای این سفارش ثبت نشده است.</div> }
                else
                {
                    <div class="order-history-table">
                        <table>
                            <thead><tr><th class="order-history-index">ردیف</th><th>زمان</th><th>کاربر</th><th>دسته‌بندی</th><th>شماره سند</th><th>فعالیت</th><th class="order-history-description">توضیحات</th>@if (CanViewHistoryDetail) { <th class="order-history-actions">جزئیات</th> }</tr></thead>
                            <tbody>
                                @for (var index = 0; index < activity.History.Count; index++)
                                {
                                    var item = activity.History[index];
                                    <tr @key="item.Id">
                                        <td class="order-history-index">@(index + 1)</td><td>@FormatDateTime(item.EventTime)</td><td>@item.User</td><td>@item.Category</td><td>@item.DocumentNumber</td><td>@item.Activity</td><td class="order-history-description">@item.Description</td>
                                        @if (CanViewHistoryDetail) { <td class="order-history-actions"><MudIconButton Icon="@Icons.Material.Filled.List" Size="Size.Small" Color="Color.Primary" title="جزئیات فعالیت" aria-label="جزئیات فعالیت" OnClick="@(() => OpenHistoryDetails(item))" /></td> }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (selectedHistory is not null)
                    {
                        <div class="order-history-modal-backdrop" role="presentation" @onclick="CloseHistoryDetails">
                            <section class="order-history-modal" role="dialog" aria-modal="true" aria-labelledby="order-history-modal-title" @onclick:stopPropagation="true">
                                <header>
                                    <button type="button" class="order-history-modal-close" title="بستن" aria-label="بستن" @onclick="CloseHistoryDetails">×</button>
                                    <h3 id="order-history-modal-title">جزئیات فعالیت</h3>
                                </header>
                                <div class="order-history-modal-body">
                                    <dl class="order-history-details">
                                        <div><dt>زمان</dt><dd dir="ltr">@FormatDateTimeWithSeconds(selectedHistory.EventTime)</dd></div>
                                        <div class="order-history-detail-spacer" aria-hidden="true"></div>
                                        <div><dt>کاربر</dt><dd>@ValueOrDash(selectedHistory.User)</dd></div>
                                        <div><dt>آدرس IP</dt><dd dir="ltr">@ValueOrDash(selectedHistory.IpAddress)</dd></div>
                                        <div><dt>دسته</dt><dd>@ValueOrDash(selectedHistory.Category)</dd></div>
                                        <div><dt>شماره سند</dt><dd>@selectedHistory.DocumentNumber</dd></div>
                                        <div><dt>فعالیت</dt><dd>@ValueOrDash(selectedHistory.Activity)</dd></div>
                                        <div><dt>مبلغ کل پس از فعالیت</dt><dd>@(selectedHistory.Amount?.ToString("N0") ?? "—")</dd></div>
                                        <div class="order-history-detail-description"><dt>شرح</dt><dd>@ValueOrDash(selectedHistory.Description)</dd></div>
                                    </dl>
                                </div>
                            </section>
                        </div>
                    }
                }
            </section>
        }
    }
</div>
</MudRTLProvider>
@code {
    [Parameter] public int Id { get; set; }
    private OrderEditor? editor;
    private OrderForm form => editor!.Form;
    private OrderLookup? customer;
    private OrderActivity? activity;
    private string? customerText, error, success, activityError, newComment;
    private bool loading = true, saving, activityLoading, savingComment;
    private int activeTab;
    private OrderHistoryItem? selectedHistory;
    private int? loadedId;
    private byte persistedStatusId;
    private bool ReadOnly => editor?.CanEdit != true || !OrderForm.IsEditable(persistedStatusId);
    private bool CanAdvanceStatus => Id > 0 && !ReadOnly && persistedStatusId is 1 or 2
        && Session.User?.Roles.Contains("Order_Edit_Factor") == true;
    private List<OrderChoice> StatusOptions => Options("OrderStatuses")
        .Where(x => x.Id <= byte.MaxValue && OrderForm.CanChangeStatus(persistedStatusId, (byte)x.Id)).ToList();
    private bool CanPrintSpecification => Session.User?.Roles.Contains("Plan_Print") == true;
    private bool CanPrintOrder => Session.User?.Roles.Contains("Order_Print") == true;
    private bool CanViewHistoryDetail => Session.User?.Roles.Contains("Logs_Detail") == true;
    private List<OrderChoice> Options(string key) => editor!.Options.GetValueOrDefault(key) ?? [];
    private static string PanelTitle(string kind) => kind switch { "Cabin" => "پنل شاسی داخل کابین", "Hall" => "پنل شاسی طبقات", _ => "پنل سردرب" };
    private string PanelTotal(string kind) => form.Panels.Where(x => x.Kind == kind).Sum(x => x.Amount).ToString("N0");
    protected override async Task OnParametersSetAsync() { if (Session.IsInitialized && loadedId != Id) await LoadAsync(); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Session.InitializeAsync();
        if (loadedId != Id) await LoadAsync();
        StateHasChanged();
    }
    private async Task ReloadAsync() { success = null; await LoadAsync(); }
    private async Task LoadAsync()
    {
        if (!Session.IsAuthenticated) { Navigation.NavigateTo("/login"); return; }
        loading = true; editor = null; error = null; activity = null; activityError = null; selectedHistory = null; loadedId = Id; activeTab = 0;
        try
        {
            editor = await Api.GetOrderEditorAsync(Id) ?? throw new InvalidOperationException("سفارش یافت نشد.");
            persistedStatusId = form.StatusId;
            customer = form.CustomerId > 0 ? new() { Id = form.CustomerId, Name = editor.Detail.Summary.Customer } : null;
            customerText = customer?.Name;
            if (Id == 0)
            {
                foreach (var kind in new[] { "Cabin", "Hall", "DoorTop" })
                    if (!form.Panels.Any(x => x.Kind == kind)) AddPanel(kind);
                Recalculate();
            }
            else await LoadActivityAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }
    private async Task LoadActivityAsync()
    {
        activityLoading = true; activityError = null;
        try { activity = await Api.GetOrderActivityAsync(Id) ?? new(); }
        catch (Exception ex) { activityError = ex.Message; }
        finally { activityLoading = false; }
    }
    private async Task AddCommentAsync()
    {
        if (Id <= 0 || savingComment || string.IsNullOrWhiteSpace(newComment)) return;
        savingComment = true; activityError = null;
        try
        {
            var saved = await Api.AddOrderCommentAsync(Id, newComment);
            activity ??= new(); activity.Comments.Add(saved); newComment = null;
        }
        catch (Exception ex) { activityError = ex.Message; }
        finally { savingComment = false; }
    }
    private static string FormatDateTime(DateTime value) => $"{PersianDates.Format(value)} {value:HH:mm}";
    private static string FormatDateTimeWithSeconds(DateTime value) => $"{PersianDates.Format(value)} {value:HH:mm:ss}";
    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private void SelectTab(int tab) { activeTab = tab; if (tab != 2) selectedHistory = null; }
    private void OpenHistoryDetails(OrderHistoryItem item) => selectedHistory = item;
    private void CloseHistoryDetails() => selectedHistory = null;
    private void CustomerChanged(OrderLookup? value) { customer = value; form.CustomerId = value?.Id ?? 0; }
    private async Task<IEnumerable<OrderLookup>> FindCustomers(string term, CancellationToken token)
    {
        try { return await Api.FindOrderEditorCustomersAsync(term ?? "", token) ?? []; }
        catch (OperationCanceledException) { return []; }
        catch (Exception ex) { error = ex.Message; return []; }
    }
    private void Recalculate()
    {
        if (editor is null || ReadOnly) return;
        foreach (var panel in form.Panels) panel.Calculate(editor.Options, persistedStatusId);
    }
    private void AddPanel(string kind)
    {
        if (ReadOnly) return;
        int Default(string key) => Options(key).FirstOrDefault()?.Id ?? 0;
        form.Panels.Add(new() { Kind = kind, ModelId = Default(kind + "Panels"), Count = 1,
            MonitorId = Default("Monitors"), PushButtonId = Default("PushButtons"),
            SurfaceMetalId = Default(kind == "DoorTop" ? "SurfaceMetals" : kind + "SurfaceMetals"),
            SpeakerId = (short)Default("Speakers"), EmergencyLightId = (short)Default("EmergencyLights"),
            InstallationTypeId = (short)Default("InstallationTypes"), ElevatorTypeId = (short)Default("ElevatorCounts"),
            PushButtonCountId = (short)Default("HallPushButtonCounts") });
        Recalculate();
    }
    private void SetSecondarySurfaceMetal(OrderPanelForm panel, int value)
    {
        panel.SurfaceMetalId2 = value == 0 ? null : value;
        Recalculate();
    }
    private async Task SaveAsync()
    {
        if (ReadOnly || saving) return;
        error = success = null;
        if (customer is null || customer.Id != form.CustomerId || customerText != customer.Name) { error = "مشتری معتبر انتخاب کنید."; return; }
        try
        {
            var validation = new List<System.ComponentModel.DataAnnotations.ValidationResult>();
            var objects = new List<object> { form };
            objects.AddRange(form.Panels); objects.AddRange(form.Deductions);
            foreach (var panel in form.Panels) { objects.AddRange(panel.Attachments); objects.AddRange(panel.Additions); }
            if (objects.Any(x => !System.ComponentModel.DataAnnotations.Validator.TryValidateObject(x, new(x), validation, true)))
                throw new InvalidOperationException("مقادیر فرم معتبر نیست. تعدادها، مبالغ و طول متن‌ها را بررسی کنید.");
            Recalculate();
            if (form.Subtotal < 0) throw new InvalidOperationException("کسورات از مبلغ پنل‌ها بیشتر است.");
            saving = true;
            var saved = await Api.SaveOrderAsync(Id, form);
            if (Id == 0) Navigation.NavigateTo($"/documents/orders/{saved.Id}");
            else await LoadAsync();
            success = "سفارش ثبت شد.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }
}
