@using System.Globalization

<MudRTLProvider RightToLeft="true">
    <ConfirmedDatePicker @ref="picker" Date="Date" DateChanged="OnDateChangedAsync" Label="@Label" Placeholder="سال/ماه/روز"
                         Culture="@PersianCulture" DateFormat="yyyy/MM/dd" Editable="false" Clearable="false" AutoClose="false"
                         FirstDayOfWeek="DayOfWeek.Saturday" Disabled="Disabled" ReadOnly="ReadOnly"
                         PreviousIcon="@Icons.Material.Filled.ChevronRight" NextIcon="@Icons.Material.Filled.ChevronLeft"
                         Variant="Variant.Outlined" Margin="Margin" Class="@($"persian-date-picker {Class}")"
                         ActionsClass="persian-date-picker-actions">
        <PickerActions Context="pickerActions">
            <MudButton Color="Color.Primary" OnClick="() => picker!.SelectTodayAsync()">امروز</MudButton>
            <MudButton OnClick="() => picker!.SelectEmptyAsync()">پاک کردن</MudButton>
            <MudButton OnClick="() => picker!.CancelAsync()">بستن</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => picker!.ConfirmAsync()">تأیید</MudButton>
        </PickerActions>
    </ConfirmedDatePicker>
</MudRTLProvider>

@code {
    [Parameter] public DateTime? Date { get; set; }
    [Parameter] public EventCallback<DateTime?> DateChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private ConfirmedDatePicker? picker;
    private static readonly CultureInfo PersianCulture = CreatePersianCulture();

    private async Task OnDateChangedAsync(DateTime? date)
    {
        Date = date;
        await DateChanged.InvokeAsync(date);
    }

    private static CultureInfo CreatePersianCulture()
    {
        var culture = (CultureInfo)CultureInfo.GetCultureInfo("fa-IR").Clone();
        // Culture day names start on Sunday; the calendar displays Saturday first.
        culture.DateTimeFormat.AbbreviatedDayNames = ["ی", "د", "س", "چ", "پ", "ج", "ش"];
        return CultureInfo.ReadOnly(culture);
    }
}
