@inherits LayoutComponentBase
@implements IDisposable
@inject ApiSession Session
@inject BaseSiteApiClient Api
@inject NavigationManager Navigation

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Surface" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Primary" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="me-3">سامانه یکپارچه فروش و تولید</MudText>
        <MudSpacer />
        @if (Session.User is not null)
        {
            <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                <ActivatorContent Context="accountMenu">
                    <MudButton OnClick="accountMenu.ToggleAsync" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowDropDown" aria-label="تنظیمات حساب کاربری">
                        <UserAvatar ImagePath="@Session.User.ImagePath" Class="me-2" />
                        @Session.User.FullName
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Href="/account/change-password" Icon="@Icons.Material.Filled.Lock">تغییر نام کاربری و رمز عبور</MudMenuItem>
                    <MudMenuItem Href="/account/change-image" Icon="@Icons.Material.Filled.AccountCircle">تغییر عکس پروفایل</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem OnClick="LogoutAsync" Icon="@Icons.Material.Filled.Logout">خروج</MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" Anchor="Anchor.Right" Elevation="1" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <article class="app-content">
            @Body
        </article>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    خطای پیش‌بینی‌نشده‌ای رخ داد.
    <a href="." class="reload">بارگذاری دوباره</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool drawerOpen = true;

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Session.InitializeAsync();
        StateHasChanged();
    }

    private void ToggleDrawer() => drawerOpen = !drawerOpen;

    private async Task LogoutAsync()
    {
        try { await Api.LogoutAsync(); }
        catch { await Session.SignOutAsync(); }
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
