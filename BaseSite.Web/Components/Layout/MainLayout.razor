@inherits LayoutComponentBase
@implements IDisposable
@inject ApiSession Session
@inject BaseSiteApiClient Api
@inject NavigationManager Navigation

<MudRTLProvider RightToLeft="true">
<MudLayout>
    <MudAppBar Class="app-topbar" Elevation="0" Color="Color.Default">
        <MudIconButton Class="sidebar-toggle" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="ToggleDrawer"
                       aria-label="@(drawerOpen ? "بستن منوی اصلی" : "باز کردن منوی اصلی")" aria-expanded="@(drawerOpen ? "true" : "false")" aria-controls="app-sidebar" />
        <MudText Typo="Typo.h6" Class="topbar-title">سامانه یکپارچه فروش و تولید</MudText>
        <MudSpacer />
        @if (Session.User is not null)
        {
            <MudMenu Class="account-menu" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                <ActivatorContent Context="accountMenu">
                    <MudButton Class="account-menu-button" OnClick="accountMenu.ToggleAsync" Color="Color.Inherit" EndIcon="@Icons.Material.Filled.ExpandMore" aria-label="تنظیمات حساب کاربری">
                        <UserAvatar ImagePath="@Session.User.ImagePath" />
                        <span class="account-menu-name">@Session.User.FullName</span>
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Href="/account/change-password" Icon="@Icons.Material.Filled.Lock">تغییر نام کاربری و رمز عبور</MudMenuItem>
                    <MudMenuItem Href="/account/change-image" Icon="@Icons.Material.Filled.AccountCircle">تغییر عکس پروفایل</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem OnClick="LogoutAsync" Icon="@Icons.Material.Filled.Logout">خروج</MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
    </MudAppBar>

    <MudDrawer id="app-sidebar" Class="app-sidebar" @bind-Open="drawerOpen" Anchor="Anchor.Right" Elevation="0" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <NavMenu OnClose="CloseDrawer" />
    </MudDrawer>

    <MudMainContent>
        <article class="app-content">
            @Body
        </article>
    </MudMainContent>
</MudLayout>
</MudRTLProvider>

<div id="blazor-error-ui" data-nosnippet>
    خطای پیش‌بینی‌نشده‌ای رخ داد.
    <a href="." class="reload">بارگذاری دوباره</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool drawerOpen = true;

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Session.InitializeAsync();
        StateHasChanged();
    }

    private void ToggleDrawer() => drawerOpen = !drawerOpen;
    private void CloseDrawer() => drawerOpen = false;

    private async Task LogoutAsync()
    {
        try { await Api.LogoutAsync(); }
        catch { await Session.SignOutAsync(); }
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
