@page "/print/services/{id:int}/invoice"
@model BaseSite.Web.Pages.Print.Services.InvoiceModel
@{
    Layout = null;
    var title = Model.Service.StatusId > 1 ? " " : "برآورد هزینه خدمات";
    var index = 0;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@title</title>
</head>
<body>
    <link href="@Url.Content("~/Contents/css/bootstrap.css")" rel="stylesheet">
    <link href="@Url.Content("~/Contents/css/bootstrap-rtl.css")" rel="stylesheet">
    <script src="@Url.Content("~/Contents/js/jquery-3.1.1.js")"></script>
    <script src="@Url.Content("~/Contents/js/printThis.js")"></script>
    <link href="@Url.Content("~/Contents/css/MyStyle/PrintLA5.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/order-print.css")" rel="stylesheet">

    <nav class="print-toolbar" aria-label="چاپ سند">
        <button type="button" onclick="window.print()">چاپ / ذخیره PDF</button>
    </nav>

    <div class="container-fluid" id="divPrint">
        <div class="row box" id="header">
            <div class="col-xs-3 text-right">
                <p><b>شماره سند: </b><b>@Model.Service.DocNumber</b></p>
            </div>
            <div class="col-xs-6 text-center" style="font-size:large;">
                <u><b>@title</b></u>
            </div>
            <div class="col-xs-3 text-left">
                <p><b>تاریخ: </b>@Model.Service.ShDateFactor</p>
            </div>
            <div class="col-xs-8 text-right">
                <p><b>مشتری </b>@Model.Service.Account_Users.FullName</p>
            </div>
            <div class="col-xs-4 text-left">
                <p>@Model.Service.FactorNumber</p>
            </div>
        </div>

        <div class="row" style="margin-top:2px;">
            <div style="width: 100%; display: table;">
                <div style="display: table-row">
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b>ردیف</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> شرح خدمات</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> هزینه خدمات</b></p>
                    </div>
                </div>
                <div style="display: table-row">
                    <div class="box text-center" style="display: table-cell;">
                        <p><b>@(++index)</b></p>
                    </div>
                    <div class="box text-center" style="display: table-cell;">
                        <p>@Model.Service.Comment</p>
                    </div>
                    <div class="box text-center" style="display: table-cell;">
                        <p>@string.Format("{0:n0}", Model.Service.ServiceCost)</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row box" style="margin-top:2px;">
            <div class="col-xs-8 text-center">
                <p></p>
            </div>
            <div class="col-xs-2 text-left">
                <p><b>جمع کل: </b></p>
            </div>
            <div class="col-xs-2 text-left">
                <p>@string.Format("{0:n0} {1}", Model.Service.ServiceCost, "ریال")</p>
            </div>
            <div class="col-xs-8 text-center">
                <p><b>واحد فروش: </b></p>
            </div>
            <div class="col-xs-2 text-left">
                <p><b>تخفیف: </b></p>
            </div>
            <div class="col-xs-2 text-left">
                <p>@string.Format("{0:n0} {1}", Model.Service.Discount, "ریال")</p>
            </div>
            <div class="col-xs-8 text-center">
                <p></p>
            </div>
            <div class="col-xs-2 text-left">
                <p><b>@string.Format("{0} درصد عوارض:", Model.Service.Tax) </b></p>
            </div>
            <div class="col-xs-2 text-left">
                <p>@string.Format("{0:n0} {1}", ((Model.Service.ServiceCost - Model.Service.Discount) * Model.Service.Tax / 100), "ریال")</p>
            </div>
            <div class="col-xs-8 text-center">
                <p></p>
            </div>
            <div class="col-xs-2 text-left">
                <p><b>حمل و نقل: </b></p>
            </div>
            <div class="col-xs-2 text-left">
                <p>@string.Format("{0:n0} {1}", Model.Service.DeliveryCost, "ریال")</p>
            </div>
            <div class="col-xs-8 text-right">
                <p><b> مبلغ به حروف:  @NumberToWordsLib.HumanReadableInteger.NumberToText(Model.Service.Cost, NumberToWordsLib.Language.Persian) ریال</b></p>
            </div>
            <div class="col-xs-2 text-left">
                <p><b>قابل پرداخت: </b></p>
            </div>
            <div class="col-xs-2 text-left">
                <p><b>@string.Format("{0:n0} {1}", Model.Service.Cost, "ریال")</b></p>
            </div>

            @if (Model.Service.StatusId == 1)
            {
                <div class="col-xs-12 text-right">
                    <p>* اعتبار پیش فاکتور 24 ساعت می باشد</p>
                </div>
            }
        </div>
    </div>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#divPrint').printThis({
                importCSS: true,
                importStyle: true,
                printContainer: true,
                copyTagClasses: true
            });
        });
    </script>

</body>
</html>
