                                    </div>
                                    <div class="col-xs-4 text-right">
                                        <p><b>فلزرویه: </b>@Model.Order.Order_Hall.ElementAt(i).Tb_HallSurfaceMetals.Name</p>
                                    </div>
                                    <div class="col-xs-2 text-right">
                                        <p><b>تعداد طبقات: </b>@Model.Order.Order_Hall.ElementAt(i).FloorCount</p>
                                    </div>
                                    <div class="col-xs-6 text-right">
                                        <b style="float:right; padding-left:5px;">نام و ترتیب طبقات: </b><p style="direction:ltr; float:right;">@Model.Order.Order_Hall.ElementAt(i).FloorNames</p>
                                    </div>
                                    <div class="col-xs-4 text-right">
                                        <p><b>طبقات زیرین: </b>@Model.Order.Order_Hall.ElementAt(i).UGFloorCount</p>
                                    </div>
                                    <div class="col-xs-12 text-right">
                                        <p style="line-height:20px;"><b>توضیحات: </b>@Model.Order.Order_Hall.ElementAt(i).Comment</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
