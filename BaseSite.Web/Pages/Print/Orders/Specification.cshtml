        @if (Model.Order.Order_DoorTop.Count > 0 && Model.Order.Order_DoorTop.ElementAt(0).Tb_DoorTopPanels.Id > 0)
        {
            for (int i = 0; i < Model.Order.Order_DoorTop.Count; i++)
            {
                if (Model.Order.Order_DoorTop.ElementAt(i).Tb_DoorTopPanels.Id > 0)
                {
                    <div class="row">
                        <div style="width: 100%; display: table;">
                            <div style="display: table-row">
                                <div class="box" style="width: 30px; display: table-cell;padding:1px;">
                                    <div><p> پنل <p /><p> سردرب </p></div>
                                </div>
                                <div class="row box" style="display: table-cell;">
                                    <div class="col-xs-10 text-right">
                                        <p><b>مدل پنل: </b>@Model.Order.Order_DoorTop.ElementAt(i).Tb_DoorTopPanels.Name</p>
                                    </div>
                                    <div class="col-xs-2 text-right">
