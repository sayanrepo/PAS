                            <div class="col-xs-2 text-right">
                                <p><b>تعداد: </b></p>
                            </div>
                            
                            <div class="col-xs-8 text-right">
                                <p><b>پوش باتون: </b></p>
                            </div>
                            <div class="col-xs-4 text-right">
                                <p><b>شروع از: </b></p>
                            </div>
                            <div class="col-xs-8 text-right">
                                <p><b>نمایشگر: </b></p>
                            </div>
                            <div class="col-xs-4 text-right">
                                <p><b>فلزرویه: </b></p>
                            </div>
                            <div class="col-xs-2 text-right">
                                <p><b>تعداد طبقات: </b></p>
                            </div>
                            <div class="col-xs-6 text-right">
                                <b style="float:right; padding-left:5px;">نام و ترتیب طبقات: </b><p style="direction:ltr; float:right;"></p>
                            </div>
                            <div class="col-xs-4 text-right">
                                <p><b>طبقات زیرین: </b></p>
                            </div>
                            <div class="col-xs-12 text-right">
                                <p style="line-height:20px;"><b>توضیحات: </b></p>
