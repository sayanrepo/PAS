                                <div class="col-xs-1 text-center boxCell col6">
                                    <input class="autoNumber" type="text" value="@(Model.Order.Order_DoorTop.ElementAt(i).Order_Panel_Attachment.ElementAt(j).Count == 0 ? "0" : string.Format("{0}", (Model.Order.Order_DoorTop.ElementAt(i).Order_Panel_Attachment.ElementAt(j).Cost / Model.Order.Order_DoorTop.ElementAt(i).Order_Panel_Attachment.ElementAt(j).Count)))" />
                                </div>
                                <div class="col-xs-1 text-center boxCell col7">
                                    <input class="autoNumber" type="text" value="@string.Format("{0}", Model.Order.Order_DoorTop.ElementAt(i).Order_Panel_Attachment.ElementAt(j).Cost)" />
