@page "/print/payments/{id:int}/{kind}"
@model BaseSite.Web.Pages.Print.Payments.ReceiptModel
@{
    Layout = null;
    var title = "رسید دریافت";
    var index = 0;
}
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@title</title>
</head>
<body>
    <link href="@Url.Content("~/Contents/css/bootstrap.css")" rel="stylesheet">
    <link href="@Url.Content("~/Contents/css/bootstrap-rtl.css")" rel="stylesheet">
    <script src="@Url.Content("~/Contents/js/jquery-3.1.1.js")"></script>
    <script src="@Url.Content("~/Contents/js/printThis.js")"></script>
    <link href="@Url.Content("~/Contents/css/MyStyle/PrintLA5.css")" rel="stylesheet">
    <link href="@Url.Content("~/css/order-print.css")" rel="stylesheet">

    <nav class="print-toolbar" aria-label="چاپ سند">
        <button type="button" onclick="window.print()">چاپ / ذخیره PDF</button>
    </nav>

    <div class="container-fluid" id="divPrint">
        <div class="row">
            <div class="col-xs-1" style="width:20px; padding-top:50px;">
                @if (Model.Accounting)
                {
                    <div class="rotate" style="float:left;">نسخه حسابداری</div>
                }
                else
                {
                    <div class="rotate" style="float:left;">نسخه مشتری</div>
                }
            </div>
            <div class="col-xs-11">
                <div class="row box" id="header">
                    <div class="col-xs-3 text-right">
                        <p><b>تاریخ: </b>@Model.Payment.PrintedAt</p>
                    </div>
                    <div class="col-xs-6 text-center" style="font-size:large;">
                        <u><b>@title</b></u>
                    </div>
                    <div class="col-xs-3 text-left">
                        <p><b>شماره سند: </b>@Model.Payment.DocNumber</p>
                    </div>
                </div>

                <div class="row box" style="margin-top:2px; padding-top:10px;">
                    <div class=" col-xs-8 text-right">
                        <p><b> مبلغ به حروف:  @NumberToWordsLib.HumanReadableInteger.NumberToText(Model.Payment.Amount, NumberToWordsLib.Language.Persian) ریال</b></p>
                    </div>
                    <div class="col-xs-4 text-left">
                        <p><b>به عدد </b><span style="border:solid 1px; padding:2px; margin:2px;">@string.Format("{0:n0}", Model.Payment.Amount)</span>ریال</p>
                    </div>
                </div>

                <div class="row" style="margin-top:2px;">
                    <div style="width: 100%; display: table;">
                        <div style="display: table-row">
                            <div class="box bg-info text-center" style="display: table-cell;">
                                <p><b>ردیف</b></p>
                            </div>
                            <div class="box bg-info text-center" style="display: table-cell;">
                                <p><b> نحوه وصول</b></p>
                            </div>
                            <div class="box bg-info text-center" style="display: table-cell;">
                                <p><b> شماره چک/حواله</b></p>
                            </div>
                            <div class="box bg-info text-center" style="display: table-cell;">
                                <p><b> سررسید چک</b></p>
                            </div>
                            <div class="box bg-info text-center" style="display: table-cell;">
                                <p><b> نام بانک</b></p>
                            </div>
                            <div class="box bg-info text-center" style="display: table-cell;">
                                <p><b> شعبه</b></p>
                            </div>
                            <div class="box bg-info text-center" style="display: table-cell;">
                                <p><b> شماره حساب</b></p>
                            </div>
                            <div class="box bg-info text-center" style="display: table-cell;">
                                <p><b> مبلغ</b></p>
                            </div>
                            @*<div class="box bg-info text-center" style="display: table-cell;">
                                <p><b> نام پروژه</b></p>
                            </div>*@
                            <div class="box bg-info text-center" style="display: table-cell;">
                                <p><b> توضیحات</b></p>
                            </div>
                        </div>
                        <div style="display: table-row">
                            <div class="box text-center" style="display: table-cell;">
                                <p><b>@(++index)</b></p>
                            </div>
                            <div class="box text-center" style="display: table-cell;">
                                <p>@Model.Payment.PaymentTypeName</p>
                            </div>
                            <div class="box text-center" style="display: table-cell;">
                                <p>@Model.Payment.ReferenceNumber</p>
                            </div>
                            <div class="box text-center" style="display: table-cell;">
                                <p>@Model.Payment.DueDate</p>
                            </div>
                            <div class="box text-center" style="display: table-cell;">
                                <p>@Model.Payment.BankName</p>
                            </div>
                            <div class="box text-center" style="display: table-cell;">
                                <p>@Model.Payment.BankBranchCode</p>
                            </div>
                            <div class="box text-center" style="display: table-cell;">
                                <p>@Model.Payment.AccountNumber</p>
                            </div>
                            <div class="box text-center" style="display: table-cell;">
                                <p>@string.Format("{0:n0}", Model.Payment.Amount)</p>
                            </div>
                            @*<div class="box text-center" style="display: table-cell;">
                                <p></p>
                            </div>*@
                            <div class="box text-center" style="display: table-cell;">
                                <p>@Model.Payment.Comment</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row box" style="margin-top:2px; padding:10px;">
                    <div class="col-xs-12 text-right">
                        <p>
                            @string.Format("طی موارد مشروحه فوق از شرکت/آقای/خانم \t\t {0} \t\t  به اینجانب \t\t {1} \t\t تحویل گردید.",
                        Model.Payment.CustomerName,
                        Model.Payment.PrinterName)
                        </p>
                    </div>
                    <br /><br />
                    <div class="col-xs-6 text-right">
                        @if (Model.Accounting)
                        {
                            <p><b>امضای تحویل دهنده: </b></p>
                        }
                    </div>
                    <div class="col-xs-6 text-right">
                        <p><b>امضای تحویل گیرنده: </b></p>
                    </div>
                    <br /><br />
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#divPrint').printThis({
                importCSS: true,
                importStyle: true,
                printContainer: true,
                copyTagClasses: true
            });
        });
    </script>

</body>
</html>
