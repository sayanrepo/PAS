@page "/print/sales/{id:int}/invoice"
@model BaseSite.Web.Pages.Print.Sales.InvoiceModel
@{
    Layout = null;
    var title = Model.Sale.GiveBack ? "فاکتور برگشت از فروش" : Model.Sale.StatusId > 1 ? " " : "برآورد هزینه";
    var index = 0;
    double sum = 0;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@title</title>
</head>
<body>
    <link href="@Url.Content("~/Contents/css/bootstrap.css")" rel="stylesheet">
    <link href="@Url.Content("~/Contents/css/bootstrap-rtl.css")" rel="stylesheet">
    <script src="@Url.Content("~/Contents/js/jquery-3.1.1.js")"></script>
    <script src="@Url.Content("~/Contents/js/printThis.js")"></script>
    <link href="@Url.Content("~/Contents/css/MyStyle/PrintLA5.css")" rel="stylesheet">

    <div class="container-fluid" id="divPrint">
        <div class="row box" id="header">
            <div class="col-xs-3 text-right">
                <p><b>شماره سند: </b><b>@Model.Sale.DocNumber</b></p>
            </div>
            <div class="col-xs-6 text-center" style="font-size:large;">
                <u><b>@title</b></u>
            </div>
            <div class="col-xs-3 text-left">
                <p><b>تاریخ: </b>@(Model.Sale.StatusId < 7 ? PersianDates.Format(DateTime.Now) : Model.Sale.ShDateFactor)</p>
            </div>
            <div class="col-xs-8 text-right">
                <p><b>@string.Format("{0}", Model.Sale.GiveBack ? "مرجوع کننده: " : "مشتری: ") </b>@Model.Sale.Account_Users.FullName</p>
            </div>
            <div class="col-xs-4 text-left">
                <p>@Model.Sale.FactorNumber</p>
            </div>
        </div>

        <div class="row" style="margin-top:2px;">
            <div style="width: 100%; display: table;">
                <div style="display: table-row">
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b>ردیف</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> شرح کالا</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> تعداد</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> فی</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> جمع</b></p>
                    </div>
                    @*<div class="box bg-info text-center" style="display: table-cell;">
                            <p><b> دلیل برگشتی</b></p>
                        </div>*@
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> توضیحات</b></p>
                    </div>
                </div>
                @for (int i = 0; i < Model.Sale.Sale_Goods.Count; i++)
                {
                    if (!string.IsNullOrEmpty(Model.Sale.Sale_Goods.ElementAt(i).Name) || Model.Sale.Sale_Goods.ElementAt(i).Count > 0)
                    {
                        sum += (Model.Sale.Sale_Goods.ElementAt(i).Phi * Model.Sale.Sale_Goods.ElementAt(i).Count);
                        <div style="display: table-row">
                            <div class="box text-center" style="display: table-cell;">
                                <p><b>@(++index)</b></p>
                            </div>
                            <div class="box text-center" style="display: table-cell;">
                                <p>@Model.Sale.Sale_Goods.ElementAt(i).Name</p>
                            </div>
                            <div class="box text-center" style="display: table-cell;">
                                <p>@Model.Sale.Sale_Goods.ElementAt(i).Count</p>
                            </div>
                            <div class="box text-center" style="display: table-cell;">
                                <p>@string.Format("{0:n0}", Model.Sale.Sale_Goods.ElementAt(i).Phi)</p>
                            </div>
                            <div class="box text-center" style="display: table-cell;">
                                <p>@string.Format("{0:n0}", Model.Sale.Sale_Goods.ElementAt(i).Phi * Model.Sale.Sale_Goods.ElementAt(i).Count)</p>
                            </div>
                            @*<div class="box text-center" style="display: table-cell;">
                                    <p>@Model.Sale.Sale_Goods.ElementAt(i).Phi</p>
                                </div>*@
                            <div class="box text-center" style="display: table-cell;">
                                <p>@Model.Sale.Sale_Goods.ElementAt(i).Comment</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="row box" style="margin-top:2px;">
            <div class="col-xs-8 text-center">
                <p></p>
            </div>
            <div class="col-xs-2 text-left">
                <p><b>جمع کل: </b></p>
            </div>
            <div class="col-xs-2 text-left">
                <p>@string.Format("{0:n0} {1}", sum, "ریال")</p>
            </div>
            <div class="col-xs-8 text-center">
                <p><b>واحد فروش: </b></p>
            </div>
            <div class="col-xs-2 text-left">
                <p><b>تخفیف: </b></p>
            </div>
            <div class="col-xs-2 text-left">
                <p>@string.Format("{0:n0} {1}", Model.Sale.Discount, "ریال")</p>
            </div>
            <div class="col-xs-8 text-center">
                <p></p>
            </div>
            <div class="col-xs-2 text-left">
                <p><b>@string.Format("{0} درصد عوارض:", Model.Sale.Tax) </b></p>
            </div>
            <div class="col-xs-2 text-left">
                <p>@string.Format("{0:n0} {1}", ((sum - Model.Sale.Discount) * Model.Sale.Tax / 100), "ریال")</p>
            </div>
            <div class="col-xs-8 text-center">
                <p></p>
            </div>
            <div class="col-xs-2 text-left">
                <p><b>حمل و نقل: </b></p>
            </div>
            <div class="col-xs-2 text-left">
                <p>@string.Format("{0:n0} {1}", Model.Sale.DeliveryCost, "ریال")</p>
            </div>
            <div class="col-xs-8 text-right">
                <p><b> مبلغ به حروف:  @NumberToWordsLib.HumanReadableInteger.NumberToText(Model.Sale.Cost, NumberToWordsLib.Language.Persian) ریال</b></p>
            </div>
            <div class="col-xs-2 text-left">
                <p><b>قابل پرداخت: </b></p>
            </div>
            <div class="col-xs-2 text-left">
                <p><b>@string.Format("{0:n0} {1}", Model.Sale.Cost, "ریال")</b></p>
            </div>

            @if (Model.Sale.StatusId == 1)
            {
                <div class="col-xs-12 text-right">
                    <p>* اعتبار پیش فاکتور 24 ساعت می باشد</p>
                </div>
            }
        </div>
    </div>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#divPrint').printThis({
                importCSS: true,
                importStyle: true,
                printContainer: true,
                copyTagClasses: true
            });
        });
    </script>

</body>
</html>

