@page "/print/deliveries/{id:int}/delivery"
@model BaseSite.Web.Pages.Print.Deliveries.DeliveryModel
@{
    Layout = null;
    var title = "فرم تحویل کالا";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@title</title>
</head>
<body>
    <link href="@Url.Content("~/Contents/css/bootstrap.css")" rel="stylesheet">
    <link href="@Url.Content("~/Contents/css/bootstrap-rtl.css")" rel="stylesheet">
    <script src="@Url.Content("~/Contents/js/jquery-3.1.1.js")"></script>
    <script src="@Url.Content("~/Contents/js/printThis.js")"></script>
    <link href="@Url.Content("~/Contents/css/MyStyle/PrintPA4.css")" rel="stylesheet">

    <link href="@Url.Content("~/css/order-print.css")" rel="stylesheet">

    <nav class="print-toolbar" aria-label="چاپ سند">
        <button type="button" onclick="window.print()">چاپ / ذخیره PDF</button>
    </nav>

    <div class="container-fluid" id="divPrint">
        <div class="row box" id="header">
            <div class="col-xs-4 text-right">
                <p style="line-height:26px;"><b>شماره حواله خروج: </b>@Model.Delivery.DocNumber</p>
            </div>
            <div class="col-xs-4 text-center">
                <u><b style="font-size:22px; line-height:26px;">@title</b></u>
            </div>
            <div class="col-xs-4 text-left">
                <p style="line-height:26px;"><b>تاریخ: </b>@Model.Delivery.ShDate</p>
            </div>
            @*<div class="col-xs-2 text-left">
                <p style="line-height:26px;"><b>ساعت: </b>@Model.Delivery.Date.Value.ToShortTimeString()</p>
            </div>*@
            <div class="col-xs-4 text-right">
                <p><b>شماره سند: </b>@(Model.Delivery.Order_Order != null ? Model.Delivery.Order_Order.DocNumber : Model.Delivery.Sale_Sale.DocNumber)</p>
            </div>
            <div class="col-xs-4 text-center">
                <p><b>نام پروژه: </b>@(Model.Delivery.Order_Order != null ? Model.Delivery.Order_Order.ProjectName : "-")</p>
            </div>
            <div class="col-xs-4 text-left">
                <p>@(Model.Delivery.Order_Order != null ? Model.Delivery.Order_Order.FactorNumber : Model.Delivery.Sale_Sale.FactorNumber)</p>
            </div>
        </div>
        <div class="row box">
            <div class="col-xs-4 text-right">
                <p style="font-size:18px; line-height:22px;"><b>فرستنده: </b>پنتا</p>
            </div>
            <div class="col-xs-4 text-center">
                <p style="font-size:18px; line-height:22px;"><b>تلفن: </b>26208257 - 26208251</p>
            </div>
            <div class="col-xs-4 text-left">
                <p style="font-size:18px; line-height:22px;"><b>فاکس: </b>26208314</p>
            </div>
            <div class="col-xs-12">
                <p><b>آدرس: </b><b style="font-size:20px;line-height:24px;">تهران- بلوار آفریقا- بلوار ناهید شرقی- پلاک 14- طبقه چهارم- واحد14</b></p>
            </div>
        </div>
        <div class="row box" style="padding-top:5px;">
            <div class="col-xs-3">
                <p>نام هماهنگ کننده ترتیبات حمل</p>
            </div>
            <div class="col-xs-4">
                <p><b>سمت فرستنده: </b>@Model.Delivery.SendResponsible</p>
            </div>
            <div class="col-xs-4">
                <p><b>سمت گیرنده: </b>@Model.Delivery.RecieveResponsible</p>
            </div>
        </div>
        <div class="row box" style="line-height: 14px; min-height: 300px;padding-top:7px;">
            <div class="col-xs-5 text-right">
                <p>وضعیت بسته بندی:</p>
            </div>
            <div class="col-xs-7 text-right">
                <p><b>نوع بسته بندی: </b>@Model.Delivery.Tb_PackTypes.Name</p>
            </div>

            <div class="col-md-12 col-sm-12 col-xs-12" style="display: table; line-height: 14px;">
                <div style="display: table-row">
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p><b>شرح کالا</b></p>
                    </div>
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p><b>تعداد</b></p>
                    </div>
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p><b>توضیحات</b></p>
                    </div>
                </div>
                @for (int i = 0; i < Model.Delivery.Items.Count; i++)
                {
                    if (Model.Delivery.Items.ElementAt(i).Checked)
                    {
                        <div style="display: table-row">
                            <div class="boxThin text-right" style="display: table-cell;">
                                <p> @Model.Delivery.Items.ElementAt(i).Name</p>
                            </div>
                            <div class="boxThin text-center" style="display: table-cell;">
                                <p> @Model.Delivery.Items.ElementAt(i).Count</p>
                            </div>
                            <div class="boxThin text-center" style="display: table-cell;">
                                <p> @Model.Delivery.Items.ElementAt(i).Comment</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="row box" style="padding-top:5px; padding-bottom:5px;">
            <div class="col-md-12 col-sm-12 col-xs-12" style="display: table; line-height: 14px;">
                <div style="display: table-row">
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p><b>ارسال به</b></p>
                    </div>
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p><b>حمل توسط</b></p>
                    </div>
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p><b>پیک/آژانس</b></p>
                    </div>
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p><b>قبض آژانس</b></p>
                    </div>
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p><b>شماره ماشین</b></p>
                    </div>
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p><b>راننده</b></p>
                    </div>
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p><b>تلفن راننده</b></p>
                    </div>
                </div>
                <div style="display: table-row">
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p>@Model.Delivery.Delivery_DeliveryLocations.Name</p>
                    </div>
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p>@Model.Delivery.Delivery_VehicleTypes.Name</p>
                    </div>
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p>@Model.Delivery.CarierAgencyName</p>
                    </div>
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p>@Model.Delivery.CarierAgencyBill</p>
                    </div>
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p>@Model.Delivery.VehiclePlaque</p>
                    </div>
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p>@Model.Delivery.DriverName</p>
                    </div>
                    <div class="boxThin text-center" style="display: table-cell;">
                        <p>@Model.Delivery.DriverPhone</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="row box">
            <div class="col-xs-8 text-right">
                <p style="line-height: 26px; font-size: 18px;">نام شرکت تحویل گیرنده: <b style="font-size:22px;">@Model.Delivery.RecieverName</b></p>
            </div>
            <div class="col-xs-4 text-right">
                <p style="line-height: 26px; font-size: 18px;"><b>تلفن: </b>@Model.Delivery.RecieverPhone</p>
            </div>
            <div class="col-xs-4 col-xs-offset-8 text-right">
                <p style="line-height: 26px; font-size: 18px;"><b>موبایل: </b>@Model.Delivery.RecieverMobile</p>
            </div>
            <div class="col-xs-12 text-right">
                <p style="font-size:16px;line-height:24px;"><b style="font-size:20px;line-height:24px;">آدرس دقیق محل تحویل کالا: </b>(محدوده های آدرس را حتما با استفاده از نامهای شناخته شده، مشخص کنید تا پیدا کردن آدرس سریع تر انجام شود)</p>
            </div>
            <div class="col-xs-12 text-center">
                <p style="font-size:22px; line-height:26px;"><b>@Model.Delivery.DestinationAddress</b></p>
            </div>
        </div>
        <div class="row box">
            <div class="col-xs-12 text-right">
                <p style="line-height:18px;">رسید تحویل: </p>
            </div>
            <div class="col-xs-12 text-right">
                <p style="line-height:18px;">بدینوسیله تائید می نمایم، تعداد ............ بسته کالای فوق در تاریخ  ......../........./.........  ساعت  ......  :  ......  صحیح و سالم تحویل اینجانب  .............................................  گردید.</p>
            </div>
            <div class="col-xs-11 text-left">
                <p style="line-height:18px;">امضای تحویل گیرنده</p>
            </div>
            <div class="col-xs-12 text-right">
                <p style="line-height:18px;"><input type="checkbox" disabled="disabled" /> در صورت تحویل به پایانه حمل، بارنامه ضمیمه شود</p>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#divPrint').printThis({
                importCSS: true,
                importStyle: true,
                printContainer: true,
                copyTagClasses: true
            });
        });
    </script>

</body>
</html>

