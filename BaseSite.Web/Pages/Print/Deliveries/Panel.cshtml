@page "/print/deliveries/{id:int}/panel"
@model BaseSite.Web.Pages.Print.Deliveries.PanelModel
@{
    Layout = null;
    var title = "لیبل پنل";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@title</title>
</head>
<body>
    <link href="@Url.Content("~/Contents/css/bootstrap.css")" rel="stylesheet">
    <link href="@Url.Content("~/Contents/css/bootstrap-rtl.css")" rel="stylesheet">
    <script src="@Url.Content("~/Contents/js/jquery-3.1.1.js")"></script>
    <script src="@Url.Content("~/Contents/js/printThis.js")"></script>
    <link href="@Url.Content("~/Contents/css/MyStyle/PrintLabel.css")" rel="stylesheet">

    <link href="@Url.Content("~/css/order-print.css")" rel="stylesheet">

    <nav class="print-toolbar" aria-label="چاپ سند">
        <button type="button" onclick="window.print()">چاپ / ذخیره PDF</button>
    </nav>

    <div id="divPrint">
        @for (int i = 0; i < Model.Delivery.Items.Count; i++)
        {
            if (Model.Delivery.Items.ElementAt(i).Checked)
            {
                <div style="display: table; line-height: 6mm; margin-bottom:1px; width: 49mm;">
                    <div style="display: table-row">
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p><b>شماره سند</b></p>
                        </div>
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p>@(Model.Delivery.Order_Order != null ? Model.Delivery.Order_Order.DocNumber : Model.Delivery.Sale_Sale.DocNumber)</p>
                        </div>
                    </div>
                    <div style="display: table-row">
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p><b>مشتری</b></p>
                        </div>
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p> @(Model.Delivery.Order_Order != null ? Model.Delivery.Order_Order.Account_Users.FullName : Model.Delivery.Sale_Sale.Account_Users.FullName)</p>
                        </div>
                    </div>
                    <div style="display: table-row">
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p><b>نوع</b></p>
                        </div>
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p> @Model.Delivery.Items.ElementAt(i).TypeName()</p>
                        </div>
                    </div>
                    <div style="display: table-row">
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p><b>مدل</b></p>
                        </div>
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p> @Model.Delivery.Items.ElementAt(i).Model</p>
                        </div>
                    </div>
                </div>
                <div class="pagebreak"> </div>
            }
        }
    </div>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#divPrint').printThis({
                importCSS: true,
                importStyle: true,
                printContainer: true,
                copyTagClasses: true
            });
        });
    </script>

</body>
</html>

