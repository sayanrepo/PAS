<script src="@Url.Content("~/Contents/js/printThis.js")"></script>
<script type="text/javascript">
    function destinationChange(type)
    {
        if(type==1)
        {
            $("#DestinationAddress").val('@ViewBag.CustomerAddress');
        }
        else if(type==2)
        {
            $("#DestinationAddress").val('@ViewBag.ProjectAddress');
        }
    }

    $(document).ready(function () {
        $("#Customer").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "@Url.Action("AutoCompleteUsers", "Order")",
                    type: "POST",
                    dataType: "json",
                    data: { Prefix: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.Name, value: item.Name, id: item.Id };
                        }))
                    }
                })
            },
            select: function (event, ui) {
                $("#CustomerId").val(ui.item.id);
            },
            minLength: 1
        });


        $("#CabinPanel").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "@Url.Action("AutoCompleteCabinPanels", "Order")",
                    type: "POST",
                    dataType: "json",
                    data: { Prefix: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.Name, value: item.Name, id: item.Id, desc: item.Cost };
                        }))
                    }
                })
            },
            select: function (event, ui) {
                $("#CabinPanelId").val(ui.item.id);
            },
            minLength: 0
        })
        .autocomplete("instance")._renderItem = function (ul, item) {
            return $("<li>")
              .append("<table style='width:100%'><col width='80%'><col width='20%'><tr><td>" + item.label + "</td><td>" + item.desc + "</td></tr></table>")
              .appendTo(ul);
        };


        $("#CabinPushButton").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "@Url.Action("AutoCompletePushButtons", "Order")",
                    type: "POST",
                    dataType: "json",
                    data: { Prefix: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.Name, value: item.Name, id: item.Id, desc: item.Cost };
                        }))
                    }
                })
            },
            select: function (event, ui) {
                $("#CabinPushButtonId").val(ui.item.id);
            },
            minLength: 0
        })
        .autocomplete("instance")._renderItem = function (ul, item) {
            return $("<li>")
              .append("<table style='width:100%'><col width='80%'><col width='20%'><tr><td>" + item.label + "</td><td>" + item.desc + "</td></tr></table>")
              .appendTo(ul);
        };


        $("#CabinMonitor").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "@Url.Action("AutoCompleteMonitors", "Order")",
                    type: "POST",
                    dataType: "json",
                    data: { Prefix: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.Name, value: item.Name, id: item.Id, desc: item.Cost };
                        }))
                    }
                })
