@{
    Layout = null;
    ViewBag.title = "لیبل پنل";
}
@model BaseSite.Models.DBModel.Delivery_Delivery

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.title</title>
</head>
<body>
    <link href="@Url.Content("~/Contents/css/bootstrap.css")" rel="stylesheet">
    <link href="@Url.Content("~/Contents/css/bootstrap-rtl.css")" rel="stylesheet">
    <script src="@Url.Content("~/Contents/js/jquery-3.1.1.js")"></script>
    <script src="@Url.Content("~/Contents/js/printThis.js")"></script>
    <link href="@Url.Content("~/Contents/css/MyStyle/PrintLabel.css")" rel="stylesheet">

    <div id="divPrint">
        @for (int i = 0; i < Model.Items.Count; i++)
        {
            if (Model.Items.ElementAt(i).Checked)
            {
                <div style="display: table; line-height: 14px; margin:1px; width: 100%; max-height: 33mm; height: 33mm;">
                    <div style="display: table-row">
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p><b>شماره سند</b></p>
                        </div>
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p>@(Model.Order_Order != null ? Model.Order_Order.DocNumber : Model.Sale_Sale.DocNumber)</p>
                        </div>
                    </div>
                    <div style="display: table-row">
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p><b>نام مشتری</b></p>
                        </div>
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p> @Model.RecieverName</p>
                        </div>
                    </div>
                    <div style="display: table-row">
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p><b>مدل</b></p>
                        </div>
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p> @Model.Items.ElementAt(i).Name</p>
                        </div>
                    </div>
                    <div style="display: table-row">
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p><b>ملحقات</b></p>
                        </div>
                        <div class="boxThin text-center" style="display: table-cell;">
                            <p> @Model.Items.ElementAt(i).Comment</p>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#divPrint').printThis({
                importCSS: true,
                importStyle: true,
                printContainer: true,
                copyTagClasses: true
            });
        });
    </script>

</body>
</html>