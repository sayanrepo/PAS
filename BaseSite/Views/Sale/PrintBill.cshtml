@model BaseSite.Models.DBModel.Sale_Sale
@{
    Layout = null;
    ViewBag.title = "صورتحساب فروش کالا";
    ViewBag.index = 0;
    ViewBag.sum = 0;
    Model.Account_Users = BaseSite.Models.Account.AccountManager.Account_User_Get(Model.CustomerId);
    string sdate = Model.StatusId < (byte)BaseSite.Models.OrderStatus.MojavezKhorooj ? new PersianDateTime(DateTime.Now).ToString(PersianDateTimeFormat.Date) : Model.ShDateFactor;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.title</title>
</head>
<body>
    <link href="@Url.Content("~/Contents/css/bootstrap.css")" rel="stylesheet">
    <link href="@Url.Content("~/Contents/css/bootstrap-rtl.css")" rel="stylesheet">
    <script src="@Url.Content("~/Contents/js/jquery-3.1.1.js")"></script>
    <script src="@Url.Content("~/Contents/js/printThis.js")"></script>
    <link href="@Url.Content("~/Contents/css/MyStyle/PrintBill.css")" rel="stylesheet">

    <div class="container-fluid" id="divPrint">
        <div class="row">
            <div class="col-xs-12 text-center" style="padding-top:3px;padding-bottom:3px;">
                <b style="font-size:25px;">صورتحساب فروش کالا</b>
            </div>
        </div>
        <div class="row box" style="padding-top:0;padding-bottom:0;">
            <div class="col-xs-4"></div>
            <div class="col-xs-4 text-center" style="padding-top:8px;">
                <b style="font-size:25px;">مشخصات فروشنده</b>
            </div>
            <div class="col-xs-4" style="padding:0;">
                <div class="row">
                    <div class="col-xs-6 text-right" style="direction: rtl; border-left: 2px solid;">
                        <pre style="margin-bottom:3px;">شماره:<input type="text" style="font-size:16px; font-weight:bold; display:inline-block; width:90px;text-align:center;" /></pre>
                    </div>
                    <div class="col-xs-6 text-right" style="direction:rtl;">
                        <p style="margin-bottom:2px;">تاریخ:&nbsp;<input type="text" style="font-size:16px; font-weight:bold; display:inline-block; width:90px;text-align:center;" value="@sdate" /></p>
                    </div>
                </div>
            </div>
        </div>
        <div class="row box" id="header" style="height:28mm; margin-top:1px;padding:5px;">
            <div class="col-xs-12">
                <div class="row" style="padding-top:1mm; height:9mm;">
                    <div class="col-xs-4 text-right" style="width:104mm; padding-left:0;">
                        <p class="field">نام شخص حقیقی/ حقوقی: <b style="font-size:20px;">شرکت پارسیان نوین تک آسانبر</b></p>
                    </div>
                    <div class="col-xs-4 text-right" style="width:83mm; padding-left:0;">
                        <p class="field">
                            شماره اقتصادی:
                            <b class="digits">
                                <span>4</span>
                                <span>1</span>
                                <span>1</span>
                                <span>1</span>
                                <span>3</span>
                                <span>7</span>
                                <span>5</span>
                                <span>9</span>
                                <span>7</span>
                                <span>1</span>
                                <span>1</span>
                                <span>9</span>
                            </b>
                        </p>
                    </div>
                    <div class="col-xs-4 text-right" style="width:83mm; padding-left:0;">
                        <p class="field">
                            شماره ثبت/شماره ملی:
                            <b class="digits">
                                <span>2</span>
                                <span>6</span>
                                <span>5</span>
                                <span>5</span>
                                <span>8</span>
                                <span>5</span>
                                <span>&nbsp;</span>
                                <span>&nbsp;</span>
                                <span>&nbsp;</span>
                                <span>&nbsp;</span>
                            </b>
                        </p>
                    </div>
                </div>
                <div class="row" style="height:9mm;">
                    <div class="col-xs-3 text-right" style="width:60mm;">
                        <p class="field">استان: <b>تهران</b></p>
                    </div>
                    <div class="col-xs-3 text-right" style="width:49mm;">
                        <p class="field">شهرستان: <b>تهران</b></p>
                    </div>
                    <div class="col-xs-3 text-right" style="width:70mm;">
                        <p class="field">
                            کد پستی:
                            <b class="digits">
                                <span>1</span>
                                <span>9</span>
                                <span>1</span>
                                <span>5</span>
                                <span>6</span>
                                <span>8</span>
                                <span>4</span>
                                <span>4</span>
                                <span>3</span>
                                <span>7</span>
                            </b>
                        </p>
                    </div>
                    <div class="col-xs-3 text-right" style="width:85mm; padding-right:8mm;">
                        <p class="field">شهر: <b>تهران</b></p>
                    </div>
                </div>
                <div class="row" style="height:9mm;">
                    <div class="col-xs-8 text-right" style="width:190mm;">
                        <p class="field">نشانی: <b>تهران-بزرگراه آفریقا، بلوار ناهید شرقی، پلاک 14، طبقه 4، واحد 13</b></p>
                    </div>
                    <div class="col-xs-4 text-right" style="width:75mm;">
                        <p class="field">شماره تلفن/ نمابر: <b>26208251-26208314</b></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row box" style="margin-top:3px;">
            <div class="col-xs-12 text-center" style="padding-top:5px;padding-bottom:5px;">
                <b style="font-size:25px;">مشخصات خریدار</b>
            </div>
        </div>
        <div class="row box" id="header" style="height:28mm; margin-top:1px;padding:5px;">
            <div class="col-xs-12">
                <div class="row" style="padding-top:1mm; height:9mm;">
                    <div class="col-xs-4 text-right" style="width:104mm; padding-left:0;">
                        <p class="field">نام شخص حقیقی/ حقوقی: <input type="text" value="@Model.Account_Users.FullName" style="width:60mm;" /></p>
                    </div>
                    <div class="col-xs-4 text-right" style="width:83mm; padding-left:0;">
                        <p class="field">
                            شماره اقتصادی:
                            <b class="digits">
                                @if (String.IsNullOrWhiteSpace(Model.Account_Users.EconomicalNumber))
                                {
                                    for (int i = 0; i < 12; i++)
                                    {
                                        <input type="text" maxlength="1" />
                                    }
                                }
                                else
                                {
                                    foreach (char c in Model.Account_Users.EconomicalNumber.ToList())
                                    {
                                        <input type="text" value="@c" maxlength="1" />
                                    }
                                }
                            </b>
                        </p>
                    </div>
                    <div class="col-xs-4 text-right" style="width:83mm; padding-left:0;">
                        <p class="field">
                            شماره ثبت/شماره ملی:
                            <b class="digits">
                                @if (String.IsNullOrWhiteSpace(Model.Account_Users.NationalNumber))
                                {
                                    for (int i = 0; i < 10; i++)
                                    {
                                        <input type="text" maxlength="1" />
                                    }
                                }
                                else
                                {
                                    foreach (char c in Model.Account_Users.NationalNumber.ToList())
                                    {
                                        <input type="text" value="@c" maxlength="1" />
                                    }
                                }
                            </b>
                        </p>
                    </div>
                </div>
                <div class="row" style="height:9mm;">
                    <div class="col-xs-3 text-right" style="width:60mm;">
                        <p class="field">استان: <input type="text" value="@((Model.Account_Users.Location_Cities != null && Model.Account_Users.Location_Cities.Location_Provinces != null) ? Model.Account_Users.Location_Cities.Location_Provinces.Name : "")" style="width:40mm;" /></p>
                    </div>
                    <div class="col-xs-3 text-right" style="width:49mm;">
                        <p class="field">شهرستان: <input type="text" value="@(Model.Account_Users.Location_Cities != null ? Model.Account_Users.Location_Cities.Name : "")" style="width:25mm;" /></p>
                    </div>
                    <div class="col-xs-3 text-right" style="width:70mm;">
                        <p class="field">
                            کد پستی:
                            <b class="digits">
                                @if (String.IsNullOrWhiteSpace(Model.Account_Users.PostalCode1))
                                {
                                    for (int i = 0; i < 10; i++)
                                    {
                                        <input type="text" maxlength="1" />
                                    }
                                }
                                else
                                {
                                    foreach (char c in Model.Account_Users.PostalCode1.ToList())
                                    {
                                        <input type="text" value="@c" maxlength="1" />
                                    }
                                }
                            </b>
                        </p>
                    </div>
                    <div class="col-xs-3 text-right" style="width:85mm; padding-right:8mm;">
                        <p class="field">شهر: <input type="text" value="" @*@(Model.Account_Users.Location_Cities != null ? Model.Account_Users.Location_Cities.Name : "")*@ style="width:65mm;" /></p>
                    </div>
                </div>
                <div class="row" style="height:9mm;">
                    <div class="col-xs-8 text-right" style="width:190mm;">
                        <p class="field">نشانی: <input type="text" value="@Model.Account_Users.Address1" style="width:170mm;" /></p>
                    </div>
                    <div class="col-xs-4 text-right" style="width:75mm;">
                        <p class="field">شماره تلفن/ نمابر: <input type="text" value="@Model.Account_Users.Phone1" style="width:40mm;" /></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row box" style="margin-top:3px;">
            <div class="col-xs-12 text-center" style="padding-top:5px;padding-bottom:5px;">
                <b style="font-size:25px;">مشخصات کالا</b>
            </div>
        </div>

        <div class="row boxRow">
            <div class="col-xs-1 text-center boxCell col1">
                <p><b>ردیف</b></p>
            </div>
            <div class="col-xs-1 text-center boxCell col2">
                <p><b>کد کالا</b></p>
            </div>
            <div class="col-xs-2 text-center boxCell col3">
                <p><b>شرح کالا</b></p>
            </div>
            <div class="col-xs-1 text-center boxCell col4">
                <p><b>تعداد</b></p>
            </div>
            <div class="col-xs-1 text-center boxCell col5">
                <p><b>واحد</b></p>
            </div>
            <div class="col-xs-1 text-center boxCell col6">
                <p><b>مبلغ واحد</b></p>
            </div>
            <div class="col-xs-1 text-center boxCell col7">
                <p><b>مبلغ کل</b></p>
            </div>
            <div class="col-xs-1 text-center boxCell col8">
                <p><b>مبلغ تخفیف</b></p>
            </div>
            <div class="col-xs-1 text-center boxCell col9">
                <p><b>مبلغ کل پس از تخفیف</b></p>
            </div>
            <div class="col-xs-1 text-center boxCell col10" style="font-size:12px;">
                <p><b>جمع مالیات عوارض</b></p>
            </div>
            <div class="col-xs-1 text-center col11" style="font-size: 11px; padding: 0; height: 8mm;">
                <p><b>جمع مبلغ کل بعلاوه جمع مالیات و عوارض</b></p>
            </div>
        </div>

        @for (int i = 0; i < Model.Sale_Goods.Count; i++)
        {
            if (!string.IsNullOrEmpty(Model.Sale_Goods.ElementAt(i).Name) || Model.Sale_Goods.ElementAt(i).Count > 0)
            {
                if (Model.Sale_Goods.ElementAt(i).Phi > 0)
                {
                    ViewBag.index++;
                    //double itemDeduction = (i == 0) ? Model.Discount : 0;
                    double itemDeduction = (ViewBag.sum == 0) ? Model.Discount : 0;
                    ViewBag.sum += (Model.Sale_Goods.ElementAt(i).Phi * Model.Sale_Goods.ElementAt(i).Count);
                    double itemTax = ((Model.Sale_Goods.ElementAt(i).Phi * Model.Sale_Goods.ElementAt(i).Count) - itemDeduction) * (Model.Tax / 100);

                    <div class="row boxRow">
                        <div class="col-xs-1 text-center boxCell col1">
                            <p> @ViewBag.index</p>
                        </div>
                        <div class="col-xs-1 text-center boxCell col2">
                            <input type="text" />
                        </div>
                        <div class="col-xs-2 text-right boxCell col3">
                            <input type="text" value="@BaseSite.Models.StringExtensions.WithMaxLength(Model.Sale_Goods.ElementAt(i).Name, 25)" />
                        </div>
                        <div class="col-xs-1 text-center boxCell col4">
                            <input class="autoNumber" type="text" value="@Model.Sale_Goods.ElementAt(i).Count" />
                        </div>
                        <div class="col-xs-1 text-center boxCell col5">
                            <input type="text" value="عدد" />
                        </div>
                        <div class="col-xs-1 text-center boxCell col6">
                            <input class="autoNumber" type="text" value="@string.Format("{0}", Model.Sale_Goods.ElementAt(i).Phi)" />
                        </div>
                        <div class="col-xs-1 text-center boxCell col7">
                            <input class="autoNumber" type="text" value="@string.Format("{0}", Model.Sale_Goods.ElementAt(i).Phi * Model.Sale_Goods.ElementAt(i).Count)" />
                        </div>
                        <div class="col-xs-1 text-center boxCell col8">
                            <input class="autoNumber" type="text" value="@string.Format("{0}", itemDeduction)" />
                        </div>
                        <div class="col-xs-1 text-center boxCell col9">
                            <input class="autoNumber" type="text" value="@string.Format("{0}", (Model.Sale_Goods.ElementAt(i).Phi * Model.Sale_Goods.ElementAt(i).Count) - itemDeduction)" />
                        </div>
                        <div class="col-xs-1 text-center boxCell col10">
                            <input class="autoNumber" type="text" value="@string.Format("{0}", itemTax)" />
                        </div>
                        <div class="col-xs-1 text-center col11">
                            <input class="autoNumber" type="text" value="@string.Format("{0}", (Model.Sale_Goods.ElementAt(i).Phi * Model.Sale_Goods.ElementAt(i).Count) - itemDeduction + itemTax)" />
                        </div>
                    </div>
                }
            }
        }


        @if (ViewBag.index < 7)
        {
            for (int i = ViewBag.index; i < 7; i++)
            {
                <div class="row boxRow">
                    <div class="col-xs-1 text-center boxCell col1">
                        <p>@(i+1)</p>
                    </div>
                    <div class="col-xs-1 text-center boxCell col2">
                        <p><input type="text" /></p>
                    </div>
                    <div class="col-xs-2 text-right boxCell col3">
                        <input type="text" />
                    </div>
                    <div class="col-xs-1 text-center boxCell col4">
                        <input class="autoNumber" type="text" />
                    </div>
                    <div class="col-xs-1 text-center boxCell col5">
                        <input type="text" />
                    </div>
                    <div class="col-xs-1 text-center boxCell col6">
                        <input class="autoNumber" type="text" />
                    </div>
                    <div class="col-xs-1 text-center boxCell col7">
                        <input class="autoNumber" type="text" />
                    </div>
                    <div class="col-xs-1 text-center boxCell col8">
                        <input class="autoNumber" type="text" />
                    </div>
                    <div class="col-xs-1 text-center boxCell col9">
                        <input class="autoNumber" type="text" />
                    </div>
                    <div class="col-xs-1 text-center boxCell col10">
                        <input class="autoNumber" type="text" />
                    </div>
                    <div class="col-xs-1 text-center col11" style="height: 8mm;">
                        <input class="autoNumber" type="text" />
                    </div>
                </div>
            }
        }

        <div class="row boxRow">
            <div class="col-xs-7 text-center boxCell" style="width:131mm;">
                <p><b>جمع کل:</b></p>
            </div>
            <div class="col-xs-1 text-center boxCell col7">
                <input class="autoNumber" type="text" value="@string.Format("{0}", ViewBag.sum)" />
            </div>
            <div class="col-xs-1 text-center boxCell col8">
                <input class="autoNumber" type="text" value="@string.Format("{0}", Model.Discount)" />
            </div>
            <div class="col-xs-1 text-center boxCell col9">
                <input class="autoNumber" type="text" value="@string.Format("{0}", ViewBag.sum - Model.Discount)" />
            </div>
            <div class="col-xs-1 text-center boxCell col10">
                <input class="autoNumber" type="text" value="@string.Format("{0}", ((ViewBag.sum - Model.Discount) * Model.Tax / 100))" />
            </div>
            <div class="col-xs-1 text-center col11" style="height: 8mm;">
                <input class="autoNumber" type="text" value="@string.Format("{0}", Model.Cost - Model.DeliveryCost)" />
            </div>
        </div>

        <div class="row boxRow">
            <div class="col-xs-4 text-center boxCell">
                <p><b>شرایط و نحوه فروش:&nbsp;&nbsp;</b>&nbsp;نقدی<input type="checkbox" style="display:inline-block;" />&nbsp;غیرنقدی<input type="checkbox" style="display:inline-block;" /></p>
            </div>
            <div class="col-xs-8 text-right" style="height: 8mm;">
                <p>توضیحات:</p>
            </div>
        </div>
        <div class="row boxRow" style="max-height:10mm;">
            <div class="col-xs-6 text-right boxCell" style="padding-right:10px;">
                <p><b>مهر و امضاء فروشنده:</b></p>
            </div>
            <div class="col-xs-6 text-right" style="height:8mm; padding-right:10px;">
                <p><b>مهر و امضاء خریدار:</b></p>
            </div>
        </div>
    </div>

    <script src="@Url.Content("~/Contents/js/autoNumeric.js")"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('.autoNumber').autoNumeric(
                'init', {
                aSep: ',',
                aSign: '',
                lZero: 'deny',
                vMin: '-999999999999999',
                vMax: '999999999999999',
                //vMin: '-999999999999999.00',
                //vMax: '999999999999999.00',
            });

            //$('body').printThis({
            //    importCSS: true,
            //    importStyle: true,
            //    printContainer: true,
            //    copyTagClasses: true,
            //    canvas: true
            //});
        });
    </script>
</body>
</html>
