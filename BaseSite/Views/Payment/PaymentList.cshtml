@using System.Globalization
@model List<BaseSite.Models.DBModel.Payment_Payment>
@{
    ViewBag.Title = "لیست اسناد دریافتی";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
    WebGrid grid = new WebGrid(null, rowsPerPage: 20);
    grid.Bind(@Model, autoSortAndPage: true, rowCount: ViewBag.RowCount);
}

@{
    Func<DateTime, string> toPersianDate = date =>
    {
        var dateTime = new DateTime(date.Year, date.Month, date.Day, new GregorianCalendar());
        var persianCalendar = new PersianCalendar();
        return persianCalendar.GetYear(dateTime) + "/" +
               persianCalendar.GetMonth(dateTime).ToString("00") + "/" +
               persianCalendar.GetDayOfMonth(dateTime).ToString("00");
    };
    var today = toPersianDate(DateTime.Now);
}

<div class="row">
    <div class="alert alert-success alert-dismissible" role="alert" style="display:none;" id="SuccessedEdit">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <strong><i class="fa fa-hand-peace-o fa-2x"></i></strong> ویرایش اطلاعات با موفقیت انجام شد .
    </div>
</div>
@*##################### Search Div #############################*@
<div class="row">
@if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Payment_Add))
{
    <div class="col-md-1 col-xs-12">
        <a class="btn btn-link" id="OrderRegisterBtn" title="ثبت سند" href="@Url.Action("AddPayment")"><i class="fa fa-calendar-plus-o fa-3x"></i></a>
    </div>
}
@if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Payment_Search))
{
    <div class="col-md-10 col-md-offset-1 col-xs-12" id="DivSearch">
        <form method="post" action="@Url.Action("SearchPayment")">
            <div class="row">
                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon">مشتری</span>
                        @Html.TextBox("Customer", (string)(ViewBag.CustomerName), new { @Class = "form-control MyControl", @Id = "Customer", @Lang = "fa-IR" })
                        <span class="input-group-addon MySpan"><a data-toggle="modal" href="#PersonInfoModal" id="personLink" name="personLink" data-userid="@((int?)ViewBag.customerId)"><i class="fa fa-user-o fa-lg text-danger" title="مشخصات"></i></a></span>
                    </div>
                    @Html.Hidden("customerId", (int?)ViewBag.customerId, new { @Class = "form-control MyControl", @Id = "CustomerId" })
                </div>
                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon">تاریخ سند از</span>
                        <input type="text" name="sanadDateFrom" class="form-control text-center text-left" dir="ltr"
                               value="@ViewBag.sanadDateFrom"
                               onclick="PersianDatePicker.Show(this,'@today');" />
                    </div>
                </div>
                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon">تا</span>
                        <input type="text" name="sanadDateTo" class="form-control text-center text-left" dir="ltr"
                               value="@ViewBag.sanadDateTo"
                               onclick="PersianDatePicker.Show(this,'@today');" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon" id="Mobile1">نحوه وصول</span>
                        <select id="paymentTypeId" name="paymentTypeId" class="form-control text-center text-left">
                            <option selected value> </option>
                            @foreach (var item in BaseSite.Models.Cache.Payment_Types)
                            {
                                if (item.Key == ViewBag.paymentTypeId)
                                {
                                    <option value="@item.Key" selected="selected">@item.Value</option>
                                }
                                else
                                {
                                    <option value="@item.Key">@item.Value</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon">تاریخ سررسید از</span>
                        <input type="text" name="sarresidDateFrom" class="form-control text-center text-left" dir="ltr"
                               value="@ViewBag.sarresidDateFrom"
                               onclick="PersianDatePicker.Show(this,'@today');" />
                    </div>
                </div>
                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon">تا</span>
                        <input type="text" class="form-control text-center text-left" dir="ltr"
                               name="sarresidDateTo"
                               value="@ViewBag.sarresidDateTo"
                               onclick="PersianDatePicker.Show(this,'@today');" />
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon">شماره سند</span>
                        <input type="text" name="docNumber" class="form-control text-center text-left" value="@ViewBag.docNumber" />
                    </div>
                </div>
                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon" id="Mobile1">بابت</span>
                        <select id="babatId" name="babatId" class="form-control text-center text-left">
                            <option selected value> </option>
                            @foreach (var item in BaseSite.Models.Cache.Payment_Babats)
                            {
                                if (item.Key == ViewBag.babatId)
                                {
                                    <option value="@item.Key" selected="selected">@item.Value</option>
                                }
                                else
                                {
                                    <option value="@item.Key">@item.Value</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon" id="Mobile1">وضعیت</span>
                        <select id="paymentStatusId" name="paymentStatusId" class="form-control text-center text-left">
                            <option selected value> </option>
                            @foreach (var item in BaseSite.Models.Cache.Payment_PaymentStatus)
                            {
                                if (item.Key == ViewBag.paymentStatusId)
                                {
                                    <option value="@item.Key" selected="selected">@item.Value</option>
                                }
                                else
                                {
                                    <option value="@item.Key">@item.Value</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                @*<div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon" id="Mobile1">برگشتی</span>
                        <select id="bargashti" name="bargashti" class="form-control text-center text-left">
                            <option selected value> </option>
                            @if (ViewBag.bargashti == 0)
                            {
                                <option value="0" selected="selected">غیر برگشتی</option>
                                <option value="1">برگشتی</option>
                            }
                            else if (ViewBag.bargashti == 1)
                            {
                                <option value="0">غیر برگشتی</option>
                                <option value="1" selected="selected">برگشتی</option>
                            }
                            else
                            {
                                <option value="0">غیر برگشتی</option>
                                <option value="1">برگشتی</option>
                            }
                        </select>
                    </div>
                </div>*@
            </div>
            <div class="row">
                <div class="col-xs-12 text-center" style="padding:3px;"> <button class="btn btn-sm btn-primary">جستجو</button> </div>
            </div>
        </form>
    </div>
}
</div>
@*########################### webgrid ##########################################*@
<div class="row DivList">
    <div id="DivDetail">
        <div style="margin-top:20px;">
            @grid.GetHtml(tableStyle: "table table-bordered table-responsive tblgrid",
            headerStyle: "tblGridHeader",
            mode: WebGridPagerModes.All,
            numericLinksCount: 20,
            firstText: " اولین ",
            previousText: " قبلی ",
            nextText: " بعدی ",
            lastText: " آخرین ",
            columns: grid.Columns(
            grid.Column(header: "ردیف",
            format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
            grid.Column("DocNumber", header: "شماره سند", format: item => item.DocNumber),
            grid.Column("Accepter.FullName", header: "ثبت کننده", format: item => item.Accepter.FullName),
            grid.Column("Account_Users.FullName", header: "مشتری", format: item => item.Account_Users.FullName),
            //grid.Column("Bargashti", header: "برگشتی", format: item => item.Bargashti ? "برگشتی" : "-"),
            grid.Column("Payment_Types.Name", header: "نحوه وصول", format: item => item.Payment_Types.Name),
            grid.Column("ShDateSanad", header: "تاریخ سند", format: item => item.ShDateSanad),
            grid.Column("ShDateSarresid", header: "تاریخ سررسید", format: item => item.ShDateSarresid),
            grid.Column("Payment_Banks.Name", header: "نام بانک", format: item => item.Payment_Banks.Name),
            grid.Column("Payment_Babats.Name", header: "بابت", format: item => item.Payment_Babats.Name),
            grid.Column("Amount", header: "مبلغ", format: @<span class="autoNumber">@item.Amount</span>),
            grid.Column("Payment_Status.Name", header: "وضعیت", format: item => item.Payment_Status.Name),
            grid.Column(header: "جزئیات",
                format: @<text>
                @if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Payment_Detail))
                {
                    <a data-value="@item.Id" href="@Url.Action("PaymentDetail", new { paymentId = item.Id })"><i class="fa fa-list fa-lg" title="جزئیات"></i></a>
                }
                else
                {
                    <a data-value="@item.Id" href="#"><i class="fa fa-list fa-lg text-danger" title="جزئیات"></i></a>
                }
                </text>)
            ))
        </div>
    </div>
</div>

