@model BaseSite.Models.DBModel.Order_Process
@using System.Globalization
@{
    ViewBag.Title = "پروژه های تولید";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
}
@{
    Func<DateTime, string> toPersianDate = date =>
    {
        var dateTime = new DateTime(date.Year, date.Month, date.Day, new GregorianCalendar());
        var persianCalendar = new PersianCalendar();
        return persianCalendar.GetYear(dateTime) + "/" +
               persianCalendar.GetMonth(dateTime).ToString("00") + "/" +
               persianCalendar.GetDayOfMonth(dateTime).ToString("00");
    };
    var today = toPersianDate(DateTime.Now);
    //var name = this.ViewContext.ViewData.ModelMetadata.PropertyName;
    //var value = Model.HasValue ? toPersianDate(Model.Value) : string.Empty;

    Dictionary<int, string> items = new Dictionary<int, string>();
    items.Add(3, "پنل داخل کابین");
    items.Add(7, "پنل طبقات");
    items.Add(10, "پنل سردرب");
    items.Add(1, "سایر");
}

<div class="row">
    @using (Html.BeginForm("Project", "Process", FormMethod.Post))
    {
        <div class="panel-group">

            @*#################################### TopPart ####################################*@
            <div class="panel panel-success">
                <div class="panel-heading MyHeader">ثبت ضریب پروژه</div>
                <div class="panel-body TopPart">
                    <input type="hidden" value="@Model.Id" name="Id" />
                    <div class="row">
                        <div class="text-warning text-center" style="margin-bottom:15px;"><em id="Message">@ViewBag.Message</em></div>
                        <div class="col-md-4 col-md-offset-2 col-sm-6 col-xs-12">
                            <div class="col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                                <div class="input-group">
                                    <span class="input-group-addon MySpan">تاریخ </span>
                                    <input type="text" id="ShTime" name="ShTime" class="form-control text-center MyControl" value="@Model.ShTime"
                                           @*onclick="PersianDatePicker.Show(this,'@today');"*@ readonly="readonly" />
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                                <div class="input-group">
                                    <span class="input-group-addon MySpan">اپراتور</span>
                                    @Html.DropDownListFor(m => m.UserId, (ViewBag.Operators as Dictionary<int, string>).Select(x => new SelectListItem() { Value = x.Key.ToString(), Text = x.Value, Selected = (x.Key == Model.UserId) }), new { @Class = "form-control MyControl", @Id = "UserId", aria_describedby = "اپراتور", onchange = "clearMessage(this)" })
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                                <div class="input-group">
                                    <span class="input-group-addon MySpan">مرحله</span>
                                    @Html.DropDownListFor(m => m.ProductStatusId, BaseSite.Models.Cache.Order_ProductStatus.Select(x => new SelectListItem() { Value = x.Key.ToString(), Text = x.Value, Selected = (x.Key == Model.ProductStatusId) }), new { @Class = "form-control MyControl", @Id = "ProductStatusId", onchange = "clearMessage(this)" })
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                                <div class="input-group">
                                    <span class="input-group-addon MySpan">آیتم</span>
                                    @Html.DropDownListFor(m => m.ProductTableId, items.Select(x => new SelectListItem() { Value = x.Key.ToString(), Text = x.Value, Selected = (x.Key == Model.ProductTableId) }), new { @Class = "form-control MyControl", @Id = "ProductTableId", onchange = "clearMessage(this)" })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6 col-xs-12">
                            <div class="col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                                <div class="input-group">
                                    <span class="input-group-addon MySpan">شرح</span>
                                    <textarea class="form-control MyControl focus" name="Description" style="padding:5px; resize:vertical;" onchange="clearMessage(this)">@Model.Description</textarea>
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                                <div class="input-group">
                                    <span class="input-group-addon MySpan">ضریب واحد</span>
                                    @Html.TextBoxFor(m => m.ProductFactor, new { @Class = "form-control text-center MyControl", @Id = "ProductFactor", onchange = "clearMessage(this)" })
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                                <div class="input-group">
                                    <span class="input-group-addon MySpan">تعداد</span>
                                    @Html.TextBoxFor(m => m.Count, new { @Class = "form-control text-center MyControl", @Id = "Count", onchange = "clearMessage(this)" })
                                </div>
                            </div>
                            <div class="col-md-12 col-sm-12 col-xs-12" style="margin-top:10px;">
                                <div class="input-group">
                                    <span class="input-group-addon MySpan">درصد</span>
                                    <input type="number" class="form-control text-center MyControl" name="Percent" id="Percent" onchange="clearMessage(this)" min="0" max="100" value="@Model.Percent" />
                                    @*@Html.TextBoxFor(m => m.Percent, new { @Class = "form-control text-center MyControl", @Id = "Percent", onchange = "clearMessage(this)" })*@
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row" style="text-align:center;margin-bottom:10px; margin-top:20px;"><button type="submit" class="btn btn-success" name="submit" value="submit">ثبت</button></div>
                </div>
            </div>
        </div>
    }
</div>

<script>
    $(function () {
        $('.focus').select();
    });

    function clearMessage(element) {
        document.getElementById("Message").innerText = "";
    }
</script>

