                            <div class="boxBottom text-center" style="display: table-cell;">
                                <p></p>
                            </div>
                            <div class="boxBottom text-center" style="display: table-cell;">
                                <p></p>
                            </div>
                            <div class="boxBottom text-center" style="display: table-cell;">
                                <p></p>
                            </div>
                        </div>

                        for (int i = 0; i < Model.Order_Cabin.Count; i++)
