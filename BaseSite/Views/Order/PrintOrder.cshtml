                        </div><br />
                        <div class="row">
                            @if (Model.StatusId > (byte)BaseSite.Models.OrderStatus.PishFactor)
                            {
                                <div class="col-xs-6">موعد تحویل: @(Model.DateDelivery.HasValue ? new PersianDateTime(Model.DateDelivery.Value.AddDays(10)).ToString(PersianDateTimeFormat.Date) : new PersianDateTime(DateTime.Now.AddDays(10)).ToString(PersianDateTimeFormat.Date))</div>
                            }
                            @*<div class="col-xs-6">تاریخ چاپ: @(new PersianDateTime(DateTime.Now).ToString(PersianDateTimeFormat.Date))</div>*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#divPrint').printThis({
                importCSS: true,
                importStyle: true,
                printContainer: true,
                copyTagClasses: true,
                canvas: true
            });
        });
    </script>

</body>
