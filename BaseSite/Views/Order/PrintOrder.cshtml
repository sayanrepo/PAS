<body>
    <div class="container-fluid" id="divPrint">
        <div class="row box" id="header">
            <div class="col-xs-3 text-right">
                <p><b>شماره سند: </b><b>@Model.DocNumber</b></p>
            </div>
            <div class="col-xs-6 text-center" style="font-size:large;">
                <u><b>@ViewBag.title</b></u>
            </div>
            <div class="col-xs-3 text-left">
                <p><b>تاریخ: </b>@(Model.StatusId < (byte)BaseSite.Models.OrderStatus.MojavezKhorooj ? new PersianDateTime(DateTime.Now).ToString(PersianDateTimeFormat.Date) : Model.ShDateFactor)</p>
            </div>
            <div class="col-xs-4 text-right">
                <p><b>جهت پروژه: </b>@Model.ProjectName</p>
            </div>
            <div class="col-xs-3 text-center">
                <p><b>مشتری: </b>@Model.Account_Users.FullName</p>
            </div>
            <div class="col-xs-5 text-left">
                <p><b>نوع تابلو: </b>@Model.Tb_ElevatorBoards.Name</p>
            </div>
            <div class="col-xs-11 text-right">
                <p><b>نوع بسته بندی: </b>@Model.Tb_PackTypes.Name</p>
            </div>
            <div class="col-xs-1 text-left">
                <p>@Model.FactorNumber</p>
            </div>
            @*<div class="col-xs-6 text-left">
            <p><b>زمان چاپ: </b>@(new PersianDateTime(DateTime.Now).ToString(PersianDateTimeFormat.DateShortTime))</p>
            </div>*@
            <div class="col-xs-12 text-right">
                <p><b>محل ارسال: </b>@Model.DeliveryAddress</p>
            </div>
        </div>

        @if (Model.Order_Cabin.Count > 0 && Model.Order_Cabin.ElementAt(0).Tb_CabinPanels.Id > 0)
        {
            for (int i = 0; i < Model.Order_Cabin.Count; i++)
            {
                if (Model.Order_Cabin.ElementAt(i).Tb_CabinPanels.Id > 0)
                {
                    if (Model.Order_Cabin.ElementAt(i).MonitorId > 0)
                    {
                        Model.Order_Cabin.ElementAt(i).Cost -= (Model.Order_Cabin.ElementAt(i).CostMonitor * Model.Order_Cabin.ElementAt(i).Count);
                    }
                    for (int j = 0; j < Model.Order_Cabin.ElementAt(i).Order_Panel_Attachment.Count; j++)
                    {
                        if (Model.Order_Cabin.ElementAt(i).Order_Panel_Attachment.ElementAt(j).Tb_Attachments.Id > 0)
                        {
                            ViewBag.attachments++;
                            Model.Order_Cabin.ElementAt(i).Cost -= Model.Order_Cabin.ElementAt(i).Order_Panel_Attachment.ElementAt(j).Cost;
                        }
                    }
                    for (int j = 0; j < Model.Order_Cabin.ElementAt(i).Order_Panel_Addition.Count; j++)
