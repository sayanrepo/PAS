                                                <div class="boxThin text-center" style="display: table-cell;">
                                                    <p> @string.Format("{0:n0}", Model.Order_Hall.ElementAt(i).Order_Panel_Addition.ElementAt(j).Cost)</p>
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                            }
                            @for (int i = 0; i < Model.Order_DoorTop.Count; i++)
