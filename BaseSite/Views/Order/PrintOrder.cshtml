                    @for (int i = 0; i < Model.Order_Cabin.Count; i++)
                    {
                        if (Model.Order_Cabin.ElementAt(i).Tb_CabinPanels.Id > 0)
                        {
                            ViewBag.index++;
                            ViewBag.sum += Model.Order_Cabin.ElementAt(i).Cost;

                            <div style="display: table-row">
                                <div class="boxBottom text-center" style="display: table-cell;">
                                    <p> @ViewBag.index</p>
                                </div>
                                <div class="boxBottom text-right" style="display: table-cell;">
                                    <p> @("پنل داخل کابین: " + Model.Order_Cabin.ElementAt(i).Tb_CabinPanels.Name)</p>
                                </div>
                                <div class="boxBottom text-center" style="display: table-cell;">
                                    <p> @Model.Order_Cabin.ElementAt(i).Count</p>
                                </div>
                                <div class="boxBottom text-center" style="display: table-cell;">
                                    <p> @(Model.Order_Cabin.ElementAt(i).Count == 0 ? "0" : string.Format("{0:n0}", (Model.Order_Cabin.ElementAt(i).Cost / Model.Order_Cabin.ElementAt(i).Count)))</p>
                                </div>
                                <div class="boxBottom text-center" style="display: table-cell;">
                                    <p> @string.Format("{0:n0}", Model.Order_Cabin.ElementAt(i).Cost)</p>
                                </div>
                            </div>
                        }
