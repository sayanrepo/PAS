                                                <p> @Model.Order_Hall.ElementAt(i).Order_Panel_Attachment.ElementAt(j).Count</p>
                                            </div>
                                            <div class="boxBottom text-center" style="display: table-cell;">
                                                <p> @(Model.Order_Hall.ElementAt(i).Order_Panel_Attachment.ElementAt(j).Count == 0 ? "0" : string.Format("{0:n0}", (Model.Order_Hall.ElementAt(i).Order_Panel_Attachment.ElementAt(j).Cost / Model.Order_Hall.ElementAt(i).Order_Panel_Attachment.ElementAt(j).Count)))</p>
                                            </div>
                                            <div class="boxBottom text-center" style="display: table-cell;">
                                                <p> @string.Format("{0:n0}", Model.Order_Hall.ElementAt(i).Order_Panel_Attachment.ElementAt(j).Cost)</p>
                                            </div>
                                        </div>
                                    }
                                }
                            }
                        }
                        for (int i = 0; i < Model.Order_DoorTop.Count; i++)
                        {
                            if (Model.Order_DoorTop.ElementAt(i).Tb_DoorTopPanels.Id > 0)
