                            @for (int i = 0; i < Model.Order_Cabin.Count; i++)
                            {
                                if (Model.Order_Cabin.ElementAt(i).Tb_CabinPanels.Id > 0)
                                {
                                    for (int j = 0; j < Model.Order_Cabin.ElementAt(i).Order_Panel_Addition.Count; j++)
                                    {
                                        if (Model.Order_Cabin.ElementAt(i).Order_Panel_Addition.ElementAt(j).Tb_Additions.Id > 0)
                                        {
                                            <div style="display: table-row">
                                                <div class="boxThin text-center" style="display: table-cell;">
                                                    <p> @Model.Order_Cabin.ElementAt(i).Order_Panel_Addition.ElementAt(j).Tb_Additions.Name</p>
                                                </div>
                                                <div class="boxThin text-center" style="display: table-cell;">
                                                    <p> @string.Format("{0:n0}", Model.Order_Cabin.ElementAt(i).Order_Panel_Addition.ElementAt(j).Cost)</p>
                                                </div>
                                            </div>
                                        }
