@{
    Layout = null;
    ViewBag.title = Model.StatusId > (byte)BaseSite.Models.OrderStatus.PishFactor ? " " : "برآورد هزینه";
    ViewBag.sum = 0;
    ViewBag.index = 0;
    ViewBag.attachments = 0;
    ViewBag.additions = 0;
}
@model BaseSite.Models.DBModel.Order_Order

<!DOCTYPE html>

<link href="@Url.Content("~/Contents/css/bootstrap.css")" rel="stylesheet">
<link href="@Url.Content("~/Contents/css/bootstrap-rtl.css")" rel="stylesheet">
