                            <div class="boxBottom text-left" style="display: table-cell;">
                                <p><b>جمع: </b></p>
                            </div>
                            <div class="boxBottom text-center" style="display: table-cell;">
                                <p>@string.Format("{0:n0}", ViewBag.sum)</p>
                            </div>
                            <div class="boxBottom text-right" style="display: table-cell;">
                                <p>ریال</p>
                            </div>
                        </div>
                        <div style="display: table-row">
                            <div class="boxBottom text-left" style="display: table-cell;">
                                <p><b>تخفیف: </b></p>
                            </div>
                            <div class="boxBottom text-center" style="display: table-cell;">
                                <p>@string.Format("{0:n0}", Model.SumCostDeduction += ((ViewBag.sum - Model.SumCostDeduction + Model.SumCostAddition) * (Model.DiscountRate / 100)))</p>
                            </div>
                            <div class="boxBottom text-right" style="display: table-cell;">
                                <p>ریال</p>
                            </div>
                        </div>
                        <div style="display: table-row">
                            <div class="boxBottom text-left" style="display: table-cell;">
                                <p><b>اضافات: </b></p>
                            </div>
                            <div class="boxBottom text-center" style="display: table-cell;">
                                <p>@string.Format("{0:n0}", Model.SumCostAddition)</p>
                            </div>
                            <div class="boxBottom text-right" style="display: table-cell;">
                                <p>ریال</p>
                            </div>
                        </div>
                        <div style="display: table-row">
                            <div class="boxBottom text-left" style="display: table-cell;">
                                <p><b>@Model.Tax درصد ارزش افزوده: </b></p>
                            </div>
                            <div class="boxBottom text-center" style="display: table-cell;">
                                <p>@string.Format("{0:n0}", ((ViewBag.sum - Model.SumCostDeduction + Model.SumCostAddition) * (Model.Tax / 100)))</p>
                            </div>
                            <div class="boxBottom text-right" style="display: table-cell;">
                                <p>ریال</p>
                            </div>
                        </div>
                        <div style="display: table-row">
                            <div class="boxBottom text-left" style="display: table-cell;">
                                <p><b>هزینه حمل: </b></p>
                            </div>
                            <div class="boxBottom text-center" style="display: table-cell;">
                                <p>@string.Format("{0:n0}", Model.DeliveryCost)</p>
                            </div>
                            <div class="boxBottom text-right" style="display: table-cell;">
                                <p>ریال</p>
                            </div>
                        </div>
