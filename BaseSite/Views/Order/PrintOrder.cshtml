                                    for (int j = 0; j < Model.Order_Hall.ElementAt(i).Order_Panel_Addition.Count; j++)
                                    {
                                        if (Model.Order_Hall.ElementAt(i).Order_Panel_Addition.ElementAt(j).Tb_Additions.Id > 0)
                                        {
