        function fnAddAttachment(panel, index) {
            var count = $("#" + panel + "AttachmentAddBtn" + index).data("count");
            $("#" + panel + "Attachment" + index).append("<input type='hidden' value='0' name='Order_" + panel + "[" + index + "].Order_Panel_Attachment[" + count + "].Id' />"
                                                    + "<div class='row'>"
                                                    + "<div class='col-md-5 col-sm-5 col-xs-5' style='padding:0;'>"
                                                    + "<select class='form-control MyControl' id='AttachmentId' name='Order_" + panel + "[" + index + "].Order_Panel_Attachment[" + count + "].AttachmentId' >"
                                                    + "@Html.Raw(tempAttachments)"
                                                    + "</select>"
                                                    + "</div>"
                                                    + "<div class='col-md-3 col-sm-3 col-xs-3' style='padding:0;'>"
                                                    + "<input class='form-control text-center MyControl' id='AttachmentCount' name='Order_" + panel + "[" + index + "].Order_Panel_Attachment[" + count + "].Count' value='0' type='text'>"
                                                    + "</div>"
                                                    + "<div class='col-md-4 col-sm-4 col-xs-4' style='padding:0;'>"
                                                    + "<input class='form-control text-center MyControl autoNumber' id='AttachmentCost' name='Order_" + panel + "[" + index + "].Order_Panel_Attachment[" + count + "].Cost' value='0' type='text' disabled = 'disabled'>"
                                                    + "</div>"
                                                    + "</div>");
            $("#" + panel + "AttachmentAddBtn" + index).data("count", count + 1);
        }

