    function NestedComment(ParentID) {
        $.ajax({
            url: "@Url.Action("InsertComment", "Crm")",
            data:
                {
                    ParentID: ParentID,
                    ttid : @((short)BaseSite.Models.DB_Table.Order_Order),
                    tid : @Model.Id
                    },
            type: "Get"
        }).done(function (result) {
            $('#Comment_' + ParentID).append(result);
        });
    }


    $('#submitcomment').click(function () {
        $.ajax({
            url: "@Url.Action("InsertComment", "Crm")",
            data:
                {
                    ParentID: $(this).data("parentId"),
                    ttid : $(this).data("ttid"),
                    tid : $(this).data("tid"),
                    Comment: $("#myComment").val()
                    },
            type: "POST",
            dataType: "html",
            success: function (data) {
                //var result = $('<div />').append(data).find('#showresults').html();
                $('#CommentList').append(data);
                alert("یادداشت با موفقیت ثبت شد.");
                $("#myComment").val("");
            },
            error: function (xhr, status) {
                alert("ثبت نظر با مشکل مواجه شد!");
            },
            complete: function (xhr, status) {
                //$('#showresults').slideDown('slow')
            }
        });
    });
