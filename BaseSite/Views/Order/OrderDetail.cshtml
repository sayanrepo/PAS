@model BaseSite.Models.DBModel.Order_Order
@using System.Globalization
@{
    ViewBag.Title = "ثبت سفارش";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
    List<BaseSite.Models.DBModel.CRM_Comments> comments = BaseSite.Models.CRM.CommentManager.CRM_Comments_Get((short)BaseSite.Models.DB_Table.Order_Order, Model.Id);
    List<BaseSite.Models.DBModel.Log_Logs> logList = BaseSite.Models.Log.LogManager.Log_Logs_Search(Model.DocNumber,(int) BaseSite.Models.DB_Table.Order_Order, null, null, null);
}
@{
    Func<DateTime, string> toPersianDate = date =>
    {
        var dateTime = new DateTime(date.Year, date.Month, date.Day, new GregorianCalendar());
        var persianCalendar = new PersianCalendar();
        return persianCalendar.GetYear(dateTime) + "/" +
               persianCalendar.GetMonth(dateTime).ToString("00") + "/" +
               persianCalendar.GetDayOfMonth(dateTime).ToString("00");
    };
    var today = toPersianDate(DateTime.Now);

    var tempAttachments = "";
    var tempAdditions = "";
    var tempDeductions = "";
    for (int k = 0; k < BaseSite.Models.Cache.Order_Attachments.Count; k++)
    {
        tempAttachments += ("<option " + (k > 0 ? "" : "selected='selected'") + " value='" + BaseSite.Models.Cache.Order_Attachments.ElementAt(k).Key + "'" + " title='" + string.Format("{0:n0}", BaseSite.Models.Cache.Order_Attachments.ElementAt(k).Value.Cost) + "'>" + BaseSite.Models.Cache.Order_Attachments.ElementAt(k).Value.Name + "</option>");
    }
    for (int k = 0; k < BaseSite.Models.Cache.Order_Additions.Count; k++)
    {
        tempAdditions += ("<option " + (k > 0 ? "" : "selected='selected'") + " value='" + BaseSite.Models.Cache.Order_Additions.ElementAt(k).Key + "'>" + BaseSite.Models.Cache.Order_Additions.ElementAt(k).Value + "</option>");
    }
    for (int k = 0; k < BaseSite.Models.Cache.Order_Deductions.Count; k++)
    {
        tempDeductions += ("<option " + (k > 0 ? "" : "selected='selected'") + " value='" + BaseSite.Models.Cache.Order_Deductions.ElementAt(k).Key + "'>" + BaseSite.Models.Cache.Order_Deductions.ElementAt(k).Value + "</option>");
    }
}

<div class="row">
    <!-- Nav tabs -->
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" class="active"><a href="#home" aria-controls="home" role="tab" data-toggle="tab">سفارش</a></li>
        @if (Model.Id > 0)
        {
            <li role="presentation">
                <a href="#comments" aria-controls="comments" role="tab" data-toggle="tab">
                    یادداشت ها
                    @if (comments.Count > 0)
                    {<span class="badge badge-count">@comments.Count</span>}
                </a>
            </li>
            <li role="presentation">
                <a href="#history" aria-controls="history" role="tab" data-toggle="tab">
                    تاریخچه فعالیتها
                </a>
            </li>
        }
    </ul>

    <!-- Tab panes -->
