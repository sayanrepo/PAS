<script src="@Url.Content("~/Contents/js/autoNumeric.js")"></script>

<script type="text/javascript">

    $(document).ready(function () {
        $("#Customer").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "@Url.Action("AutoCompleteUsers","Order")",
                    type: "POST",
                    dataType: "json",
                    data: { Prefix: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.Name, value: item.Name, id: item.Id };
                        }))
                    }
                })
            },
            select: function (event, ui) {
                $("#CustomerId").val(ui.item.id);
                $("#personLink").data("userid", ui.item.id);
            },
            minLength: 1
        });

        $("#Employee").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "@Url.Action("AutoCompleteEmployees", "Order")",
                    type: "POST",
                    dataType: "json",
                    data: { Prefix: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return { label: item.Name, value: item.Name, id: item.Id };
                        }))
                    }
                })
            },
            select: function (event, ui) {
                $("#EmployeeId").val(ui.item.id);
                //$("#personLink").data("userid", ui.item.id);
            },
            minLength: 1
        });
    })

    $(function () {
        $('.autoNumber').autoNumeric(
             'init', {
                 aSep: ',',
                 aSign: '',
                 lZero: 'deny',
                 vMin: '-999999999999999',
                 vMax: '999999999999999',
                 //vMin: '-999999999999999.00',
                 //vMax: '999999999999999.00',
             });
    });
    $(function () {
        $('.autoIntNumber').autoNumeric(
             'init', {
                 aSep: ',',
                 aSign: '',
                 vMin: '00',
                 vMax: '999999999999999',
             });
    });
    $(function () {
        $('.autoPercent').autoNumeric(
             'init', {
                 aSign: '',
                 vMin: '00.00',
                 vMax: '100.00',
             });
    });
    $(function () {
        $('.autoInt').autoNumeric(
             'init', {
                 aSign: '',
                 vMin: '00',
                 vMax: '1000',
             });
    });
    $(function () {
        $('.autoYear').autoNumeric(
             'init', {
                 aSign: '',
                 dGroup: '4',
                 vMin: '0000',
                 vMax: '2000',

             });
    });

    $('form').submit(function () {
        var form = $(this);
        $('input').each(function (i) {
            var self = $(this);
            try {
                var v = self.autoNumeric('get');
                self.autoNumeric('destroy');
                self.val(v);
            } catch (err) {
                console.log("Not an autonumeric field: " + self.attr("name"));
            }
        });
        return true;
    });

    function addCommas(x) {
        var parts = x.toString().split(".");
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ",");
        return parts.join(".");
    }

    function fnPrint(element) {
        $("#divPrint").printThis();
    }


    $('#PersonInfoModal').on('show.bs.modal', function (event) {
        var clickedLink = $(event.relatedTarget); // Button that triggered the modal
        var vuserId = clickedLink.data("userid"); // Extract info from data-* attributes

        var modal = $(this);
        //modal.find('.modal-title').text('جزئیات کارکرد (' + vuserFullName + ')');

        $.ajax({
            url: "@Url.Action("GetPersonInfo", "Order")",
            type: "GET",
        dataType: "json",
        data: { userId: vuserId},
        success: function (data) {
                contentHtml = "<div style='display: table-row'>" +
                                "<div class='box text-right' style='display: table-cell;'><p><b>نام: </b></p></div>" +
                                "<div class='box text-right' style='display: table-cell;'><p><b>" + data.FullName + "</b></p></div>" +
                                "</div>" +                                
                                "<div style='display: table-row'>" +
                                "<div class='box text-right' style='display: table-cell;'><p><b>شماره تماس: </b></p></div>" +
                                "<div class='box text-right' style='display: table-cell;'><p><b>" + data.Phone1 + "</b></p></div>" +
                                "</div>" +
                                "<div style='display: table-row'>" +
                                "<div class='box text-right' style='display: table-cell;'><p><b>فکس: </b></p></div>" +
                                "<div class='box text-right' style='display: table-cell;'><p><b>" + data.Fax + "</b></p></div>" +
                                "</div>" +
                                "<div style='display: table-row'>" +
                                "<div class='box text-right' style='display: table-cell;'><p><b>مدیرعامل: </b></p></div>" +
                                "<div class='box text-right' style='display: table-cell;'><p><b>" + data.Responsible1 + "&nbsp;&nbsp;(" + data.ResponsiblePhone1 + ")</b></p></div>" +
                                "</div>" +
                                "<div style='display: table-row'>" +
                                "<div class='box text-right' style='display: table-cell;'><p><b>آدرس محل سکونت /دفتر مرکزی: </b></p></div>" +
                                "<div class='box text-right' style='display: table-cell;'><p><b>" + data.Address1 + "</b></p></div>" +
                                "</div>" +
                                "<div style='display: table-row'>" +
                                "<div class='box text-right' style='display: table-cell;'><p><b>آدرس محل کار /کارخانه: </b></p></div>" +
                                "<div class='box text-right' style='display: table-cell;'><p><b>" + data.Address2 + "</b></p></div>" +
                                "</div>";
                $('#PersonTable').html(contentHtml);
        }
    })
    })
       
</script>
