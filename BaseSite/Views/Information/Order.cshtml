@{
    ViewBag.Title = "سفارشات";
    Layout = "~/Views/Shared/LayoutBase.cshtml";
}

<div class="row">
    <div id="DivDetail">
        <div class="col-xs-4 col-md-offset-2 col-xs-offset-2" id="DivBoxing">
            <p class="TopText">نوع بسته بندی</p>
            <div class="row col-xs-12 nopadding">
                <form method="post" action="@Url.Action("AddPack", "Information")" id="formAddPack" class="formAdd">
                    <div class="col-xs-8">
                        <input type="text" class="form-control alert-dismissible" id="PackName" name="PackName" placeholder="نام بسته بندی">
                    </div>
                    <div class="col-xs-4">
                        <button class="btn btn-warning AddBtn" type="submit">افزودن</button>
                    </div>
                </form>
            </div>
            <div class="col-xs-12 DivBox">
                <table class="table table-responsive table-condensed" id="tblPack">
                    @if (ViewBag.Pack != null)
                    {
                        foreach (var item in ViewBag.Pack)
                        {
                            <tr>
                                <td id="@string.Format("Pack{0}", item.Id)" class="PackName">@item.Name</td>
                                <td>
                                    <a data-toggle="modal" href="#PackEditeModal" id="@string.Format("PackEdite{0}", item.Id)">ویرایش</a>
                                </td>
                                <td>
                                    <a data-toggle="modal" href="#PackDeleteModal" id="@string.Format("PackDel{0}", item.Id)">حذف</a>
                                </td>
                                <td style="display:none;">@item.Id</td>
                            </tr>
                        }
                    }

                </table>
            </div>
        </div>

        <div class="col-xs-4 col-xs-offset-2" id="DivPanel">
            <p class="TopText">نوع تابلو</p>
            <div class="row col-xs-12 nopadding">
                <form method="post" action="@Url.Action("AddElevatorBoard", "Information")" id="formAddElevatorBoard" class="formAdd">
                    <div class="col-xs-8">
                        <input type="text" class="form-control alert-dismissible" id="ElevatorBoardName" name="ElevatorBoardName" placeholder="نام تابلو">
                    </div>
                    <div class="col-xs-4">
                        <button class="btn btn-warning AddBtn" type="submit">افزودن</button>
                    </div>
                </form>
            </div>
            <div class="col-xs-12 DivBox">
                <table class="table table-responsive table-condensed" id="tblElevatorBoard">
                    @if (ViewBag.ElevatorBoard != null)
                    {
                        foreach (var item in ViewBag.ElevatorBoard)
                        {
                            <tr>
                                <td id="@string.Format("ElevatorBoard{0}", item.Id)" class="ElevatorBoardName">@item.Name</td>
                                <td>
                                    <a data-toggle="modal" href="#ElevatorBoardEditModal" id="@string.Format("ElevatorBoardEdit{0}", item.Id)">ویرایش</a>
                                </td>
                                <td>
                                    <a data-toggle="modal" href="#ElevatorBoardDeleteModal" id="@string.Format("ElevatorBoardDel{0}", item.Id)">حذف</a>
                                </td>
                                <td style="display:none;">@item.Id</td>
                            </tr>
                        }
                    }
                </table>
            </div>
        </div>

    </div>
</div>

<div class="row" style="margin-top:13px;">
    <div id="DivDetail">
        <div class="col-xs-4 col-md-offset-2 col-xs-offset-2" id="DivDeduction">
            <p class="TopText">کسورات</p>
            <div class="row col-xs-12 nopadding">
                <form method="post" action="@Url.Action("AddDeduction", "Information")" id="formAddDeduction" class="formAdd">
                    <div class="col-xs-8">
                        @*<input type="text" style="display:none;" id="DeductionId" name="DeductionId" value="@ViewBag.ID">*@
                        <input type="text" class="form-control alert-dismissible" id="DeductionName" name="DeductionName" placeholder="نام کسورات">
                    </div>
                    <div class="col-xs-4">
                        <button class="btn btn-warning AddBtn" type="submit">افزودن</button>
                    </div>
                </form>
            </div>
            <div class="col-xs-12 DivBox">
                <table class="table table-responsive table-condensed" id="tblDeduction">
                    @if (ViewBag.Deduction != null)
                    {
                        foreach (var item in ViewBag.Deduction)
                        {
                            <tr>
                                <td id="@string.Format("Deduction{0}", item.Id)" class="DeductionName"> @item.Name </td>
                                <td>
                                    <a data-toggle="modal" href="#DeductionEditModal" id="@string.Format("DeductionEdit{0}", item.Id)">ویرایش</a>
                                </td>
                                <td>
                                    <a data-toggle="modal" href="#DeductionDeleteModal" id="@string.Format("DeductionDel{0}", item.Id)">حذف</a>
                                </td>
                                <td style="display:none;">@item.Id</td>
                            </tr>
                        }
                    }
                </table>
            </div>
        </div>

        <div class="col-xs-4 col-xs-offset-2" id="DivAddition">
            <p class="TopText">اضافات</p>
            <div class="row col-xs-12 nopadding">
                <form method="post" action="@Url.Action("AddAddition", "Information")" id="formAddAddition" class="formAdd">
                    <div class="col-xs-8">
                        @*<input type="text" style="display:none;" id="AdditionName" name="AdditionName" value="@ViewBag.Name">*@
                        <input type="text" class="form-control alert-dismissible" id="AdditionName" name="AdditionName" placeholder="نام اضافات">
                    </div>
                    <div class="col-xs-4">
                        <button class="btn btn-warning AddBtn" type="submit">افزودن</button>
                    </div>
                </form>
            </div>
            <div class="col-xs-12 DivBox">
                <table class="table table-responsive table-condensed" id="tblAddition">
                    @if (ViewBag.Addition != null)
                    {
                        foreach (var item in ViewBag.Addition)
                        {
                            <tr>
                                <td id="@string.Format("Addition{0}", item.Id)"><a class="AdditionName" href="#">@item.Name</a></td>
                                <td>
                                    <a data-toggle="modal" href="#AdditionEditModal" id="@string.Format("AdditionEdit{0}", item.Id)">ویرایش</a>
                                </td>
                                <td>
                                    <a data-toggle="modal" href="#AdditionDeleteModal" id="@string.Format("AdditionDel{0}", item.Id)">حذف</a>
                                </td>
                                <td style="display:none;">@item.Id</td>
                            </tr>
                        }
                    }
                </table>
            </div>
        </div>
    </div>
</div>

