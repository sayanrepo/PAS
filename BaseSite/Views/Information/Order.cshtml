@*########################################## JAVA SCRIPT PART #############################################*@
@*$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$*@
<script type="text/javascript">
    $(document).ready(function () {
        //$("Li#PrimaryInfo").css("background-color", "#524d4d");
        $("Li#PrimaryInfo a").css("color", "#fff");
        $("Li#PrimaryInfo a").css("background-color", "transparent");
        $("Li#PrimaryInfo a").css("font-size", "12px");
        $("Li#PrimaryInfo a").css("font-weight", "bolder");
        var CountryID = '@ViewBag.CountryID';
        var ProvinceID = '@ViewBag.ProvinceID';

        //$("table#tblCountry tr td#Country" + CountryID).css('background-color', 'rgba(189, 182, 182, 0.78)');
        //$("table#tblProvince tr td#Province" + ProvinceID).css('background-color', 'rgba(189, 182, 182, 0.78)');

        //تغییر رنگ بکگراند شهرها و اشخاص
        var PageHref = window.location.href;
        var PageHrefSplits = PageHref.split('/');
        var LinkHref = PageHrefSplits[5];
        if (LinkHref == "Index" || LinkHref == null || LinkHref == "") {
            $("a[ID='Order']").css("background-color", "rgba(0, 0, 0, 0.19)");
        }
        //////////// PACK ////////
        $("a[id^='PackDel']").click(function () {
            var id = $(this).closest("tr").find("td:eq(3)").text();
            $('#PackDeleteModal #PackId').val(id);
        });
        $("a[ID^='PackEdite']").click(function () {
            var id = $(this).closest("tr").find("td:eq(3)").text();
            var name = $(this).closest("tr").find("td:eq(0)").text();
            $('#PackEditeModal #PackId').val(id);
            $('#PackEditeModal #PackName').val(name);
        });

        $("#formAddPack").submit(function (e) {
            var Pack = $("#PackName").val();
            if (Pack == "" || Pack == null) {
                $("#formAddPack #PackName").css("background-color", "#eb6a6a");
                return false;
                e.preventDefault();
            }
        });
        $("#PackName").click(function () {
            $("#formAddPack #PackName").css("background-color", "white");
        });


        ////////// ElevatorBoard //////////////
        $("#formAddElevatorBoard").submit(function (e) {
            var Elevator = $("#ElevatorBoardName").val();
            if (Elevator == "" || Elevator == null) {
                $("#formAddElevatorBoard #ElevatorBoardName").css("background-color", "#eb6a6a");
                return false;
                e.preventDefault();
            }
        });
        $("#ElevatorBoardName").click(function () {
            $("#formAddElevatorBoard #ElevatorBoardName").css("background-color", "white");
        });

        $("a[id^='ElevatorBoardDel']").click(function () {
            var id = $(this).closest("tr").find("td:eq(3)").text();
            $('#ElevatorBoardDeleteModal #ElevatorBoardId').val(id);
        });
        $("a[ID^='ElevatorBoardEdit']").click(function () {
            var id = $(this).closest("tr").find("td:eq(3)").text();
            var name = $(this).closest("tr").find("td:eq(0)").text();
            $('#ElevatorBoardEditModal #ElevatorBoardId').val(id);
            $('#ElevatorBoardEditModal #ElevatorBoardName').val(name);
        });

        //////////////////////////// Deduction ////////////////////////////////
        $("#formAddDeduction").submit(function (e) {
            var Deduction = $("#DeductionName").val();
            if (Deduction == "" || Deduction == null) {
                $("#formAddDeduction #DeductionName").css("background-color", "#eb6a6a");
                return false;
                e.preventDefault();
            }
        });
        $("#DeductionName").click(function () {
            $("#formAddDeduction #DeductionName").css("background-color", "white");
        });

        $("a[ID^='DeductionDel']").click(function () {
            var id = $(this).closest("tr").find("td:eq(3)").text();
            var id2 = $(this).closest("tr").find("td:eq(3)").val();
            if (id2 != null && id2 != "") {
                $('#DeductionDeleteModal #DeductionId').val(id2);
            }
            else if (id != null && id != "") {
                $('#DeductionDeleteModal #DeductionId').val(id);
            }
        });
        $("a[ID^='DeductionEdit']").click(function () {
            var id = $(this).closest("tr").find("td:eq(3)").text();
            var name = $(this).closest("tr").find("td:eq(0)").text();
            $('#DeductionEditModal #DeductionId').val(id);
            $('#DeductionEditModal #DeductionName').val(name);
        });
        //######################### Addition #########################################
        $("#formAddAddition").submit(function (e) {
            var Addition = $("#AdditionName").val();
            if (Addition == "" || Addition == null) {
                $("#formAddAddition #AdditionName").css("background-color", "#eb6a6a");
                return false;
                e.preventDefault();
            }
        });
        $("#AdditionName").click(function () {
            $("#formAddAddition #AdditionName").css("background-color", "white");
        });

        $("a[ID^='AdditionDel']").click(function () {
            var id = $(this).closest("tr").find("td:eq(3)").text();
            var id2 = $(this).closest("tr").find("td:eq(3)").val();
            if (id2 != null && id2 != "") {
                $('#AdditionDeleteModal #AdditionId').val(id2);
            }
            else if (id != null && id != "") {
                $('#AdditionDeleteModal #AdditionId').val(id);
            }
        });
        $("a[ID^='AdditionEdit']").click(function () {
            var id = $(this).closest("tr").find("td:eq(3)").text();
            var name = $(this).closest("tr").find("td:eq(0)").text();
            $('#AdditionEditModal #AdditionId').val(id);
            $('#AdditionEditModal #AdditionName').val(name);
        });

    });
</script>

