@*####################################Start Delete Modal ###############################################*@
<div class="modal fade" tabindex="-1" role="dialog" id="PanelModelDeleteModal">
    <div class="row">
        <div class="col-xs-pull-3 col-xs-5 modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header ModalHeader">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">حذف مدل پنل</h4>
                </div>
                <div class="modal-body">
                    <p>آیا از حذف مدل پنل مطمئن هستید؟</p>
                    <form method="post" action="@Url.Action("DeleteHallPanelModel", "Information")" class="formDelete">
                        <input type="text" style="display:none;" id="ItemId" name="ItemId" />
                        <div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal">بستن</button>
                            <button type="submit" class="btn btn-primary btndelete">حذف</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" role="dialog" id="SurfaceMetalDeleteModal">
    <div class="row">
        <div class="col-xs-pull-3 col-xs-5 modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header ModalHeader">
