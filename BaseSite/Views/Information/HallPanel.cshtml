                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@*#################################END Delete Modal #################################################*@

@*########################################## JAVA SCRIPT PART #############################################*@
<script type="text/javascript">
    $(document).ready(function () {
        //$("Li#PrimaryInfo").css("background-color", "#524d4d");
        $("Li#PrimaryInfo a").css("color", "#fff");
        $("Li#PrimaryInfo a").css("background-color", "transparent");
        $("Li#PrimaryInfo a").css("font-size", "12px");
        $("Li#PrimaryInfo a").css("font-weight", "bolder");

        //تغییر رنگ بکگراند شهرها و اشخاص
        var PageHref = window.location.href;
        var PageHrefSplits = PageHref.split('/');
        var LinkHref = PageHrefSplits[5];
        if (LinkHref == "Index" || LinkHref == null || LinkHref == "") {
            $("a[ID='HallPanel']").css("background-color", "rgba(0, 0, 0, 0.19)");
        }

        ////////////////////// PanelModel //////////////////
        $("button[name=PanelModelDelete]").click(function () {
            var id = $(this).prop('id');
            if (id != null && id != "") {
                $('#PanelModelDeleteModal #ItemId').val(id);
            }
        });

        $('.edit-mode').hide();
        $('.edit-item').on('click', function () {
            var tr = $(this).parents('tr:first');
            tr.find('.edit-mode, .display-mode').toggle();
        });
        $('.save-item').on('click', function () {
            var tr = $(this).parents('tr:first');
            var itemId = $(this).prop('id');
            var name = tr.find('#iName').val();
            var description = tr.find('#iDescription').val();
            var cost = tr.find('#iCost').val();
            var productFactor = tr.find('#iProductFactor').val();
            var startFrom = tr.find('#iStartFrom').find(":selected").val();
            var available = tr.find('#iAvailable').prop("checked");
            var surfaceArea = tr.find('#iSurfaceArea').val();

            $.ajax({
                url: "@Url.Action("EditHallPanelModel", "Information")",
                type: "Post",
                dataType: "json",
                data: { ItemId: itemId, ItemName: name, ItemDescription: description, ItemCost: cost, ItemProductFactor: productFactor, ItemAvailable: available, ItemSurfaceArea: surfaceArea, ItemStartFrom: startFrom },
                success: function (data) {
                    tr.find('#Name').text(data.Name);
                    tr.find('#Description').text(data.Description);
                    tr.find('#Cost').autoNumeric('set', data.Cost);
                    tr.find('#ProductFactor').text(data.ProductFactor);
                    tr.find('#iStartFrom').val(data.StartFrom);
                    tr.find('#StartFrom').text(tr.find('#iStartFrom').find(":selected").text());
                    tr.find('#Available').prop("checked", data.Available);
                    tr.find('#SurfaceArea').text(data.SurfaceArea);

                    tr.find('.edit-mode, .display-mode').toggle();
                }
            });
        });

        ////////////////////// SurfaceMetal //////////////////
        $("button[name=SurfaceMetalDelete]").click(function () {
            var id = $(this).prop('id');
            if (id != null && id != "") {
                $('#SurfaceMetalDeleteModal #ItemId').val(id);
            }
        });

        $('.edit-item2').on('click', function () {
            var tr = $(this).parents('tr:first');
            tr.find('.edit-mode, .display-mode').toggle();
        });
        $('.save-item2').on('click', function () {
            var tr = $(this).parents('tr:first');
            var itemId = $(this).prop('id');
            var name = tr.find('#iName').val();
            var description = tr.find('#iDescription').val();
            var cost = tr.find('#iCost').val();
            var productFactor = tr.find('#iProductFactor').val();
            var available = tr.find('#iAvailable').prop("checked");

            $.ajax({
                url: "@Url.Action("EditHallSurfaceMetal", "Information")",
                type: "Post",
                dataType: "json",
                data: { ItemId: itemId, ItemName: name, ItemDescription: description, ItemCost: cost, ItemProductFactor: productFactor, ItemAvailable: available, ItemStartFrom: 1 },
                success: function (data) {
                    tr.find('#Name').text(data.Name);
                    tr.find('#Description').text(data.Description);
                    tr.find('#Cost').autoNumeric('set', data.Cost);
                    tr.find('#ProductFactor').text(data.ProductFactor);
                    tr.find('#Available').prop("checked", data.Available);

                    tr.find('.edit-mode, .display-mode').toggle();
                }
            });
        });
    });
</script>
