<div class="row nopadding AddingPanel">
    <div class="col-xs-6">
        <label>تغییر درصدی قیمت ها:</label>
        <input type="text" class="text-center MyControl autoNumber" style="direction:ltr;" id="changePercent2" name="changePercent" placeholder="مثال 10- یا 10" />
        <label>درصد</label>
        <button class="btn btn-warning" style="font-size:small;" data-toggle="modal" data-target="#changecost21">تایید</button>
    </div>
    <div class="col-xs-6">
        <label>تغییر ریالی قیمت ها:</label>
        <input type="text" class="text-center MyControl autoNumber" style="direction:ltr;" id="changeAmount2" name="changeAmount" placeholder="مثال 120000- یا 120000" />
        <label>ریال</label>
        <button class="btn btn-warning" style="font-size:small;" data-toggle="modal" data-target="#changecost22">تایید</button>
    </div>
</div>

<div class="modal fade" tabindex="-1" role="dialog" id="changecost21">
    <div class="row">
        <div class="col-xs-pull-3 col-xs-5 modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header ModalHeader">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">تغییر درصدی قیمت ها</h4>
                </div>
                <div class="modal-body">
                    <p>آیا از تغییر درصدی قیمت ها با درصد وارد شده مطمئن هستید؟</p>
                    <input type="text" style="display:none;" id="ItemId" name="ItemId" />
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">بستن</button>
                        <button type="button" class="btn btn-success" data-dismiss="modal" id="changeconfirm21">تایید</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" tabindex="-1" role="dialog" id="changecost22">
    <div class="row">
        <div class="col-xs-pull-3 col-xs-5 modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header ModalHeader">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">تغییر ریالی قیمت ها</h4>
                </div>
                <div class="modal-body">
                    <p>آیا از تغییر ریالی قیمت ها به مقدار وارد شده مطمئن هستید؟</p>
                    <input type="text" style="display:none;" id="ItemId" name="ItemId" />
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">بستن</button>
                        <button type="button" class="btn btn-success" data-dismiss="modal" id="changeconfirm22">تایید</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $('#changeconfirm21').on('click', function () {
        var percent = parseFloat($("#changePercent2").autoNumeric('get'));
        if ($.isNumeric(percent)) {
            $("#@ViewData["sectionId2"].ToString()").find('.display-mode').hide();
            $("#@ViewData["sectionId2"].ToString()").find('.edit-mode').show();

            $("#@ViewData["sectionId2"].ToString()").find('.iCost').each(function (index) {
                var v = parseFloat($(this).autoNumeric('get'));
                if (v > 0) {
                    v = v + (v * percent / 100);
                    $(this).autoNumeric('set', Math.ceil(v / 10000) * 10000);
                }
            });
        }
    });

    $('#changeconfirm22').on('click', function () {
        var amount = parseFloat($("#changeAmount2").autoNumeric('get'));
        if ($.isNumeric(amount)) {
            $("#@ViewData["sectionId2"].ToString()").find('.display-mode').hide();
            $("#@ViewData["sectionId2"].ToString()").find('.edit-mode').show();

            $("#@ViewData["sectionId2"].ToString()").find('.iCost').each(function (index) {
                var v = parseFloat($(this).autoNumeric('get'));
                if (v > 0) {
                    v = v + amount;
                    $(this).autoNumeric('set', Math.ceil(v / 10000) * 10000);
                }
            });
        }
    });
</script>



