@*########################################## JAVA SCRIPT PART #############################################*@
@*$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$*@
<script type="text/javascript">
    $(document).ready(function () {
        //$("Li#PrimaryInfo").css("background-color", "#524d4d");
        $("Li#PrimaryInfo a").css("color", "#fff");
        $("Li#PrimaryInfo a").css("background-color", "transparent");
        $("Li#PrimaryInfo a").css("font-size", "12px");
        $("Li#PrimaryInfo a").css("font-weight", "bolder");
        var CountryID = '@ViewBag.CountryID';
        var ProvinceID = '@ViewBag.ProvinceID';

        $("table#tblCountry tr td#Country" + CountryID).css('background-color', 'rgba(189, 182, 182, 0.78)');
        $("table#tblProvince tr td#Province" + ProvinceID).css('background-color', 'rgba(189, 182, 182, 0.78)');

        //تغییر رنگ بکگراند شهرها و اشخاص
        var PageHref = window.location.href;
        var PageHrefSplits = PageHref.split('/');
        var LinkHref = PageHrefSplits[4];
        if (LinkHref == "Cities" || LinkHref == null || LinkHref == "") {
            $("a[ID='Cities']").css("background-color", "rgba(0, 0, 0, 0.19)");
        }

        $("a[id^='CounDel']").click(function () {
            var id = $(this).closest("tr").find("td:eq(3)").text();
            $('#CountryDeleteModal #Countryid').val(id);
        });
        $("a[ID^='CounEdite']").click(function () {
            var id = $(this).closest("tr").find("td:eq(3)").text();
            var name = $(this).closest("tr").find("td:eq(0)").text();
            $('#CountryEditeModal #Countryid').val(id);
            $('#CountryEditeModal #CountryName').val(name);
        });

        $("a[id^='ProDel']").click(function () {
            var id = $(this).closest("tr").find("td:eq(3)").text();
            $('#ProvinceDeleteModal #Countryid').val(CountryID);
            $('#ProvinceDeleteModal #Provinceid').val(id);
        });
        $("a[ID^='ProEdite']").click(function () {
            var id = $(this).closest("tr").find("td:eq(3)").text();
            var name = $(this).closest("tr").find("td:eq(0)").text();
            $('#ProvinceEditeModal #Countryid').val(CountryID);
            $('#ProvinceEditeModal #Provinceid').val(id);
            $('#ProvinceEditeModal #ProvinceName').val(name);
        });

        $("a[id^='CityDel']").click(function () {
            var id = $(this).closest("tr").find("td:eq(3)").text();
            $('#CityDeleteModal #Countryid').val(CountryID);
            $('#CityDeleteModal #Provinceid').val(ProvinceID);
            $('#CityDeleteModal #Cityid').val(id);
        });
        $("a[ID^='CityEdite']").click(function () {
            var id = $(this).closest("tr").find("td:eq(3)").text();
            var name = $(this).closest("tr").find("td:eq(0)").text();
            $('#CityEditeModal #Countryid').val(CountryID);
            $('#CityEditeModal #Provinceid').val(ProvinceID);
            $('#CityEditeModal #Cityid').val(id);
            $('#CityEditeModal #CityName').val(name);
        });


        //Forms(Country,Province,City)
        $("#FormCountryAdd").submit(function (e) {
            var Country = $("#CountryName").val();
            if(Country == "" || Country == null)
            {
                $("#FormCountryAdd #CountryName").css("background-color", "#eb6a6a");
                return false;
                e.preventDefault();
            }
        });
        $("#CountryName").click(function () {
            $("#FormCountryAdd #CountryName").css("background-color", "white");
        });

        //Province
        $("#FormProvinceAdd").submit(function (e) {
            var Country = $("#ProvinceName").val();
            if (Country == "" || Country == null) {
                $("#FormProvinceAdd #ProvinceName").css("background-color", "#eb6a6a");
                return false;
                e.preventDefault();
            }
        });

        $("#ProvinceName").click(function () {
            $("#FormProvinceAdd #ProvinceName").css("background-color", "white");
        });

        //City
        $("#FormCityAdd").submit(function (e) {
            var Country = $("#CityName").val();
            if (Country == "" || Country == null) {
                $("#FormCityAdd #CityName").css("background-color", "#eb6a6a");
                return false;
                e.preventDefault();
            }
        });

        $("#CityName").click(function () {
            $("#FormCityAdd #CityName").css("background-color", "white");
        });
    });
</script>
