@{
    ViewBag.Title = "اطلاعات پایه";
    Layout = "~/Views/Shared/LayoutBase.cshtml";
}

<div class="row">
    <div id="DivDetail">
        <div class="col-xs-4" id="DivCountry">
            <p class="TopText">کشور</p>
            @if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Setting_Cities_Add))
            {
                <div class="row col-xs-12 nopadding">
                    <form method="post" action="@Url.Action("CityAdd", "Information")" id="FormCountryAdd" class="formAdd">
                        <div class="col-xs-8">
                            <input type="text" class="form-control alert-dismissible" id="CountryName" name="CountryName" placeholder="نام کشور">
                        </div>
                        <div class="col-xs-4">
                            <button class="btn btn-warning AddBtn" type="submit">افزودن</button>
                        </div>
                    </form>
                </div>
            }
            <div class="col-xs-12 DivBox">
                <table class="table table-responsive table-condensed" id="tblCountry">
                    @foreach (var item in ViewBag.Country)
                    {
                        <tr>
                            <td id="@string.Format("Country{0}", item.Id)"><a class="CountryName" href="@Url.Action("Cities", "Information", new { Countryid = item.Id })">@item.Name</a></td>
                            @if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Setting_Cities_Edit))
                            {
                                <td>
                                    <a data-toggle="modal" href="#CountryEditeModal" id="@string.Format("CounEdite{0}", item.Id)">ویرایش</a>
                                </td>
                            }
                            @if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Setting_Cities_Delete))
                            {
                                <td>
                                    <a data-toggle="modal" href="#CountryDeleteModal" id="@string.Format("CounDel{0}", item.Id)">حذف</a>
                                </td>
                            }
                            <td style="display:none;">@item.Id</td>
                        </tr>
                    }
                </table>
            </div>
        </div>

        <div class="col-xs-4" id="DivProvince">
            <p class="TopText">استان</p>
            @if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Setting_Cities_Add))
            {
                <div class="row col-xs-12 nopadding">
                    <form method="post" action="@Url.Action("CityAdd", "Information")" id="FormProvinceAdd" class="formAdd">
                        <div class="col-xs-8">
                            <input type="text" style="display:none;" id="Countryid" name="Countryid" value="@ViewBag.CountryID">
                            <input type="text" class="form-control alert-dismissible" id="ProvinceName" name="ProvinceName" placeholder="نام استان">
                        </div>
                        <div class="col-xs-4">
                            <button class="btn btn-warning AddBtn" type="submit">افزودن</button>
                        </div>
                    </form>
                </div>
            }
            <div class="col-xs-12 DivBox">
                <table class="table table-responsive table-condensed" id="tblProvince">
                    @foreach (var item in ViewBag.Province)
                    {
                        <tr>
                            <td id="@string.Format("Province{0}", item.Id)"><a class="ProvinceName" href="@Url.Action("Cities", "Information", new { Countryid = ViewBag.CountryID, Provinceid = item.Id })"> @item.Name</a></td>
                            @if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Setting_Cities_Edit))
                            {
                                <td>
                                    <a data-toggle="modal" href="#ProvinceEditeModal" id="@string.Format("ProEdite{0}", item.Id)">ویرایش</a>
                                </td>
                            }
                            @if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Setting_Cities_Delete))
                            {
                                <td>
                                    <a data-toggle="modal" href="#ProvinceDeleteModal" id="@string.Format("ProDel{0}", item.Id)">حذف</a>
                                </td>
                            }
                            <td style="display:none;">@item.Id</td>
                        </tr>
                    }
                </table>
            </div>
        </div>

        <div class="col-xs-4" id="DivCity">
            <p class="TopText">شهر</p>
            @if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Setting_Cities_Add))
            {
                <div class="row col-xs-12 nopadding">
                    <form method="post" action="@Url.Action("CityAdd", "Information")" id="FormCityAdd" class="formAdd">
                        <div class="col-xs-8">
                            <input type="text" style="display:none;" id="Countryid" name="Countryid" value="@ViewBag.CountryID">
                            <input type="text" style="display:none;" id="Provinceid" name="Provinceid" value="@ViewBag.ProvinceID">
                            <input type="text" class="form-control alert-dismissible" id="CityName" name="CityName" placeholder="نام شهر">
                        </div>
                        <div class="col-xs-4">
                            <button class="btn btn-warning AddBtn" type="submit">افزودن</button>
                        </div>
                    </form>
                </div>
            }
            <div class="col-xs-12 DivBox">
                <table class="table table-responsive table-condensed" id="tblCity">
                    @foreach (var item in ViewBag.City)
                    {
                        <tr>
                            <td id="@string.Format("City{0}", item.Id)"><a class="CityName" href="#">@item.Name</a></td>
                            @if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Setting_Cities_Edit))
                            {
                                <td>
                                    <a data-toggle="modal" href="#CityEditeModal" id="@string.Format("CityEdite{0}", item.Id)">ویرایش</a>
                                </td>
                            }
                            @if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Setting_Cities_Delete))
                            {
                                <td>
                                    <a data-toggle="modal" href="#CityDeleteModal" id="@string.Format("CityDel{0}", item.Id)">حذف</a>
                                </td>
                            }
                            <td style="display:none;">@item.Id</td>
                        </tr>
                    }
                </table>
            </div>
        </div>

    </div>
</div>

@*############################################# MODALS PART ####################################################*@
@*##############################################################################################################*@
@*####################################Start Country Delete Modal ###############################################*@
<div class="modal fade" tabindex="-1" role="dialog" id="CountryDeleteModal">
    <div class="row">
        <div class="col-xs-pull-3 col-xs-5 modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header ModalHeader">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">حذف کشور</h4>
                </div>
                <div class="modal-body">
                    <p>آیا از حذف کشور مطمئن هستید؟</p>
                    <form method="post" action="@Url.Action("CityDelete", "Information")" class="formDelete">
                        <input type="text" style="display:none;" id="Countryid" name="Countryid" />
                        <div class="modal-footer">
                            <button type="button" class="btn btn-default" data-dismiss="modal">بستن</button>
                            <button type="submit" class="btn btn-primary btndelete">حذف</button>
                        </div>
                    </form>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div>
</div><!-- /.modal -->
@*#################################END Country Delete Modal #################################################*@

