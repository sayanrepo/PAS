@using System.Globalization
@model List<BaseSite.Models.ZaribKarkard>
@{
    ViewBag.Title = "کارکرد";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
    WebGrid grid = new WebGrid(null, rowsPerPage: 200);
    grid.Bind(Model, autoSortAndPage: true, rowCount: ViewBag.RowCount);
}

@{
    Func<DateTime, string> toPersianDate = date =>
    {
        var dateTime = new DateTime(date.Year, date.Month, date.Day, new GregorianCalendar());
        var persianCalendar = new PersianCalendar();
        return persianCalendar.GetYear(dateTime) + "/" +
               persianCalendar.GetMonth(dateTime).ToString("00") + "/" +
               persianCalendar.GetDayOfMonth(dateTime).ToString("00");
    };
    var today = toPersianDate(DateTime.Now);
}

@*##################### Search Div #############################*@
<div class="row">
    <div class="col-md-10 col-md-offset-1 col-xs-12" id="DivSearch">
        <form method="post" action="@Url.Action("SearchProductFactors")">
            <div class="row">
                <div class="col-md-4 col-sm-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon">تاریخ سفارش از</span>
                        <input type="text" name="reportDateFrom" class="form-control text-center text-left" dir="ltr"
                               value="@ViewBag.reportDateFrom"
                               onclick="PersianDatePicker.Show(this,'@today');" />
                    </div>
                </div>
                <div class="col-md-4 col-sm-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon">تا</span>
                        <input type="text" name="reportDateTo" class="form-control text-center text-left" dir="ltr"
                               value="@ViewBag.reportDateTo"
                               onclick="PersianDatePicker.Show(this,'@today');" />
                    </div>
                </div>
                <div class="col-xs-2 col-md-2 col-md-offset-1 col-xs-offset-5">
                    <button class="btn btn-sm btn-primary">جستجو</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <div id="DivDetail">
        <div>
            @grid.GetHtml(tableStyle: "table table-bordered table-responsive tblgrid",
            headerStyle: "tblGridHeader",
            mode: WebGridPagerModes.All,
            firstText: "<< اولین ",
            previousText: "< قبلی",
            nextText: "بعدی >",
            lastText: "آخرین >>",
            columns: grid.Columns(
            grid.Column("OperatorName", header: "نام", format: item => item.UserFullName),
            grid.Column("CalculatedFactor", header: "مجموع کارکرد", format: item => item.CalculatedFactor),
            grid.Column(header: "جزئیات",
            format: @<text>
                <a data-toggle="modal" href="#ProcessModal" name="processLink" data-userid="@item.UserId" data-userfullname="@item.UserFullName"><i class="fa fa-list fa-lg" title="جزئیات"></i></a>
            </text>),
            grid.Column(header: "چاپ",
            format: @<text>
                <a target="_blank" href="@Url.Action("PrintProductFactors", "Report", new { userId = item.UserId, dateFrom = ViewBag.reportDateFrom, dateTo = ViewBag.reportDateTo })" name="processLink"><i class="fa fa-print fa-lg" title="چاپ"></i></a>
            </text>)
))
        </div>
    </div>
</div>


@*#################################Start Modal ###############################################*@
