                                </div>
                                <div class="box bg-info text-center" style="display: table-cell;">
                                    <p><b> درصد انجام شده</b></p>
                                </div>
                                <div class="box bg-info text-center" style="display: table-cell;">
                                    <p><b> ضریب سند</b></p>
                                </div>
                                <div class="box bg-info text-center" style="display: table-cell;">
                                    <p><b>کارکرد</b></p>
                                </div>
                            </div>
                            @*<div style="display: table-row">
                                    <div class="box text-center" style="display: table-cell;">
                                        <p><b>item.ShTime</b></p>
                                    </div>
                                    <div class="box text-center" style="display: table-cell;">
                                        <p><b>item.Description</b></p>
                                    </div>
                                    <div class="box text-center" style="display: table-cell;">
                                        <p><b>item.DocNumber</b></p>
                                    </div>
                                    <div class="box text-center" style="display: table-cell;">
                                        <p><b>item.ItemName</b></p>
                                    </div>
                                    <div class="box text-center" style="display: table-cell;">
                                        <p><b>item.ItemModel</b></p>
                                    </div>
                                    <div class="box text-center" style="display: table-cell;">
                                        <p><b>item.ItemPFactor</b></p>
                                    </div>
                                <div class="box text-center" style="display: table-cell;">
                                        <p><b>item.Count</b></p>
                                    </div>
                                    <div class="box text-center" style="display: table-cell;">
                                        <p>item.StatusName</p>
                                    </div>
                                    <div class="box text-center" style="display: table-cell;">
                                        <p>item.Percent</p>
                                    </div>
                                    <div class="box text-center" style="display: table-cell;">
                                        <p>item.CalculatedFactor</p>
