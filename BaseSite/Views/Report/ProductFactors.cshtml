                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@*################################END Modal ###################################################*@

<script type="text/javascript">
    $(document).ready(function () {

        var PageHref = window.location.href;
        var PageHrefSplits = PageHref.split('/');
        var LinkHref = PageHrefSplits[4];
        if (LinkHref == "ProductFactors") {
            $("a[ID='ProductFactors']").css("background-color", "rgba(0, 0, 0, 0.19)");
        }
    });

    $('#ProcessModal').on('show.bs.modal', function (event) {
        var clickedLink = $(event.relatedTarget); // Button that triggered the modal
        var vuserId = clickedLink.data("userid"); // Extract info from data-* attributes
        var vuserFullName = clickedLink.data("userfullname");

        var modal = $(this);
        modal.find('.modal-title').text('جزئیات کارکرد (' + vuserFullName + ')');

        var contentHtml = "<div style='display: table-row'>"+
                                    "<div class='box bg-info text-center' style='display: table-cell;'><p><b>تاریخ</b></p></div>" +
                                    "<div class='box bg-info text-center' style='display: table-cell;'><p><b>شرح</b></p></div>" +
                                    "<div class='box bg-info text-center' style='display: table-cell;'><p><b>شماره سند</b></p></div>" +
                                    "<div class='box bg-info text-center' style='display: table-cell;'><p><b>آیتم</b></p></div>" +
                                    "<div class='box bg-info text-center' style='display: table-cell;'><p><b>مدل</b></p></div>" +
                                    "<div class='box bg-info text-center' style='display: table-cell;'><p><b>ضریب واحد</b></p></div>" +
                                    "<div class='box bg-info text-center' style='display: table-cell;'><p><b>تعداد</b></p></div>" +
                                    "<div class='box bg-info text-center' style='display: table-cell;'><p><b> مرحله</b></p></div>"+
                                    "<div class='box bg-info text-center' style='display: table-cell;'><p><b> درصد انجام شده</b></p></div>"+
                                    "<div class='box bg-info text-center' style='display: table-cell;'><p><b> ضریب سند</b></p></div>" +
                                    "<div class='box bg-info text-center' style='display: table-cell;'><p><b>کارکرد</b></p></div>" +
                                    "</div>";
        $('#ProcessTable').html(contentHtml);

        $.ajax({
            url: "@Url.Action("GetProcessList", "Report")",
            type: "GET",
            dataType: "json",
            data: { userId: vuserId, dateFrom: '@ViewBag.reportDateFrom', dateTo: '@ViewBag.reportDateTo'},
            success: function (data) {
                $.each(data, function (i, item) {
                    contentHtml = "<div style='display: table-row'>" +
                                    "<div class='box text-center' style='display: table-cell;'><p><b>" + item.ShTime + "</b></p></div>" +
                                    "<div class='box text-center' style='display: table-cell;'><p><b>" + item.Description + "</b></p></div>" +
                                    "<div class='box text-center' style='display: table-cell;'><p><b>" + item.DocNumber + "</b></p></div>" +
                                    "<div class='box text-center' style='display: table-cell;'><p><b>" + item.ItemName + "</b></p></div>" +
                                    "<div class='box text-center' style='display: table-cell;'><p><b>" + item.ItemModel + "</b></p></div>" +
                                    "<div class='box text-center' style='display: table-cell;'><p><b>" + Math.round(item.ItemPFactor * 10000) / 10000 + "</b></p></div>" +
                                    "<div class='box text-center' style='display: table-cell;'><p><b>" + item.Count + "</b></p></div>" +
                                    "<div class='box text-center' style='display: table-cell;'><p>" + item.StatusName + "</p></div>" +
                                    "<div class='box text-center' style='display: table-cell;'><p>" + item.Percent + "</p></div>" +
                                    "<div class='box text-center' style='display: table-cell;'><p>" + Math.round(item.CalculatedFactor * 10000)/10000 + "</p></div>" +
                                    "<div class='box text-center' style='display: table-cell;'><p>" + Math.round(item.CalculatedFactor * (item.Percent / 100) * 10000) / 10000 + "</p></div>" +
                                    "</div>";
                    $('#ProcessTable').append(contentHtml);
                });
            }
        })
    })
</script>
