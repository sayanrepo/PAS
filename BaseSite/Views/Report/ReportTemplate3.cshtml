@using System.Globalization
@model BaseSite.Models.DBModel.Report_Report
@{
    ViewBag.Title = Model.ReportDescription;
    if (Model.ReportName == "RCustomerBill")
    {
        Layout = "~/Views/Shared/LayoutMain.cshtml";
    }
    else
    {
        Layout = "~/Views/Shared/LayoutReport.cshtml";
    }
}

@{
    Func<DateTime, string> toPersianDate = date =>
            {
                var dateTime = new DateTime(date.Year, date.Month, date.Day, new GregorianCalendar());
                var persianCalendar = new PersianCalendar();
                return persianCalendar.GetYear(dateTime) + "/" +
                       persianCalendar.GetMonth(dateTime).ToString("00") + "/" +
                       persianCalendar.GetDayOfMonth(dateTime).ToString("00");
            };
    var today = toPersianDate(DateTime.Now);
}

<div class="row">
    <div class="col-xs-1">
        <div class="row">
            <div class="col-xs-12 text-center">
                <a class="btn btn-success" href="@Url.Action("ReportList", "Report")">بازگشت به گزارشات</a>
            </div>
        </div>
    </div>

    <div class="col-xs-11">
        @*<iframe src="@("http://93.118.96.246:82/reports/powerbi/"+Model.ReportName)" style="width:100%; height:100%" />*@

        <iframe src="@("http://192.168.200.254:82/reports/powerbi/"+Model.ReportName)" style="width:100%; height:100%" />
    </div>
</div>
