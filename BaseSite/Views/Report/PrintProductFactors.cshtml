@{
    Layout = null;
    ViewBag.title = "گزارش کارکرد پرسنل";
    ViewBag.sum = 0;
}
@model List<BaseSite.Models.DBModel.Order_Process>

<!DOCTYPE html>

<link href="@Url.Content("~/Contents/css/bootstrap.css")" rel="stylesheet">
<link href="@Url.Content("~/Contents/css/bootstrap-rtl.css")" rel="stylesheet">
<script src="@Url.Content("~/Contents/js/jquery-3.1.1.js")"></script>
<script src="@Url.Content("~/Contents/js/printThis.js")"></script>
<link href="@Url.Content("~/Contents/css/MyStyle/PrintPA4.css")" rel="stylesheet">

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.title</title>
</head>
<body>
    <div class="container-fluid" id="divPrint">
        <div class="row">
            <div class="col-xs-3 text-right">گزارش کارکرد پرسنل</div>
            <div class="col-xs-3 text-right">نام: <b>@ViewBag.UserFullName</b></div>
            <div class="col-xs-3 text-right">از تاریخ: <b>@ViewBag.ShDateFrom</b></div>
            <div class="col-xs-3 text-right">تا تاریخ: <b>@ViewBag.ShDateTo</b></div>
        </div>
        <div class="row" style="margin-top:2px;">
            <div style="width: 100%; display: table;" id="ProcessTable">
                <div style="display: table-row">
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b>تاریخ</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b>شرح</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> شماره سند</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> آیتم</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> مدل</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> ضریب واحد</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> تعداد</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> مرحله</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> درصد انجام شده</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> ضریب سند</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b>کارکرد</b></p>
                    </div>
                </div>
                @for (int i = 0; i < Model.Count; i++)
                {
                    ViewBag.sum += (Model.ElementAt(i).CalculatedFactor * (Model.ElementAt(i).Percent / 100));

                    <div style="display: table-row">
                        <div class="box text-center" style="display: table-cell;">
                            <p><b>@Model.ElementAt(i).ShTime</b></p>
                        </div>
                        <div class="box text-center" style="display: table-cell;">
                            <p><b>@string.Format("{0}", Model.ElementAt(i).OrderId == 0 ? Model.ElementAt(i).Description: Model.ElementAt(i).Order_Order.Account_Users.FullName)</b></p>
                        </div>
                        <div class="box text-center" style="display: table-cell;">
                            <p><b>@Model.ElementAt(i).Order_Order.DocNumber</b></p>
                        </div>
                        <div class="box text-center" style="display: table-cell;">
                            <p><b>@(Model.ElementAt(i).ProductDocNumber.ToString().StartsWith("2") ? "داخل کابین" : (Model.ElementAt(i).ProductDocNumber.ToString().StartsWith("3") ? "طبقات" : (Model.ElementAt(i).ProductDocNumber.ToString().StartsWith("4") ? "سردرب" : "سایر")))</b></p>
                        </div>
                        <div class="box text-center" style="display: table-cell;">
                            <p>
                                @(Model.ElementAt(i).OrderId == 0 ? "-" :
                                  Model.ElementAt(i).ProductDocNumber.ToString().StartsWith("2") ? Model.ElementAt(i).Order_Order.Order_Cabin.Where(x => x.DocNumber == Model.ElementAt(i).ProductDocNumber).SingleOrDefault().Tb_CabinPanels.Name :
                                  Model.ElementAt(i).ProductDocNumber.ToString().StartsWith("3") ? Model.ElementAt(i).Order_Order.Order_Hall.Where(x => x.DocNumber == Model.ElementAt(i).ProductDocNumber).SingleOrDefault().Tb_HallPanels.Name :
                                  Model.ElementAt(i).ProductDocNumber.ToString().StartsWith("4") ? Model.ElementAt(i).Order_Order.Order_DoorTop.Where(x => x.DocNumber == Model.ElementAt(i).ProductDocNumber).SingleOrDefault().Tb_DoorTopPanels.Name : "-")
                            </p>
                        </div>
                        <div class="box text-center" style="display: table-cell;">
                            <p>
                                @Model.ElementAt(i).ProductFactor
                            </p>
                        </div>
                        <div class="box text-center" style="display: table-cell;">
                            <p>
                                @Model.ElementAt(i).Count
                            </p>
                        </div>
                        <div class="box text-center" style="display: table-cell;">
                            <p>@Model.ElementAt(i).Order_ProductStatus.Name</p>
                        </div>
                        <div class="box text-center" style="display: table-cell;">
                            <p>@Model.ElementAt(i).Percent</p>
                        </div>
                        <div class="box text-center" style="display: table-cell;">
                            <p>@Model.ElementAt(i).CalculatedFactor</p>
                        </div>
                        <div class="box text-center" style="display: table-cell;">
                            <p>@(Model.ElementAt(i).CalculatedFactor * (Model.ElementAt(i).Percent / 100))</p>
                        </div>
                    </div>
                }
                <div style="display: table-row">
                    <div class="box bg-info text-center" style="display: table-cell;"><p></p></div>
                    <div class="box bg-info text-center" style="display: table-cell;"><p></p></div>
                    <div class="box bg-info text-center" style="display: table-cell;"><p></p></div>
                    <div class="box bg-info text-center" style="display: table-cell;"><p></p></div>
                    <div class="box bg-info text-center" style="display: table-cell;"><p></p></div>
                    <div class="box bg-info text-center" style="display: table-cell;"><p></p></div>
                    <div class="box bg-info text-center" style="display: table-cell;"><p></p></div>
                    <div class="box bg-info text-center" style="display: table-cell;"><p></p></div>
                    <div class="box bg-info text-center" style="display: table-cell;"><p></p></div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b> جمع:</b></p>
                    </div>
                    <div class="box bg-info text-center" style="display: table-cell;">
                        <p><b>@ViewBag.sum</b></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#divPrint').printThis({
                importCSS: true,
                importStyle: true,
                printContainer: true,
                copyTagClasses: true,
                canvas: true
            });
        });
    </script>

</body>
</html>
