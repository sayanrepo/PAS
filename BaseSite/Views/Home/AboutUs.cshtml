        $("Li#AboutUs a").css("color", "#fff");
        $("Li#AboutUs a").css("background-color", "transparent");
        $("Li#AboutUs a").css("font-size", "12px");
        $("Li#AboutUs a").css("font-weight", "bolder");
    });
</script>

