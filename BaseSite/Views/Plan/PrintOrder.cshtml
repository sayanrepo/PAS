                                        <p><b>شروع از: </b> @Model.Order_Cabin.ElementAt(i).Tb_CabinPanels.Order_ProductStatus.Name </p>
                                    </div>
                                    <div class="col-xs-8 text-right">
                                        <p><b>نمایشگر: </b>@Model.Order_Cabin.ElementAt(i).Tb_Monitors.Name</p>
                                    </div>
                                    <div class="col-xs-4 text-right">
                                        <p><b>فلزرویه: </b>@Model.Order_Cabin.ElementAt(i).Tb_CabinSurfaceMetals.Name</p>
                                    </div>
                                    <div class="col-xs-2 text-right">
                                        <p><b>تعداد طبقات: </b>@Model.Order_Cabin.ElementAt(i).FloorCount</p>
                                    </div>
                                    <div class="col-xs-6 text-right">
                                        <b style="float:right; padding-left:5px;">نام و ترتیب طبقات: </b><p style="direction:ltr; float:right;">@Model.Order_Cabin.ElementAt(i).FloorNames</p>
                                    </div>
                                    <div class="col-xs-4 text-right">
                                        <p><b>طبقات زیرین: </b>@Model.Order_Cabin.ElementAt(i).UGFloorCount</p>
                                    </div>
                                    <div class="col-xs-4 text-right">
                                        <p><b>کد بلندگو: </b>@Model.Order_Cabin.ElementAt(i).Tb_Speakers.Name</p>
                                    </div>
                                    <div class="col-xs-4 text-right">
