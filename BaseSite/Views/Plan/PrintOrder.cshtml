                                    <div><p> پنل <p /><p> شاسی </p><p> داخل </p> <p> کابین</p></div>
                                </div>
                                <div class="row box" style="display: table-cell;">
                                    <div class="col-xs-7 text-right">
                                        <p><b>مدل پنل: </b>@Model.Order_Cabin.ElementAt(i).Tb_CabinPanels.Name</p>
                                    </div>
                                    <div class="col-xs-3 text-right">
                                        <p><b>نحوه نصب: </b>@Model.Order_Cabin.ElementAt(i).Tb_InstallationTypes.Name</p>
                                    </div>
                                    <div class="col-xs-2 text-right">
                                        <p><b>تعداد: </b>@Model.Order_Cabin.ElementAt(i).Count</p>
                                    </div>
                                    <div class="col-xs-8 text-right">
                                        <p><b>پوش باتون: </b>@Model.Order_Cabin.ElementAt(i).Tb_PushButtons.Name</p>
                                    </div>
