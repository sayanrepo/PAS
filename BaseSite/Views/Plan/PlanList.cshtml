@using System.Globalization
@model List<BaseSite.Models.Panel>
@{
    ViewBag.Title = "برنامه تولید";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
    WebGrid grid = new WebGrid(null, rowsPerPage: 20);
    grid.Bind(@Model, autoSortAndPage: true, rowCount: ViewBag.RowCount);
}

@{
    Func<DateTime, string> toPersianDate = date =>
    {
        var dateTime = new DateTime(date.Year, date.Month, date.Day, new GregorianCalendar());
        var persianCalendar = new PersianCalendar();
        return persianCalendar.GetYear(dateTime) + "/" +
               persianCalendar.GetMonth(dateTime).ToString("00") + "/" +
               persianCalendar.GetDayOfMonth(dateTime).ToString("00");
    };
    var today = toPersianDate(DateTime.Now);
}

<div class="row">
    <div class="alert alert-success alert-dismissible" role="alert" style="display:none;" id="SuccessedEdit">
        <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <strong><i class="fa fa-hand-peace-o fa-2x"></i></strong> ویرایش اطلاعات با موفقیت انجام شد .
    </div>
</div>
@*##################### Search Div #############################*@
<div class="row">
    @*<div class="col-md-1 col-xs-12">
        <a class="btn btn-link" id="OrderRegisterBtn" title="ثبت سفارش" href="@Url.Action("AddOrder")" target="_blank"><i class="fa fa-calendar-plus-o fa-3x"></i></a>
    </div>*@
@if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Plan_Search))
{
    <div class="col-md-10 col-md-offset-1 col-xs-12" id="DivSearch">
        <form method="post" action="@Url.Action("SearchPlan")">
            <div class="row">
                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon">مشتری</span>
                        @Html.TextBox("Customer", (string)(ViewBag.CustomerName), new { @Class = "form-control MyControl", @Id = "Customer" })
                    </div>
                    @Html.Hidden("customerId", (int?)ViewBag.customerId, new { @Class = "form-control MyControl", @Id = "CustomerId" })
                </div>

                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon">تاریخ سفارش از</span>
                        <input type="text" name="orderDateFrom" class="form-control text-center text-left" dir="ltr"
                               value="@ViewBag.orderDateFrom"
                               onclick="PersianDatePicker.Show(this,'@today');" />
                    </div>
                </div>

                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon">تا</span>
                        <input type="text" name="orderDateTo" class="form-control text-center text-left" dir="ltr"
                               value="@ViewBag.orderDateTo"
                               onclick="PersianDatePicker.Show(this,'@today');" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon" id="Mobile1">وضعیت</span>
                        <select id="OrderStatusId" name="OrderStatusId" class="form-control text-center text-left">
                            <option selected value> </option>
                            @foreach (var item in BaseSite.Models.Cache.Order_OrderStatus)
                            {
                                if(item.Key>=(byte)BaseSite.Models.OrderStatus.DarJaryaneTolid)
                                { 
                                    if (item.Key == ViewBag.orderStatus)
                                    {
                                        <option value="@item.Key" selected="selected">@item.Value</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Key">@item.Value</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon">تاریخ تحویل از</span>
                        <input type="text" name="deliveryDateFrom" class="form-control text-center text-left" dir="ltr"
                               value="@ViewBag.deliveryDateFrom"
                               onclick="PersianDatePicker.Show(this,'@today');" />
                    </div>
                </div>

                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon">تا</span>
                        <input type="text" class="form-control text-center text-left" dir="ltr"
                               name="deliveryDateTo"
                               value="@ViewBag.deliveryDateTo"
                               onclick="PersianDatePicker.Show(this,'@today');" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 col-xs-12 formdiv">
                    <div class="input-group">
                        <span class="input-group-addon">شماره سند</span>
                        <input type="text" name="docNumber" class="form-control text-center text-left" value="@ViewBag.docNumber" />
                    </div>
                </div>

                <div class="col-xs-1 col-md-1 col-md-offset-2 col-xs-offset-2"> <button class="btn btn-sm btn-primary">جستجو</button> </div>
            </div>

        </form>
    </div>
    }
</div>
@*########################### webgrid ##########################################*@
<div class="row DivList">
    <div id="DivDetail">
        <div style="margin-top:20px;">
            @grid.GetHtml(tableStyle: "table table-bordered table-responsive tblgrid",
            headerStyle: "tblGridHeader",
            mode: WebGridPagerModes.All,
            numericLinksCount: 10,
            firstText: " اولین ",
            previousText: " قبلی ",
            nextText: " بعدی ",
            lastText: " آخرین ",
            columns: grid.Columns(
            grid.Column(header: "ردیف",
            format: item => item.WebGrid.Rows.IndexOf(item) + 1 + Math.Round(Convert.ToDouble(grid.TotalRowCount / grid.PageCount) / grid.RowsPerPage) * grid.RowsPerPage * grid.PageIndex),
            grid.Column("OrderDocNumber", header: "شماره سند", format: item => item.DocNumber.ToString().Substring(1)),
            grid.Column("AccepterName", header: "سفارش گیرنده", format: item => item.AccepterName),
            grid.Column("Type", header: "آیتم", format: item => item.Type),
            grid.Column("PanelName", header: "مدل پنل", format: item => item.PanelName),
            grid.Column("Count", header: "تعداد", format: item => item.Count),
            grid.Column("SurfaceMetalName", header: "نوع استیل", format: item => item.SurfaceMetalName),
            grid.Column("ShDateOrder", header: "تاریخ سفارش", format: item => item.ShDateOrder),
            grid.Column("CustomerName", header: "مشتری", format: item => item.CustomerName),
            grid.Column("ShDateFactor", header: "تاریخ تحویل", format: item => item.ShDateFactor),
            grid.Column("ProjectName", header: "نام پروژه", format: item => item.ProjectName),
            grid.Column("OrderStatusName", header: "وضعیت سفارش", format: item => item.OrderStatusName),
            grid.Column("DocNumber", header: "بارکد", format:
            @<text><a data-toggle="modal" href="#ProcessModal" name="processLink" data-docnumber="@item.DocNumber">@item.DocNumber</a></text>),
            grid.Column(header: "جزئیات",
                format: @<text>
                @if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Plan_Detail))
                {
                    <a data-value="@item.OrderId" href="@Url.Action("PlanDetail", new { OrderId = item.OrderId })"><i class="fa fa-list fa-lg" title="جزئیات"></i></a>
                }
                else
                {
                    <a data-value="@item.OrderId" href="#"><i class="fa fa-list fa-lg text-danger" title="جزئیات"></i></a>
                }
                </text>)
             ))
        </div>
    </div>
</div>

@*#################################Start Modal ###############################################*@
<div class="modal fade" tabindex="-1" role="dialog" id="ProcessModal">
    <div class="row">
        <div class="col-xs-pull-3 col-xs-5 modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header ModalHeader">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title">مراحل انجام شده</h4>
                </div>
                <div class="modal-body">
                    <div class="row" style="margin-top:2px;">
                        <div style="width: 100%; display: table;" id="ProcessTable">
                            <div style="display: table-row">
                                <div class="box bg-info text-center" style="display: table-cell;">
                                    <p><b>تاریخ</b></p>
                                </div>
                                <div class="box bg-info text-center" style="display: table-cell;">
                                    <p><b> مرحله</b></p>
                                </div>
                                <div class="box bg-info text-center" style="display: table-cell;">
                                    <p><b> درصد انجام شده</b></p>
                                </div>
                                <div class="box bg-info text-center" style="display: table-cell;">
                                    <p><b> اپراتور</b></p>
                                </div>
                            </div>
                            @*<div style="display: table-row">
                                <div class="box text-center" style="display: table-cell;">
                                    <p><b>item.ShTime</b></p>
                                </div>
                                <div class="box text-center" style="display: table-cell;">
                                    <p>item.StatusName</p>
                                </div>
                                <div class="box text-center" style="display: table-cell;">
                                    <p>item.Percent</p>
                                </div>
                                <div class="box text-center" style="display: table-cell;">
                                    <p>item.OperatorName</p>
                                </div>
                            </div>*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@*################################END Modal ###################################################*@

<script type="text/javascript">

    $('#ProcessModal').on('show.bs.modal', function (event) {
        var clickedLink = $(event.relatedTarget) // Button that triggered the modal
        var vdocNumber = clickedLink.data("docnumber"); // Extract info from data-* attributes

        var modal = $(this)
        modal.find('.modal-title').text('مراحل انجام شده (بارکد: ' + vdocNumber + ')')

        var contentHtml = "<div style='display: table-row'>"+
                                    "<div class='box bg-info text-center' style='display: table-cell;'><p><b>تاریخ</b></p></div>"+
                                    "<div class='box bg-info text-center' style='display: table-cell;'><p><b> مرحله</b></p></div>"+
                                    "<div class='box bg-info text-center' style='display: table-cell;'><p><b> درصد انجام شده</b></p></div>"+
                                    "<div class='box bg-info text-center' style='display: table-cell;'><p><b> اپراتور</b></p></div>"+
                                    "</div>";
        $('#ProcessTable').html(contentHtml);
                
        $.ajax({
            url: "@Url.Action("GetProcessList", "Process")",
            type: "GET",
            dataType: "json",
            data: { docNumber: vdocNumber },
            success: function (data) {
                $.each(data, function (i, item) {
                    contentHtml = "<div style='display: table-row'>" +
                                    "<div class='box text-center' style='display: table-cell;'><p><b>" + item.ShTime + "</b></p></div>" +
                                    "<div class='box text-center' style='display: table-cell;'><p>" + item.StatusName + "</p></div>" +
                                    "<div class='box text-center' style='display: table-cell;'><p>" + item.Percent + "</p></div>" +
                                    "<div class='box text-center' style='display: table-cell;'><p>" + item.OperatorName + "</p></div>" +
                                    "</div>";
                    $('#ProcessTable').append(contentHtml);
                });
            }
        })
    })
</script>