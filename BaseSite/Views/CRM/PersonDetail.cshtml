@*########################################## JAVA SCRIPT PART #############################################*@

<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script type="text/javascript">
    //برای تغییر کشور  ،استان و شهر
    function changeCountry(ecountry) {
        var value = $(ecountry).val();
        if (value == "" || value == null) {
            var eprovince = $('#' + $(ecountry).data('childid'));
            $(eprovince).empty();
            var ecity = $('#' + $(eprovince).data('childid'));
            $(ecity).empty();
        }
        else {
            $.ajax({
                url: '@Url.Action("ProvinceGet", "order")',
                type: 'GET',
                dataType: 'text json',
                data: { countryid: value },
                contentType: 'application/json; charset=utf-8',
                cache: false,
                success: function (result) {
                    var eprovince = $('#' + $(ecountry).data('childid'));
                    $(eprovince).empty();
                    $.each(result, function (index, item) {
                        $(eprovince).append('<option value=' + item.Id + '>' + item.Name + '</option>');
                    });
                    $(eprovince).change();
                },
                error: function (data) {
                    var eprovince = $('#' + $(ecountry).data('childid'));
                    $(eprovince).empty();
                    var ecity = $('#' + $(eprovince).data('childid'));
                    $(ecity).empty();
                    $.each(data, function (index, item) {
                        $(eprovince).append('<option value=' + item.Id + '>' + item.Name + '</option>');
                    });
                    $(eprovince).change();
                }

            });
        }
    };

    function changeProvince(eprovince) {
        var value = $(eprovince).val();
        if (value == "" || value == null) {
            var ecity = $('#' + $(eprovince).data('childid'));
            $(ecity).empty();
        }
        else {
            $.ajax({
                url: '@Url.Action("CityGet", "order")',
                type: 'GET',
                dataType: 'text json',
                data: { provinceid: value },
                contentType: 'application/json; charset=utf-8',
                cache: false,
                success: function (result) {
                    var ecity = $('#' + $(eprovince).data('childid'));
                    $(ecity).empty();
                    $.each(result, function (index, item) {
                        $(ecity).append('<option value=' + item.Id + '>' + item.Name + '</option>');
                    });
                },
                error: function (data) {
                    var ecity = $('#' + $(eprovince).data('childid'));
                    $(ecity).empty();
                    $.each(data, function (index, item) {
                        $(ecity).append('<option value=' + item.Id + '>' + item.Name + '</option>');
                    });
                }
            });
        }
    };


    $(document).ready(function () {
        $("a[ID='Persons']").css("background-color", "rgba(0, 0, 0, 0.19)");

        //چک کردن ایمیل
        $("#email").change(function (e) {
            var VAL = this.value;
            var email = new RegExp('[-0-9a-zA-Z.+_]+@@[-0-9a-zA-Z.+_]+\.[a-zA-Z]{2,4}');
            if (!email.test(VAL)) {
                $(this).css('color', 'red');
                $(this).css('font-weight', 'Bold');
                $(this).css('text-align', 'center');
                $(this).val('ایمیل وارد شده معتبر نمیباشد');
            }
        });

        $("#email").click(function (e) {
            var VAL = $(this).val();
            if (VAL == "ایمیل وارد شده معتبر نمیباشد") {
                $(this).css('color', 'black');
                $(this).css('font-weight', 'normal');
                $(this).css('text-align', 'center');
            }

        });
        $("#inputName").click(function () {
            var value = $(this).val();
            if (value == "لطفا نام را وارد کنید") {
                $("#inputName").css('color', 'black');
                $("#inputName").css('font-weight', 'normal');
                $("#inputName").css('text-align', 'center');
                $("#inputName").val("");
            }
        });

        $("#inputFamily").click(function () {
            var value = $(this).val();
            if (value == "لطفا نام خانوادگی را وارد کنید") {
                $("#inputFamily").css('color', 'black');
                $("#inputFamily").css('font-weight', 'normal');
                $("#inputFamily").css('text-align', 'center');
                $("#inputFamily").val("");
            }
        });

        $('#AddForm').submit(function (e) {
            var result = true;
            if ($("#inputName").val() == "") {
                //$("#inputName").css('background-color', '#eebfb8');
                $("#inputName").css('color', 'red');
                $("#inputName").css('font-weight', 'Bold');
                $("#inputName").css('text-align', 'center');
                $("#inputName").val('لطفا نام را وارد کنید');
                result = false;
            }
            if ($("#inputFamily").val() == "") {
                //$("#inputName").css('background-color', '#eebfb8');
                $("#inputFamily").css('color', 'red');
                $("#inputFamily").css('font-weight', 'Bold');
                $("#inputFamily").css('text-align', 'center');
                $("#inputFamily").val('لطفا نام خانوادگی را وارد کنید');
                result = false;
            }
            if (result == false)
                return false;
        });
    });
</script>


