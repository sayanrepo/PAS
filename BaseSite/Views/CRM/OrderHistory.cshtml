@model BaseSite.Models.DBModel.Account_Users
@{
    List<BaseSite.Models.DBModel.Order_Order> orderList = BaseSite.Models.Order.OrderManager.Order_Order_Search(null, null, null, Model.Id, null, null, null, null, null, null, string.Empty);
    List<BaseSite.Models.DBModel.Sale_Sale> saleList = BaseSite.Models.Sale.SaleManager.Sale_Sale_Search(null, null, null, null, Model.Id, null, null, null, null);
}

<div id="orderhistory" style="padding:4px;">
    <div class="row">
        <div class="col-12" style="padding:5px 10px 0 0">
            <h3><b>@string.Format("لیست سفارشات {0}", Model.FullName)</b></h3>
        </div>
        <div class="col-12">
            <table class="table table-striped table-bordered table-hover">
                <thead>
                    <tr class="info">
                        <th scope="col">ردیف</th>
                        <th scope="col">شماره سند</th>
                        <th scope="col">سفارش گیرنده</th>
                        <th scope="col">تاریخ سفارش</th>
                        <th scope="col">تاریخ تحویل</th>
                        <th scope="col">نام پروژه</th>
                        <th scope="col">مبلغ کل فاکتور</th>
                        <th scope="col">وضعیت فاکتور</th>
                        <th scope="col">نوع سفارش</th>
                        <th scope="col">جزئیات</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < orderList.Count; i++)
                    {
                        <tr>
                            <th scope="row">@(i + 1)</th>
                            <td>@orderList[i].DocNumber</td>
                            <td>@orderList[i].Account_Users1.FullName</td>
                            <td>@orderList[i].ShDateOrder</td>
                            <td>@orderList[i].ShDateFactor</td>
                            <td>@orderList[i].ProjectName</td>
                            <td><span class="autoNumber">@orderList[i].Cost</span></td>
                            <td>@orderList[i].Order_Status.Name</td>
                            <td><span>@string.Format("{0} {1}", orderList[i].Tax > 0 ? "*" : " ", orderList[i].Tb_OrderTypes.Name)</span></td>
                            <td>
                                @if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Order_Detail))
                                {
                                    <a target="_blank" data-value="@orderList[i].Id" href="@Url.Action("OrderDetail", "order", new { OrderId = orderList[i].Id })"><i class="fa fa-list fa-lg" title="جزئیات"></i></a>
                                }
                                else
                                {
                                    <a data-value="@orderList[i].Id" href="#"><i class="fa fa-list fa-lg text-danger" title="جزئیات"></i></a>
                                }
                                @if (orderList[i].StatusId >= (byte)BaseSite.Models.OrderStatus.AmadeTahvil && orderList[i].StatusId <= (byte)BaseSite.Models.OrderStatus.TahvilShode)
                                {
                                    if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Delivery))
                                    {
                                        <div class="dropdown" style="float:left;">
                                            <button class="btn btn-link dropdown-toggle" style="padding:0;" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                                                <i class="fa fa-truck fa-lg" title="تحویل"></i>
                                                @*<span class="caret"></span>*@
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="dropdownMenu1">
                                                <li><a target="_blank" data-value="@orderList[i].Id" href="@Url.Action("DeliveryList", "Delivery", new { orderId = orderList[i].Id })">لیست تحویل ها</a></li>
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <a style="margin-right:5px;" data-value="@orderList[i].Id" href="#"><i class="fa fa-truck fa-lg text-danger" title="تحویل"></i></a>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="col-12" style="padding:15px 10px 0 0">
            <h3><b>@string.Format("لیست خرید کالا {0}", Model.FullName)</b></h3>
        </div>
        <div class="col-12">
            <table class="table table-striped table-bordered table-hover">
                <thead>
                    <tr class="info">
                        <th scope="col">ردیف</th>
                        <th scope="col">شماره سند</th>
                        <th scope="col">سفارش گیرنده</th>
                        <th scope="col">تاریخ سفارش</th>
                        <th scope="col">تاریخ تحویل</th>
                        <th scope="col">مرجوعی</th>
                        <th scope="col">مبلغ کل فاکتور</th>
                        <th scope="col">وضعیت فاکتور</th>
                        <th scope="col">نوع سفارش</th>
                        <th scope="col">جزئیات</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < saleList.Count; i++)
                    {
                        <tr>
                            <th scope="row">@(i + 1)</th>
                            <td>@saleList[i].DocNumber</td>
                            <td>@saleList[i].Account_Users1.FullName</td>
                            <td>@saleList[i].ShDateOrder</td>
                            <td>@saleList[i].ShDateFactor</td>
                            <td>@(saleList[i].GiveBack ? "*" : "")</td>
                            <td><span class="autoNumber">@saleList[i].Cost</span></td>
                            <td>@saleList[i].Order_Status.Name</td>
                            <td><span>@string.Format("{0} {1}", saleList[i].Tax > 0 ? "*" : " ", saleList[i].Tb_OrderTypes.Name)</span></td>
                            <td>
                                @if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Sale_Detail))
                                {
                                    <a target="_blank" data-value="@saleList[i].Id" href="@Url.Action("SaleDetail", "sale", new { saleId = saleList[i].Id })"><i class="fa fa-list fa-lg" title="جزئیات"></i></a>
                                }
                                else
                                {
                                    <a data-value="@saleList[i].Id" href="#"><i class="fa fa-list fa-lg text-danger" title="جزئیات"></i></a>
                                }
                                @if (saleList[i].StatusId >= (byte)BaseSite.Models.OrderStatus.AmadeTahvil && saleList[i].StatusId <= (byte)BaseSite.Models.OrderStatus.TahvilShode)
                                {
                                    if (BaseSite.Controllers.CustomAuthorizeAttribute.isAuthorize(BaseSite.Models.OPERATIONS.Delivery))
                                    {
                                        <div class="dropdown" style="float:left;">
                                            <button class="btn btn-link dropdown-toggle" style="padding:0;" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                                                <i class="fa fa-truck fa-lg" title="تحویل"></i>
                                                @*<span class="caret"></span>*@
                                            </button>
                                            <ul class="dropdown-menu" aria-labelledby="dropdownMenu1">
                                                <li><a target="_blank" data-value="@saleList[i].Id" href="@Url.Action("DeliveryList", "Delivery", new { saleId = saleList[i].Id })">لیست تحویل ها</a></li>
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <a style="margin-right:5px;" data-value="@saleList[i].Id" href="#"><i class="fa fa-truck fa-lg text-danger" title="تحویل"></i></a>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>