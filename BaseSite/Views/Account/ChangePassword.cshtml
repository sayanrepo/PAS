@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/LayoutMain.cshtml";
}

<div class="row">
    @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
{
    <div class="panel-group">

        @*#################################### TopPart ####################################*@
        <div class="panel panel-success">
            <div class="panel-heading MyHeader">
                <div class="row">
                    <div class="col-sm-offset-5 col-md-offset-5 col-sm-2 col-md-2 text-center">تغییر نام کاربری و رمزعبور</div>
                </div>
            </div>
            <div class="panel-body CabinPanelDiv">
                <div class="row">
                    <div class="col-md-offset-4 col-md-4 col-sm-offset-3 col-sm-6 col-xs-12">
                        <div class="input-group">
                            <span class="input-group-addon MySpan">نام کاربری جدید</span>
                            @Html.TextBox("newUserName", BaseSite.Controllers.CustomAuthorizeAttribute.getCurrentUser().UserName, new { @Class = "form-control MyControl text-center", @Id = "newUserName" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-offset-4 col-md-4 col-sm-offset-3 col-sm-6 col-xs-12">
                        <div class="input-group">
                            <span class="input-group-addon MySpan">رمز عبور فعلی</span>
                            @Html.Password("currentPassword", "", new { @Class = "form-control MyControl text-center", @Id = "currentPassword" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-offset-4 col-md-4 col-sm-offset-3 col-sm-6 col-xs-12">
                        <div class="input-group">
                            <span class="input-group-addon MySpan">رمز عبور جدید</span>
                            @Html.Password("newPassword", "", new { @Class = "form-control MyControl text-center", @Id = "newPassword" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    //################################## Submit Button ###################################
        <div class="row" style="text-align:center;margin-bottom:10px;">
            <button type="submit" class="btn btn-success" name="submit" value="submit">ثبت</button>
        </div>
        //###################################### end of body ###############################
    }
</div>
