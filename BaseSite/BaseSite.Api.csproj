<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BaseSite.Api</AssemblyName>
    <RootNamespace>BaseSite</RootNamespace>
    <RazorCompileOnBuild>true</RazorCompileOnBuild>
    <RazorCompileOnPublish>true</RazorCompileOnPublish>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.5.1" />
    <PackageReference Include="KavenegarDotNetCore" Version="1.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="App_Start\**\*.cs" />
    <Compile Remove="Controllers\**\*.cs" />
    <Compile Remove="Infrastructure\AuthenticationClaims.cs" />
    <Compile Remove="Infrastructure\MvcViewCompat.cs" />
    <Compile Remove="Infrastructure\WebGridCompat.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Compile Remove="Reports\ReportTemplate.aspx.cs" />
    <Compile Remove="Reports\ReportTemplate.aspx.designer.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="GuideBook\**\*" />
    <Content Remove="Reports\**\*" />
    <Content Remove="Views\**\*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
    <EmbeddedResource Include="Api\Queries\ReportColumns.json" />
  </ItemGroup>
</Project>
